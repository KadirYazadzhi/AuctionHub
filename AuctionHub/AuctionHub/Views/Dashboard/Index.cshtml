@model AuctionHub.Application.DTOs.UserDetailsDto
@using System.Text.Json
@{
    ViewData["Title"] = "My Dashboard";
    var activityLabels = Model.PersonalActivity.Select(d => d.Date.ToString("MMM dd")).ToList();
    var activityData = Model.PersonalActivity.Select(d => d.BidCount).ToList();
}

<div class="container py-5 animate-fade-up">
    <!-- Welcome Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5">
        <div class="mb-3 mb-md-0">
            <h1 class="fw-bold mb-1 text-main">Welcome back, @Model.DisplayName! 👋</h1>
            <p class="text-muted mb-0">Here's an overview of your activity and performance.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Auctions" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="bi bi-plus-lg me-2"></i> List New Item
            </a>
            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-white bg-card border shadow-sm rounded-pill px-4 fw-bold text-main">
                <i class="bi bi-person-gear me-2"></i> Profile Settings
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-5 h-100 bg-card border-start border-primary border-5 transition-all hover-lift">
                <div class="card-body p-4">
                    <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-2">Active Bids</small>
                    <h2 class="fw-bold mb-0 text-main">@Model.ActiveBidsCount</h2>
                    <small class="text-primary fw-medium">Items you're chasing</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-5 h-100 bg-card border-start border-success border-5 transition-all hover-lift">
                <div class="card-body p-4">
                    <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-2">Win Rate</small>
                    <h2 class="fw-bold mb-0 text-main">@Model.WinRate%</h2>
                    <small class="text-success fw-medium">Success performance</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-5 h-100 bg-card border-start border-info border-5 transition-all hover-lift">
                <div class="card-body p-4">
                    <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-2">Total Spent</small>
                    <h2 class="fw-bold mb-0 text-main">@Model.TotalSpent.ToString("C0")</h2>
                    <small class="text-info fw-medium">Investment in items</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-5 h-100 bg-card border-start border-warning border-5 transition-all hover-lift">
                <div class="card-body p-4">
                    <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-2">Net Earnings</small>
                    <h2 class="fw-bold mb-0 text-main">@Model.TotalEarned.ToString("C0")</h2>
                    <small class="text-warning fw-medium">From your sales</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Activity Chart -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-5 bg-card h-100 p-2 border border-light-subtle">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-main">Your Bidding Activity <small class="text-muted fw-normal fs-6 ms-2">(Last 7 days)</small></h5>
                    <div style="height: 300px;">
                        <canvas id="userActivityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Wallet Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-5 bg-primary bg-gradient text-white h-100 p-4 position-relative overflow-hidden">
                <!-- Decorative element - Reduced size and better positioning -->
                <div class="position-absolute bottom-0 end-0 m-n3 opacity-10" style="font-size: 7rem; line-height: 1; transform: rotate(-15deg);">
                    <i class="bi bi-wallet2"></i>
                </div>
                
                <div class="position-relative z-1 d-flex flex-column h-100">
                    <div class="mb-auto">
                        <h6 class="text-white-50 text-uppercase fw-bold letter-spacing-1 mb-2">Available Balance</h6>
                        <h1 class="display-4 fw-bold mb-0">@Model.WalletBalance.ToString("C")</h1>
                        <p class="text-white-50 small mt-2">Ready for your next bid</p>
                    </div>
                    
                    <div class="mt-4">
                        <div class="d-grid gap-2">
                            <a asp-controller="Wallet" asp-action="AddFunds" class="btn btn-white bg-white text-primary rounded-pill py-3 fw-bold shadow-sm hover-lift">
                                <i class="bi bi-plus-circle-fill me-2"></i>Top Up Wallet
                            </a>
                            <a asp-controller="Wallet" asp-action="History" class="btn btn-link text-white text-decoration-none small text-center opacity-75 hover-opacity-100">
                                <i class="bi bi-clock-history me-1"></i> View Transaction History
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Current Participation -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-5 bg-card h-100 overflow-hidden border border-light-subtle">
                <div class="card-header bg-transparent border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-main">Ongoing Participations</h5>
                    <a asp-controller="Auctions" asp-action="MyBids" class="text-primary small text-decoration-none fw-bold">View All <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body p-4">
                    @if (Model.Auctions.Any(a => a.IsActive))
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var auction in Model.Auctions.Where(a => a.IsActive).Take(5))
                            {
                                <div class="list-group-item px-0 border-0 d-flex align-items-center mb-3 bg-transparent">
                                    <div class="rounded-4 overflow-hidden me-3 shadow-sm" style="width: 64px; height: 64px;">
                                        <img src="@(string.IsNullOrEmpty(auction.ImageUrl) ? "https://via.placeholder.com/100" : auction.ImageUrl)" class="w-100 h-100 object-fit-cover" alt="@auction.Title">
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <h6 class="fw-bold text-main mb-1 text-truncate">@auction.Title</h6>
                                        <span class="badge bg-light-custom text-muted rounded-pill px-2 small">@auction.Category</span>
                                    </div>
                                    <div class="text-end ms-3">
                                        <div class="fw-bold text-primary">@auction.CurrentPrice.ToString("C")</div>
                                        <a asp-controller="Auctions" asp-action="Details" asp-route-id="@auction.Id" class="smallest text-muted text-decoration-none hover-primary">Details</a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <div class="mb-3 opacity-25">
                                <i class="bi bi-hammer display-1"></i>
                            </div>
                            <p class="fs-5">You are not participating in any active auctions.</p>
                            <a asp-controller="Auctions" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">Start Browsing</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Ending Soon (Personalized) -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-5 bg-card p-4 h-100 border border-light-subtle">
                <h5 class="fw-bold mb-4 text-main">Ending Soon <small class="text-muted fw-normal ms-1">(Handpicked for you)</small></h5>
                <div class="d-flex flex-column gap-3">
                    @foreach (var auction in (IEnumerable<AuctionHub.Application.DTOs.AuctionDto>)ViewBag.EndingSoon)
                    {
                        <div class="d-flex align-items-center p-3 transition-all hover-lift rounded-4 bg-light-custom border border-light-subtle shadow-sm">
                            <div class="rounded-3 overflow-hidden me-3 shadow-sm" style="width: 56px; height: 56px;">
                                <img src="@(string.IsNullOrEmpty(auction.ImageUrl) ? "https://via.placeholder.com/100" : auction.ImageUrl)" class="w-100 h-100 object-fit-cover" />
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="fw-bold text-main mb-0 text-truncate">@auction.Title</h6>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <span class="text-danger fw-bold smallest"><i class="bi bi-clock-fill me-1"></i>@((auction.EndTime - DateTime.UtcNow).Hours)h @((auction.EndTime - DateTime.UtcNow).Minutes)m</span>
                                    <span class="text-muted smallest">|</span>
                                    <span class="text-primary fw-bold smallest">@auction.CurrentPrice.ToString("C")</span>
                                </div>
                            </div>
                            <a asp-controller="Auctions" asp-action="Details" asp-route-id="@auction.Id" class="btn btn-primary btn-sm rounded-circle shadow-sm ms-2" style="width: 36px; height: 36px; padding: 0; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .letter-spacing-1 { letter-spacing: 1px; }
    .smallest { font-size: 0.75rem; }
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
    .hover-opacity-100:hover { opacity: 1 !important; }
    .transition-all { transition: all 0.3s ease; }
    .bg-light-custom { background-color: var(--bg-light) !important; }
    
    [data-bs-theme="dark"] .bg-card { background-color: var(--bg-card) !important; }
    [data-bs-theme="dark"] .text-main { color: var(--text-main) !important; }
    [data-bs-theme="dark"] .bg-light-custom { background-color: rgba(255,255,255,0.03) !important; }
    [data-bs-theme="dark"] .border-light-subtle { border-color: rgba(255,255,255,0.05) !important; }
    
    .btn-white { background-color: white; color: var(--primary-color); border: none; }
    .btn-white:hover { background-color: #f8f9fa; color: var(--primary-color); }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            const textColor = isDark ? '#94a3b8' : '#64748b';
            const gridColor = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

            const ctx = document.getElementById('userActivityChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(JsonSerializer.Serialize(activityLabels)),
                        datasets: [{
                            label: 'My Bids',
                            data: @Html.Raw(JsonSerializer.Serialize(activityData)),
                            borderColor: '#4361ee',
                            backgroundColor: 'rgba(67, 97, 238, 0.15)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 6,
                            pointHoverRadius: 8,
                            pointBackgroundColor: '#4361ee',
                            pointBorderColor: isDark ? '#1e293b' : '#ffffff',
                            pointBorderWidth: 2,
                            borderWidth: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { 
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: isDark ? '#1e293b' : '#ffffff',
                                titleColor: isDark ? '#ffffff' : '#1e293b',
                                bodyColor: isDark ? '#ffffff' : '#1e293b',
                                borderColor: isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)',
                                borderWidth: 1,
                                padding: 12,
                                displayColors: false
                            }
                        },
                        scales: {
                            y: { 
                                beginAtZero: true, 
                                grid: { color: gridColor }, 
                                ticks: { color: textColor, stepSize: 1, precision: 0 } 
                            },
                            x: { grid: { display: false }, ticks: { color: textColor } }
                        }
                    }
                });
            }
        });
    </script>
}
