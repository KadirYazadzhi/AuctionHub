@model AuctionHub.Application.DTOs.UserDetailsDto
@using System.Text.Json
@{
    ViewData["Title"] = "My Dashboard";
    var activityLabels = Model.PersonalActivity.Select(d => d.Date.ToString("MMM dd")).ToList();
    var activityData = Model.PersonalActivity.Select(d => d.BidCount).ToList();
}

<div class="container py-5 animate-fade-up">
    <!-- Welcome Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5">
        <div class="mb-3 mb-md-0">
            <h1 class="fw-bold mb-1 text-main">Welcome back, @Model.DisplayName! 👋</h1>
            <p class="text-muted mb-0">Here's an overview of your activity and performance.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Auctions" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="bi bi-plus-lg me-2"></i> List New Item
            </a>
            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-white bg-card border shadow-sm rounded-pill px-4 fw-bold text-main">
                <i class="bi bi-person-gear me-2"></i> Profile Settings
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-5 h-100 bg-card border-start border-primary border-5 transition-all hover-lift">
                <div class="card-body p-4">
                    <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-2">Active Bids</small>
                    <h2 class="fw-bold mb-0 text-main">@Model.ActiveBidsCount</h2>
                    <small class="text-primary fw-medium">Items you're chasing</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-5 h-100 bg-card border-start border-success border-5 transition-all hover-lift">
                <div class="card-body p-4">
                    <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-2">Win Rate</small>
                    <h2 class="fw-bold mb-0 text-main">@Model.WinRate%</h2>
                    <small class="text-success fw-medium">Success performance</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-5 h-100 bg-card border-start border-info border-5 transition-all hover-lift">
                <div class="card-body p-4">
                    <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-2">Total Spent</small>
                    <h2 class="fw-bold mb-0 text-main">@Model.TotalSpent.ToString("C0")</h2>
                    <small class="text-info fw-medium">Investment in items</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-5 h-100 bg-card border-start border-warning border-5 transition-all hover-lift">
                <div class="card-body p-4">
                    <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-2">Net Earnings</small>
                    <h2 class="fw-bold mb-0 text-main">@Model.TotalEarned.ToString("C0")</h2>
                    <small class="text-warning fw-medium">From your sales</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Activity Chart -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-5 bg-card h-100 p-2 border border-light-subtle overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold m-0 text-main">Your Bidding Activity <small class="text-muted fw-normal fs-6 ms-2">(Last 7 days)</small></h5>
                        <div class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                             <i class="bi bi-graph-up-arrow me-1"></i> Trends
                        </div>
                    </div>
                    <div style="height: 300px;">
                        <canvas id="userActivityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Wallet Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-5 h-100 position-relative overflow-hidden wallet-card-refined">
                <div class="card-body p-4 p-xl-5 d-flex flex-column align-items-center text-center">
                    <div class="mb-3">
                        <div class="icon-circle bg-primary bg-opacity-10 text-primary mb-3 mx-auto" style="width: 60px; height: 60px;">
                            <i class="bi bi-wallet2 fs-3"></i>
                        </div>
                        <h6 class="text-muted text-uppercase fw-bold smallest letter-spacing-2 mb-2">Total Balance</h6>
                        <h1 class="display-4 fw-bold mb-0 text-main balance-value">@Model.WalletBalance.ToString("C")</h1>
                    </div>
                    
                    <div class="mt-auto w-100">
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary rounded-pill py-3 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addFundsModal">
                                <i class="bi bi-plus-lg me-1"></i> Add Funds
                            </button>
                            <button type="button" class="btn btn-outline-primary border-2 rounded-pill py-2 fw-bolder smallest text-uppercase letter-spacing-1 btn-withdraw-custom" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                                <i class="bi bi-arrow-down me-1"></i> Withdraw
                            </button>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="Wallet" asp-action="Index" class="text-primary text-decoration-none smallest fw-bold hover-underline">
                                <i class="bi bi-clock-history me-1"></i> Full History
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Current Participation -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-5 bg-card h-100 overflow-hidden border border-light-subtle shadow-hover">
                <div class="card-header bg-transparent border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-main">Ongoing Bidding</h5>
                    <a asp-controller="Auctions" asp-action="MyBids" class="text-primary small text-decoration-none fw-bold hover-purple">View History <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body p-4">
                    @if (Model.Auctions.Any(a => a.IsActive))
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var auction in Model.Auctions.Where(a => a.IsActive).Take(5))
                            {
                                <div class="list-group-item px-0 border-0 d-flex align-items-center mb-3 bg-transparent p-3 rounded-4 transition-all hover-light-custom border border-transparent hover-border-light">
                                    <div class="rounded-4 overflow-hidden me-3 shadow-sm" style="width: 70px; height: 70px;">
                                        <img src="@(string.IsNullOrEmpty(auction.ImageUrl) ? "https://via.placeholder.com/100" : auction.ImageUrl)" class="w-100 h-100 object-fit-cover" alt="@auction.Title">
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <h6 class="fw-bold text-main mb-1 text-truncate">@auction.Title</h6>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-muted border rounded-pill px-2 py-1 smallest">@auction.Category</span>
                                            @if (auction.IsWinning == true)
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill smallest"><i class="bi bi-trophy-fill"></i> Winning</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="text-end ms-3">
                                        <div class="fw-bold text-primary fs-5">@auction.CurrentPrice.ToString("C")</div>
                                        <a asp-controller="Auctions" asp-action="Details" asp-route-id="@auction.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 mt-1 btn-hover-purple">Details</a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <div class="mb-3 opacity-25">
                                <i class="bi bi-hammer display-1"></i>
                            </div>
                            <p class="fs-5">You are not participating in any active auctions.</p>
                            <a asp-controller="Auctions" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 btn-hover-purple">Start Browsing</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Ending Soon (Personalized) -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-5 bg-card p-4 h-100 border border-light-subtle">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold m-0 text-main">Ending Soon</h5>
                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2 animate-pulse-slow">
                        <i class="bi bi-lightning-fill me-1"></i> Hot Items
                    </span>
                </div>
                <div class="d-flex flex-column gap-3">
                    @foreach (var auction in (IEnumerable<AuctionHub.Application.DTOs.AuctionDto>)ViewBag.EndingSoon)
                    {
                        var timeRemaining = auction.EndTime - DateTime.UtcNow;
                        var isUrgent = timeRemaining.TotalHours < 2;

                        <div class="d-flex align-items-center p-3 transition-all hover-item rounded-4 bg-light-custom border border-light-subtle shadow-sm position-relative overflow-hidden">
                            @if (auction.IsPromoted)
                            {
                                <div class="position-absolute top-0 start-0 h-100 bg-warning" style="width: 4px;"></div>
                            }
                            
                            <div class="rounded-3 overflow-hidden me-3 shadow-sm border border-light" style="width: 64px; height: 64px;">
                                <img src="@(string.IsNullOrEmpty(auction.ImageUrl) ? "https://via.placeholder.com/100" : auction.ImageUrl)" class="w-100 h-100 object-fit-cover" />
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="fw-bold text-main mb-1 text-truncate">@auction.Title</h6>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="@(isUrgent ? "text-danger" : "text-muted") smallest fw-bold d-flex align-items-center">
                                        <i class="bi bi-clock-fill me-1"></i>
                                        @if (timeRemaining.TotalHours >= 1)
                                        {
                                            <text>@( (int)timeRemaining.TotalHours )h @(timeRemaining.Minutes)m</text>
                                        }
                                        else if (timeRemaining.TotalMinutes >= 1)
                                        {
                                            <text>@( (int)timeRemaining.TotalMinutes )m @(timeRemaining.Seconds)s</text>
                                        }
                                        else
                                        {
                                            <text>Closing Now</text>
                                        }
                                    </div>
                                    <span class="text-primary fw-bold">@auction.CurrentPrice.ToString("C")</span>
                                </div>
                            </div>
                            <a asp-controller="Auctions" asp-action="Details" asp-route-id="@auction.Id" class="btn btn-white shadow-sm rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border: 1px solid var(--border-color);">
                                <i class="bi bi-chevron-right text-primary"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Funds Modal -->
<div class="modal fade" id="addFundsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-5">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Add Funds</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-controller="Wallet" asp-action="AddFunds" method="post">
                    <label class="form-label small fw-bold text-muted text-uppercase">Amount to Deposit</label>
                    <div class="input-group input-group-lg mb-4">
                        <span class="input-group-text bg-light-custom border-0 ps-4 text-main">€</span>
                        <input type="number" name="amount" class="form-control bg-light-custom border-0" placeholder="0.00" step="0.01" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-sm">Confirm Deposit</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Withdraw Modal -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-5">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Withdraw Funds</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-controller="Wallet" asp-action="Withdraw" method="post">
                    <label class="form-label small fw-bold text-muted text-uppercase">Amount to Withdraw</label>
                    <div class="input-group input-group-lg mb-4">
                        <span class="input-group-text bg-light-custom border-0 ps-4 text-main">€</span>
                        <input type="number" name="amount" class="form-control bg-light-custom border-0" placeholder="0.00" step="0.01" max="@Model.WalletBalance" required>
                    </div>
                    <p class="text-muted small mb-4">Available for withdrawal: <span class="fw-bold text-main">@Model.WalletBalance.ToString("C")</span></p>
                    <button type="submit" class="btn btn-outline-primary border-2 w-100 rounded-pill py-3 fw-bold shadow-sm btn-withdraw-custom">Process Withdrawal</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .letter-spacing-1 { letter-spacing: 1px; }
    .letter-spacing-2 { letter-spacing: 2px; }
    .smallest { font-size: 0.75rem; }
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
    .hover-opacity-100:hover { opacity: 1 !important; }
    .hover-underline:hover { text-decoration: underline !important; }
    .transition-all { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    
    .shadow-hover { transition: all 0.3s ease; }
    .shadow-hover:hover { box-shadow: 0 12px 24px -8px rgba(0,0,0,0.05) !important; }

    /* Theme Consistency */
    .btn-hover-purple:hover, .btn-withdraw-custom:hover {
        background-color: var(--primary-hover) !important;
        border-color: var(--primary-hover) !important;
        color: white !important;
    }
    
    .hover-purple:hover {
        color: var(--primary-hover) !important;
    }

    .hover-item { transition: all 0.2s ease; }
    .hover-item:hover { 
        background-color: white !important; 
        transform: translateX(5px); 
        border-color: var(--primary-color) !important;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05) !important;
    }

    /* Minimal Wallet Card */
    .wallet-card-refined {
        background-color: white !important;
        border: 1px solid rgba(0,0,0,0.05) !important;
    }
    
    [data-bs-theme="dark"] .wallet-card-refined {
        background-color: var(--bg-card) !important;
        border-color: rgba(255,255,255,0.05) !important;
    }

    @@keyframes pulse-slow {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }
    .animate-pulse-slow { animation: pulse-slow 3s infinite; }
    
    .bg-light-custom { background-color: #f8faff !important; }
    [data-bs-theme="dark"] .text-main { color: var(--text-main) !important; }
    [data-bs-theme="dark"] .bg-light-custom { background-color: rgba(255,255,255,0.03) !important; }
    [data-bs-theme="dark"] .border-light-subtle { border-color: rgba(255,255,255,0.05) !important; }
    
    .btn-white { background-color: white; color: var(--primary-color); border: none; }
    .btn-white:hover { background-color: #f8f9fa; color: var(--primary-color); }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            const textColor = isDark ? '#94a3b8' : '#64748b';
            const gridColor = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

            const ctx = document.getElementById('userActivityChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(JsonSerializer.Serialize(activityLabels)),
                        datasets: [{
                            label: 'My Bids',
                            data: @Html.Raw(JsonSerializer.Serialize(activityData)),
                            borderColor: '#4361ee',
                            backgroundColor: 'rgba(67, 97, 238, 0.15)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 6,
                            pointHoverRadius: 8,
                            pointBackgroundColor: '#4361ee',
                            pointBorderColor: isDark ? '#1e293b' : '#ffffff',
                            pointBorderWidth: 2,
                            borderWidth: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { 
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: isDark ? '#1e293b' : '#ffffff',
                                titleColor: isDark ? '#ffffff' : '#1e293b',
                                bodyColor: isDark ? '#ffffff' : '#1e293b',
                                borderColor: isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)',
                                borderWidth: 1,
                                padding: 12,
                                displayColors: false
                            }
                        },
                        scales: {
                            y: { 
                                beginAtZero: true, 
                                grid: { color: gridColor }, 
                                ticks: { color: textColor, stepSize: 1, precision: 0 } 
                            },
                            x: { grid: { display: false }, ticks: { color: textColor } }
                        }
                    }
                });
            }
        });
    </script>
}
