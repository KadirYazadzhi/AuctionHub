@model AuctionHub.Models.ViewModels.AuctionDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
    var successMessage = TempData["Success"]?.ToString();
    var errorMessage = TempData["Error"]?.ToString();
}

<div class="container py-5">
    <!-- Feedback Messages -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-pill shadow-sm mb-4 border-0 px-4 py-3 animate-fade-up" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-3 fs-4"></i>
                <div>@successMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-pill shadow-sm mb-4 border-0 px-4 py-3 animate-fade-up" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
                <div>@errorMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-5">
        <!-- Media Column -->
        <div class="col-lg-7 animate-fade-up">
            <div class="sticky-top" style="top: 100px;">
                <div class="card border-0 shadow-lg rounded-5 overflow-hidden mb-4">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/800x600?text=No+Image" : Model.ImageUrl)"
                         class="img-fluid w-100 object-fit-cover"
                         id="mainDisplayImage"
                         style="max-height: 600px; min-height: 400px; cursor: zoom-in;"
                         alt="@Model.Title"
                         onclick="openFullImage(this.src)">
                </div>

                @if (Model.Images != null && Model.Images.Count > 1)
                {
                    <div class="d-flex gap-2 overflow-auto mb-4 pb-2 custom-scrollbar">
                        @foreach (var imgUrl in Model.Images)
                        {
                            <div class="thumb-item flex-shrink-0" onclick="swapMainImage('@imgUrl', this)">
                                <img src="@imgUrl" class="rounded-4 border shadow-sm @(imgUrl == Model.ImageUrl ? "border-primary border-2" : "border-light")" 
                                     style="width: 80px; height: 80px; object-fit: cover; cursor: pointer; transition: all 0.2s;" />
                            </div>
                        }
                    </div>
                }
                
                <div class="card border-0 shadow-sm rounded-5 bg-white p-4 p-lg-5 mb-4">
                    <h4 class="fw-bold mb-4 d-flex align-items-center">
                        <i class="bi bi-info-circle text-primary me-2"></i> Item Description
                    </h4>
                    <p class="lead text-muted mb-0" style="white-space: pre-wrap; line-height: 1.8;">@Model.Description</p>
                </div>

                <!-- Community Feed / Comments -->
                <div class="card border-0 shadow-sm rounded-5 bg-white p-4 p-lg-5 animate-fade-up">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold mb-0">
                            <i class="bi bi-chat-dots-fill text-primary me-2"></i> Community Feed
                        </h4>
                        <span class="badge bg-light text-muted rounded-pill border">@Model.Comments.Count() Comments</span>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-action="AddComment" method="post" class="mb-5">
                            <input type="hidden" name="auctionId" value="@Model.Id" />
                            <div class="form-group mb-3">
                                <textarea name="content" class="form-control rounded-4 border-light bg-light p-3" rows="3" placeholder="Ask a question or share your thoughts..." required maxlength="1000"></textarea>
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">Post Comment</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-light alert-permanent border rounded-4 p-4 text-center mb-5">
                            <p class="mb-0 text-muted small">Please <a asp-area="Identity" asp-page="/Account/Login" class="fw-bold text-primary">log in</a> to participate in the discussion.</p>
                        </div>
                    }

                    <div class="comments-list">
                        @if (!Model.Comments.Any())
                        {
                            <div class="text-center py-4 opacity-50">
                                <i class="bi bi-chat-left display-4 d-block mb-2"></i>
                                <p class="small mb-0">No comments yet. Be the first to start the conversation!</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var comment in Model.Comments)
                            {
                                <div class="d-flex mb-4 animate-fade-in">
                                    <div class="flex-shrink-0">
                                        <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center overflow-hidden" style="width: 40px; height: 40px;">
                                            @if (!string.IsNullOrEmpty(comment.UserProfilePictureUrl))
                                            {
                                                <img src="@comment.UserProfilePictureUrl" class="w-100 h-100 object-fit-cover" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-fill fs-5"></i>
                                            }
                                        </div>
                                    </div>
                                    <div class="ms-3 flex-grow-1">
                                        <div class="bg-light rounded-4 p-3 shadow-sm-hover transition-all" style="border-top-left-radius: 0;">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold text-dark small">@comment.UserDisplayName</span>
                                                <div class="d-flex align-items-center gap-2">
                                                    <small class="text-muted smallest">@comment.CreatedOn.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                                                    @{
                                                        var loopUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                                    }
                                                    @if (comment.UserId == loopUserId || User.IsInRole("Administrator"))
                                                    {
                                                        <form asp-action="DeleteComment" method="post" class="lh-1">
                                                            <input type="hidden" name="commentId" value="@comment.Id" />
                                                            <input type="hidden" name="auctionId" value="@Model.Id" />
                                                            <button type="submit" class="btn btn-link p-0 text-danger border-0 shadow-none" 
                                                                    style="font-size: 0.75rem;" onclick="return confirm('Delete this comment?');" title="Delete Comment">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                            <p class="small mb-0 text-secondary" style="line-height: 1.5;">@comment.Content</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Details & Bidding Column -->
        <div class="col-lg-5 animate-fade-up delay-100">
            <div class="card border-0 shadow-sm rounded-5 bg-white h-100 overflow-hidden">
                <div class="card-body p-4 p-lg-5">
                    <!-- Category & Watchlist -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                            <i class="bi bi-tag-fill me-1"></i> @Model.Category
                        </span>
                        
                        @if(User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-action="ToggleWatchlist" asp-route-id="@Model.PublicId" method="post">
                                <button type="submit" class="btn btn-sm @(Model.IsWatched ? "btn-warning" : "btn-outline-secondary") rounded-pill px-3 py-2">
                                    <i class="bi @(Model.IsWatched ? "bi-star-fill" : "bi-star") me-1"></i> 
                                    @(Model.IsWatched ? "Watching" : "Watch")
                                </button>
                            </form>
                        }
                    </div>

                    <h1 class="display-5 fw-bold mb-3">@Model.Title</h1>
                    
                    <div class="d-flex align-items-center mb-5 p-3 bg-light rounded-4">
                        <div class="avatar-sm bg-white text-primary shadow-sm me-3">
                            <i class="bi bi-person-fill fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Listed by</small>
                            <a asp-action="UserAuctions" asp-route-username="@Model.Seller" class="text-decoration-none fw-bold text-dark hover-primary">
                                @Model.Seller
                            </a>
                            <div class="small text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.SellerRating))
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }
                                <span class="text-muted ms-1">(@Model.SellerReviewCount)</span>
                            </div>
                        </div>
                        
                        @if (User.Identity?.IsAuthenticated == true && Model.SellerId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <div class="ms-auto d-flex gap-2 align-items-center">
                                <form asp-action="@(ViewBag.IsFollowing ? "Unfollow" : "Follow")" method="post">
                                    <input type="hidden" name="sellerId" value="@Model.SellerId" />
                                    <input type="hidden" name="publicId" value="@Model.PublicId" />
                                    <button type="submit" class="btn @(ViewBag.IsFollowing ? "btn-success" : "btn-outline-primary") action-btn-circle shadow-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="@(ViewBag.IsFollowing ? "Following" : "Follow")">
                                        <i class="bi @(ViewBag.IsFollowing ? "bi-person-check-fill" : "bi-person-plus")"></i>
                                    </button>
                                </form>
                                
                                <button type="button" class="btn btn-outline-danger action-btn-circle shadow-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Report" onclick="setTimeout(() => { document.querySelector('[data-bs-target=\'#reportModal\']').click(); }, 100);" data-report-modal="#reportModal">
                                    <i class="bi bi-flag"></i>
                                </button>
                                
                                <a asp-controller="Chat" asp-action="Index" asp-route-auctionId="@Model.Id" asp-route-targetUserId="@Model.SellerId" class="btn btn-primary action-btn-circle shadow-sm hover-lift" data-bs-toggle="tooltip" data-bs-placement="top" title="Message">
                                    <i class="bi bi-chat-fill"></i>
                                </a>
                            </div>
                        }

                        @if (User.Identity?.IsAuthenticated == true && Model.SellerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <div class="ms-auto d-flex gap-2 action-buttons-container">
                                <a asp-action="Edit" asp-route-id="@Model.PublicId" class="btn btn-outline-warning action-btn-circle shadow-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                @if (!Model.Bids.Any() && Model.IsActive)
                                {
                                    <form asp-action="Cancel" asp-route-id="@Model.PublicId" method="post" onsubmit="return confirm('Are you sure you want to cancel this auction?');" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger action-btn-circle shadow-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Cancel">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@Model.PublicId" method="post" onsubmit="return confirm('Are you sure?');" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger action-btn-circle shadow-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }

                        <style>
                            /* All action buttons are always circular with icons only */
                            .action-btn-circle {
                                width: 42px;
                                height: 42px;
                                min-width: 42px;
                                border-radius: 50%;
                                display: inline-flex;
                                align-items: center;
                                justify-content: center;
                                padding: 0;
                                transition: all 0.2s ease;
                            }
                            
                            .action-btn-circle i {
                                margin: 0;
                                font-size: 1.1rem;
                            }
                            
                            .action-btn-circle:hover {
                                transform: translateY(-2px);
                            }
                        </style>
                        
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                // Initialize all tooltips
                                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                                var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                                    return new bootstrap.Tooltip(tooltipTriggerEl);
                                });
                                
                                // Handle Report button - show modal when clicked
                                var reportBtn = document.querySelector('[data-report-modal]');
                                if (reportBtn) {
                                    reportBtn.addEventListener('click', function(e) {
                                        // Hide tooltip before showing modal
                                        var tooltip = bootstrap.Tooltip.getInstance(this);
                                        if (tooltip) {
                                            tooltip.hide();
                                        }
                                        // Show modal
                                        var modalId = this.getAttribute('data-report-modal');
                                        var modal = new bootstrap.Modal(document.querySelector(modalId));
                                        modal.show();
                                    });
                                }
                            });
                        </script>
                    </div>

                    <!-- Location Data -->
                    <div class="card border-0 bg-light rounded-5 mb-4 shadow-sm border-start border-4 border-primary">
                        <div class="card-body p-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Location</h6>
                                <p class="text-muted small mb-0">
                                    @{
                                        var parts = new List<string>();
                                        if (!string.IsNullOrEmpty(Model.City)) parts.Add(Model.City);
                                        if (!string.IsNullOrEmpty(Model.District)) parts.Add(Model.District);
                                        var locationStr = string.Join(", ", parts);
                                        if (!string.IsNullOrEmpty(Model.Country))
                                        {
                                            locationStr += (string.IsNullOrEmpty(locationStr) ? "" : " ") + $"({Model.Country})";
                                        }
                                    }
                                    @(string.IsNullOrEmpty(locationStr) ? "Location N/A" : locationStr)
                                </p>
                            </div>
                            @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                            {
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#mapCollapse">
                                    <i class="bi bi-map me-1"></i> Show on Map
                                </button>
                            }
                        </div>
                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                        {
                            <div class="collapse" id="mapCollapse">
                                <div id="detailsMap" class="rounded-bottom-5" style="height: 250px;"></div>
                            </div>
                        }
                    </div>

                    <!-- Pricing Display -->
                    <div class="p-4 rounded-5 mb-4 text-center" style="background: linear-gradient(135deg, rgba(67, 97, 238, 0.05) 0%, rgba(67, 97, 238, 0.1) 100%); border: 1px solid rgba(67, 97, 238, 0.1);">
                        @if (Model.IsSuspended)
                        {
                            <div class="badge bg-danger rounded-pill px-4 py-2 mb-3 shadow-sm">
                                <i class="bi bi-slash-circle-fill me-2"></i> SUSPENDED BY ADMIN
                            </div>
                        }
                        
                        <span class="text-muted small text-uppercase letter-spacing-1 fw-bold mb-2 d-block">Current High Bid</span>
                        <div class="display-3 fw-bolder text-primary mb-1" id="current-high-price">@Model.CurrentPrice.ToString("C")</div>
                        
                        @if (Model.ReservePrice.HasValue && !Model.ReservePriceMet)
                        {
                            <div class="badge bg-warning text-dark rounded-pill px-3 py-1 mb-2 shadow-sm" id="reserve-badge">
                                <i class="bi bi-info-circle me-1"></i> Reserve price not met
                            </div>
                        }

                        <div class="d-flex justify-content-center gap-3 mt-3">
                            <span class="badge @(Model.IsActive ? "bg-success" : (Model.IsSuspended ? "bg-danger" : "bg-secondary")) rounded-pill px-3 py-2">
                                @(Model.IsActive ? "Active" : (Model.IsSuspended ? "Suspended" : "Closed"))
                            </span>
                            @if(Model.IsActive)
                            {
                                <span class="text-danger fw-bold small d-flex align-items-center">
                                    <i class="bi bi-clock-fill me-1"></i> 
                                    <span id="countdown-timer" data-endtime="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                                        @Model.EndTime.ToString("g")
                                    </span>
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Buy It Now -->
                    @if (User.Identity?.IsAuthenticated == true && Model.IsActive && Model.BuyItNowPrice.HasValue && Model.SellerId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value && Model.CurrentPrice < Model.BuyItNowPrice)
                    {
                        bool isAdmin = User.IsInRole("Administrator");
                        <div class="card border-0 bg-success bg-opacity-10 buy-it-now-card rounded-5 mb-4 @(isAdmin ? "opacity-50" : "")" style="@(isAdmin ? "cursor: not-allowed;" : "")">
                            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold text-success mb-1">Buy It Now</h6>
                                    <div class="h4 fw-bold text-success-emphasis mb-0">@Model.BuyItNowPrice.Value.ToString("C")</div>
                                </div>
                                <form asp-action="BuyItNow" method="post" onsubmit="return confirm('Buy Now?');">
                                    <input type="hidden" name="auctionId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" @(isAdmin ? "disabled" : "")>
                                        @(isAdmin ? "Admin Restricted" : "Purchase")
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    <!-- Make Offer -->
                    @if (User.Identity?.IsAuthenticated == true && Model.IsActive && !Model.IsDutchAuction && Model.SellerId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value && !User.IsInRole("Administrator"))
                    {
                        <div class="card border-0 bg-secondary bg-opacity-10 rounded-5 mb-4 shadow-sm border-start border-4 border-secondary">
                            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1"><i class="bi bi-chat-text-fill text-secondary me-2"></i> Private Offer</h6>
                                    <p class="small text-muted mb-0">Negotiate directly with the seller.</p>
                                </div>
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#offerModal">
                                    Make Offer
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Bid Section -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (Model.IsActive)
                        {
                            var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            bool isAdmin = User.IsInRole("Administrator");

                            if (Model.SellerId == currentUserId)
                            {
                                <div class="alert alert-primary alert-permanent bg-primary-subtle border-0 rounded-4 p-4 text-center">
                                    <i class="bi bi-info-circle-fill display-6 mb-2 d-block"></i>
                                    <p class="mb-0 fw-semibold">You are the seller of this item.</p>
                                </div>
                            }
                            else if (isAdmin)
                            {
                                <div class="alert alert-warning alert-permanent bg-warning-subtle border-0 rounded-4 p-4 text-center shadow-sm">
                                    <i class="bi bi-shield-lock-fill display-6 mb-2 d-block text-warning"></i>
                                    <p class="mb-0 fw-bold">Administrative Access</p>
                                    <small class="text-muted">Bidding is disabled for administrators to ensure marketplace fairness.</small>
                                </div>
                            }
                            else if (Model.ParticipationFee.HasValue && Model.ParticipationFee.Value > 0 && !Model.HasPaidParticipationFee)
                            {
                                <div class="card border-primary border-opacity-25 rounded-5 mb-4 shadow-sm overflow-hidden bg-primary bg-opacity-10">
                                    <div class="card-body p-4 text-center">
                                        <i class="bi bi-ticket-perforated-fill display-4 text-primary mb-3 d-block"></i>
                                        <h5 class="fw-bold mb-2">Exclusive Auction</h5>
                                        <p class="text-muted small mb-4">To ensure serious bidding, the seller requires a participation ticket for this auction.</p>
                                        <div class="fw-bold fs-4 text-dark mb-3">Ticket Price: @Model.ParticipationFee.Value.ToString("C")</div>
                                        <form asp-action="PayParticipationFee" method="post" onsubmit="return confirm('Buy a participation ticket for @Model.ParticipationFee.Value.ToString("C")? This amount will be transferred to the seller and is non-refundable.');">
                                            <input type="hidden" name="auctionId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm hover-lift">
                                                Buy Ticket & Unlock Bidding
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                            else if (Model.IsDutchAuction)
                            {
                                <div class="card border-warning border-opacity-50 rounded-5 mb-4 shadow-sm overflow-hidden bg-warning bg-opacity-10">
                                    <div class="card-body p-4 text-center">
                                        <div class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill"><i class="bi bi-clock-history me-1"></i> Dutch Auction</div>
                                        <h5 class="fw-bold mb-2">Price is dropping!</h5>
                                        <p class="text-muted small mb-4">
                                            The price drops by <strong>@Model.DutchDecrementAmount?.ToString("C")</strong> every <strong>@Model.DutchDecrementIntervalMinutes minutes</strong>.
                                            The first person to buy it, wins it instantly.
                                        </p>
                                        <form asp-action="PlaceBid" method="post" onsubmit="return confirm('Are you sure you want to buy this item now at the current price?');">
                                            <input type="hidden" name="AuctionId" value="@Model.Id" />
                                            <input type="hidden" name="Amount" value="@Model.CurrentPrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                                            <button type="submit" class="btn btn-warning btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm hover-lift text-dark">
                                                Buy Now at Current Price
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="card border-primary border-opacity-25 rounded-5 mb-4 shadow-sm overflow-hidden">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3 text-center">Ready to win?</h5>
                                        <form asp-action="PlaceBid" method="post">
                                            <input type="hidden" name="AuctionId" value="@Model.Id" />
                                            
                                            <div class="d-flex justify-content-center gap-2 mb-3">
                                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addBid(1)">+1€</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addBid(5)">+5€</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addBid(10)">+10€</button>
                                            </div>

                                            <div class="input-group input-group-lg mb-3">
                                                <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-4 fw-bold text-primary">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                                                <input type="text" 
                                                       class="form-control border-start-0 rounded-end-pill py-3" 
                                                       name="Amount" 
                                                       value="@Model.NewBidAmount.ToString("N2")" 
                                                       oninput="this.value = this.value.replace(/[^0-9,.]/g, '').replace('.', ',')"
                                                       inputmode="decimal">
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm hover-lift">
                                                Place Your Bid
                                            </button>
                                        </form>
                                        <div class="text-center mt-3 text-muted small">
                                            Minimum increment: <span class="fw-bold">@Model.MinIncrease.ToString("C")</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Smart Bidding Section -->
                                <div class="card border-0 bg-info bg-opacity-10 rounded-5 mb-4 shadow-sm overflow-hidden border-start border-4 border-info">
                                    <div class="card-body p-4">
                                        <div class="d-flex align-items-center mb-3">
                                            <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 32px; height: 32px;">
                                                <i class="bi bi-robot text-info"></i>
                                            </div>
                                            <h5 class="fw-bold mb-0 text-info-emphasis">Smart Bidding</h5>
                                        </div>
                                        
                                        @if (Model.CurrentAutoBidLimit.HasValue)
                                        {
                                            <div class="alert alert-permanent bg-white border-info border-opacity-25 rounded-4 p-3 mb-3 d-flex align-items-center justify-content-between shadow-sm">
                                                <div>
                                                    <small class="text-muted d-block">Your active limit:</small>
                                                    <span class="h5 fw-bold text-info mb-0">@Model.CurrentAutoBidLimit.Value.ToString("C")</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="badge bg-info text-white rounded-pill px-3 py-2">
                                                        <i class="bi bi-check-lg me-1"></i> Active
                                                    </div>
                                                    <form asp-action="DeactivateAutoBid" asp-route-id="@Model.PublicId" method="post" style="display:inline;">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle border-0 p-0" title="Deactivate Auto-Bid" style="width: 24px; height: 24px;">
                                                            <i class="bi bi-x-circle-fill"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                            <p class="small text-muted mb-3">You can update your limit by entering a new amount below.</p>
                                        }
                                        else
                                        {
                                            <p class="small text-muted mb-3">Set your absolute maximum and let our bot outbid others automatically with the minimum step.</p>
                                        }

                                        <form asp-action="SetAutoBid" method="post" class="d-flex gap-2">
                                            <input type="hidden" name="auctionId" value="@Model.Id" />
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3 fw-bold text-info">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                                                <input type="text" 
                                                       class="form-control border-start-0 py-2" 
                                                       name="maxAmount" 
                                                       placeholder="Max Limit"
                                                       oninput="this.value = this.value.replace(/[^0-9,.]/g, '').replace('.', ',')"
                                                       inputmode="decimal">
                                                <button type="submit" class="btn btn-info text-white rounded-end-pill px-4 fw-bold">Activate</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-secondary alert-permanent border-0 rounded-4 p-4 text-center">
                                <i class="bi bi-lock-fill fs-3 mb-2 d-block"></i>
                                <p class="mb-0 fw-bold">This auction has concluded.</p>
                                
                                @{
                                    var currentUserIdForChat = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                    bool canAccessChat = Model.SellerId == currentUserIdForChat || Model.IsWinning == true;
                                }
                                @if (canAccessChat)
                                {
                                    <div class="mt-4 d-flex flex-column gap-2">
                                        @if (Model.IsWinning == true && !Model.IsDelivered && !Model.IsDisputed)
                                        {
                                            <div class="d-flex gap-2">
                                                <form asp-action="ConfirmDelivery" method="post" class="flex-grow-1" onsubmit="return showConfirm('Confirm you received the item? This will <strong>release funds</strong> to the seller.', this);">
                                                    <input type="hidden" name="auctionId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-success rounded-pill px-4 py-2 shadow-sm fw-bold w-100">
                                                        <i class="bi bi-box-seam-fill me-2"></i> Confirm Delivery
                                                    </button>
                                                </form>
                                                <form asp-action="Dispute" method="post" onsubmit="return confirm('Are you sure you want to open a dispute? This will freeze the funds until an administrator reviews the case.');">
                                                    <input type="hidden" name="id" value="@Model.PublicId" />
                                                    <button type="submit" class="btn btn-outline-danger rounded-pill px-3 py-2 shadow-sm fw-bold">
                                                        <i class="bi bi-shield-exclamation"></i> Dispute
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else if (Model.IsDisputed)
                                        {
                                            <div class="badge bg-danger rounded-pill p-3 mb-2 w-100">
                                                <i class="bi bi-shield-fill-exclamation me-2"></i> Under Dispute
                                            </div>
                                            <p class="small text-muted text-center">Our team is reviewing this transaction.</p>
                                        }
                                        else if (Model.IsDelivered)
                                        {
                                            <div class="badge bg-success-subtle text-success rounded-pill p-3 mb-2 w-100">
                                                <i class="bi bi-check-all me-2"></i> Transaction Completed & Delivered
                                            </div>
                                        }
                                        
                                        <a asp-controller="Chat" asp-action="Index" asp-route-auctionId="@Model.Id" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-bold hover-lift">
                                            <i class="bi bi-chat-lock-fill me-2"></i> Open Secure Chat
                                        </a>
                                        <p class="small text-muted mt-2 mb-0">Discuss shipping & payment details securely.</p>
                                    </div>
                                }

                                @if (ViewBag.CanLeaveReview == true)
                                {
                                    <div class="mt-5 border-top pt-4 text-start">
                                        @{
                                            var currentUserIdReview = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                            var reviewTargetRole = Model.SellerId == currentUserIdReview ? "Buyer" : "Seller";
                                        }
                                        <h5 class="fw-bold mb-3"><i class="bi bi-star-fill text-warning me-2"></i>Rate the @reviewTargetRole</h5>
                                        <form asp-action="LeaveReview" method="post" class="bg-light p-4 rounded-4 shadow-sm">
                                            <input type="hidden" name="auctionId" value="@Model.Id" />
                                            
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-muted">Your Rating</label>
                                                <div class="star-rating d-flex gap-2 fs-3">
                                                    @for (int i = 5; i >= 1; i--)
                                                    {
                                                        <input type="radio" id="star@i" name="rating" value="@i" required />
                                                        <label for="star@i" title="@i stars"><i class="bi bi-star-fill"></i></label>
                                                    }
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-muted">Your Experience</label>
                                                <textarea name="comment" class="form-control rounded-3 border-0 shadow-sm" rows="3" placeholder="Share how the transaction went..." required></textarea>
                                            </div>

                                            <button type="submit" class="btn btn-warning w-100 rounded-pill fw-bold py-2 shadow-sm hover-lift">
                                                Submit Review
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="card border-0 bg-primary bg-opacity-10 rounded-5 p-4 text-center">
                            <h5 class="fw-bold mb-3 text-primary">Join the Bidding</h5>
                            <p class="text-muted small mb-4">You must be logged in to participate in this auction.</p>
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary rounded-pill w-100 py-3 fw-bold shadow-sm">Log In to Bid</a>
                        </div>
                    }

                    <!-- Seller Private Offers -->
                    @if (User.Identity?.IsAuthenticated == true && Model.SellerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value && Model.PrivateOffers.Any())
                    {
                        <div class="mt-5">
                            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-envelope-paper-heart-fill text-danger me-2"></i> Private Offers</h5>
                            <div class="list-group list-group-flush border rounded-4 overflow-hidden">
                                @foreach (var offer in Model.PrivateOffers.Where(o => o.Status == "Pending" || o.Status == "Accepted"))
                                {
                                    <div class="list-group-item p-3 d-flex align-items-center justify-content-between @(offer.Status == "Accepted" ? "bg-success bg-opacity-10" : "")">
                                        <div>
                                            <strong class="text-dark">@offer.BuyerName</strong> offered
                                            <div class="fw-bold text-primary fs-5">@offer.Amount.ToString("C")</div>
                                            <small class="text-muted">@offer.CreatedOn.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                                        </div>
                                        @if (offer.Status == "Pending" && Model.IsActive)
                                        {
                                            <div class="d-flex gap-2">
                                                <form asp-action="AcceptPrivateOffer" method="post" onsubmit="return confirm('Accept this offer? The auction will end immediately.');">
                                                    <input type="hidden" name="offerId" value="@offer.Id" />
                                                    <input type="hidden" name="auctionId" value="@Model.Id" />
                                                    <button class="btn btn-sm btn-success rounded-pill px-3 shadow-sm fw-bold"><i class="bi bi-check-lg"></i> Accept</button>
                                                </form>
                                                <form asp-action="RejectPrivateOffer" method="post">
                                                    <input type="hidden" name="offerId" value="@offer.Id" />
                                                    <input type="hidden" name="auctionId" value="@Model.Id" />
                                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm"><i class="bi bi-x-lg"></i> Reject</button>
                                                </form>
                                            </div>
                                        }
                                        else if (offer.Status == "Accepted")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">Accepted</span>
                                        }
                                    </div>
                                }
                                @if(!Model.PrivateOffers.Any(o => o.Status == "Pending" || o.Status == "Accepted"))
                                {
                                    <div class="list-group-item p-4 text-center text-muted small">No pending offers.</div>
                                }
                            </div>
                        </div>
                    }

                    <!-- History Timeline -->
                    <div class="mt-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold mb-0">Bid History</h5>
                            <span class="badge bg-light text-dark rounded-pill border">@Model.Bids.Count() Bids</span>
                        </div>
                        
                        <div class="timeline">
                            @if (!Model.Bids.Any())
                            {
                                <div class="text-center py-4 bg-light rounded-4">
                                    <p class="text-muted small mb-0">No bids yet. Be the first!</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var bid in Model.Bids.Take(5))
                                {
                                    <div class="d-flex align-items-center p-3 mb-3 bg-white border border-light rounded-5 shadow-sm hover-lift">
                                        <div class="avatar-xs bg-primary-subtle bg-light text-primary me-3">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong class="text-dark">@bid.Bidder</strong>
                                                <span class="fw-bold text-primary">@bid.Amount.ToString("C")</span>
                                            </div>
                                            <small class="text-muted x-small">@bid.BidTime.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-transparent border-0 position-relative">

                <button type="button"
                        class="position-absolute top-0 end-0 m-3 border-0 bg-transparent p-0"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        style="z-index: 1060;">

                    <i class="bi bi-x-lg text-danger fs-3"></i>
                </button>

                <div class="modal-body p-0 text-center" style="position: relative; z-index: 1055;">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/800x600?text=No+Image" : Model.ImageUrl)"
                         class="img-fluid rounded-4 shadow-lg"
                         style="max-height: 85vh; object-fit: contain; cursor: pointer;">
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .letter-spacing-1 { letter-spacing: 1px; }
    .x-small { font-size: 0.75rem; }
    .avatar-xs { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; }
    .bi-x-circle-fill {
        line-height: 1;
        box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }
    .modal-backdrop {
        background-color: rgba(0, 0, 0, 0.8) !important; 
    }
    .modal-backdrop.show {
        opacity: 1 !important; 
        backdrop-filter: blur(10px) !important;
        -webkit-backdrop-filter: blur(10px) !important;
    }
    .modal.fade .modal-dialog {
        transform: scale(0.8);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .modal.show .modal-dialog {
        transform: scale(1);
    }
    
    @@keyframes scaleDrop {
        0% { transform: scale(1); color: inherit; }
        50% { transform: scale(1.1); color: #198754; text-shadow: 0 0 15px rgba(25,135,84,0.5); }
        100% { transform: scale(1); color: inherit; text-shadow: none; }
    }
    
    .price-update-anim {
        animation: scaleDrop 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    /* Star Rating Styles */
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
    }
    .star-rating input { display: none; }
    .star-rating label {
        cursor: pointer;
        color: #ddd;
        transition: color 0.2s;
    }
    .star-rating label:hover,
    .star-rating label:hover ~ label,
    .star-rating input:checked ~ label {
        color: #ffc107;
    }
</style>

@section Modals {
    <!-- Offer Modal -->
    <div class="modal fade" id="offerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-5">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="fw-bold mb-0">Make a Private Offer</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form asp-controller="Auctions" asp-action="MakePrivateOffer" method="post">
                        <input type="hidden" name="auctionId" value="@Model.Id" />
                        <label class="form-label small fw-bold text-muted text-uppercase">Your Offer Amount</label>
                        <div class="input-group input-group-lg mb-3">
                            <span class="input-group-text bg-light border-0 ps-4 text-primary fw-bold">€</span>
                            <input type="text" name="offerAmount" class="form-control bg-light border-0 py-3" placeholder="0.00" oninput="this.value = this.value.replace(/[^0-9,.]/g, '').replace('.', ',')" inputmode="decimal" required>
                        </div>
                        <div class="alert alert-warning alert-permanent border-0 rounded-4 small p-3 d-flex align-items-center mb-4">
                            <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                            <div>These funds will be temporarily held from your wallet. They will be refunded if the seller rejects your offer.</div>
                        </div>
                        <button type="submit" class="btn btn-secondary text-white w-100 rounded-pill py-3 fw-bold shadow-sm">Send Offer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Modal -->
    <div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-flag-fill me-2"></i>Report Auction</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form asp-controller="Auctions" asp-action="Report" method="post">
                        <input type="hidden" name="auctionId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Reason</label>
                            <select name="reason" class="form-select rounded-3 border-light bg-light" required>
                                <option value="">Choose a reason...</option>
                                <option value="Fraud">Potential Fraud / Scam</option>
                                <option value="Offensive">Offensive Content</option>
                                <option value="Incorrect">Misleading Information</option>
                                <option value="Prohibited">Prohibited Item</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Details</label>
                            <textarea name="details" class="form-control rounded-3 border-light bg-light" rows="4" placeholder="Please describe the issue in detail..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-3 fw-bold shadow-sm">
                            Submit Report
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Image Lightbox Modal -->
    <div class="modal fade" id="imageLightbox" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body p-0 position-relative">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-4 shadow-none" data-bs-dismiss="modal" aria-label="Close" style="z-index: 10;"></button>
                    <img src="" id="lightboxImg" class="img-fluid rounded-4 shadow-lg w-100" style="max-height: 95vh; object-fit: contain;" />
                </div>
            </div>
        </div>
    </div>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const auctionId = "@Model.PublicId";
    
    function swapMainImage(src, thumbElement) {
        document.getElementById('mainDisplayImage').src = src;
        document.querySelectorAll('.thumb-item img').forEach(i => {
            i.classList.remove('border-primary', 'border-2');
            i.classList.add('border-light');
        });
        thumbElement.querySelector('img').classList.remove('border-light');
        thumbElement.querySelector('img').classList.add('border-primary', 'border-2');
    }

    function openFullImage(src) {
        document.getElementById('lightboxImg').src = src;
        new bootstrap.Modal(document.getElementById('imageLightbox')).show();
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/bidding", {
            headers: { "X-XSRF-TOKEN": document.cookie.split('; ').find(row => row.startsWith('XSRF-TOKEN='))?.split('=')[1] }
        })
        .build();

    connection.on("ReceiveNewBid", function (amount, bidderName, bidTime) {
        const formatter = new Intl.NumberFormat('bg-BG', {
            style: 'currency',
            currency: 'EUR'
        });
        
        const fAmount = formatter.format(amount);

        const mainPrice = document.getElementById('current-high-price');
        if (mainPrice) {
            mainPrice.innerText = fAmount;
            mainPrice.classList.remove('price-update-anim');
            void mainPrice.offsetWidth;
            mainPrice.classList.add('price-update-anim');
        }

        const amountInput = document.querySelector('input[name="Amount"]');
        if (amountInput) {
            const minIncreaseStr = "@Model.MinIncrease.ToString(System.Globalization.CultureInfo.InvariantCulture)";
            const minIncrease = parseFloat(minIncreaseStr);
            const nextSuggested = amount + minIncrease;
            
            const nf = new Intl.NumberFormat('bg-BG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            let formattedValue = nf.format(nextSuggested);
            // If the formatting outputs something like '10,00', ensure we don't have currency symbol in the input field, which our format won't by default but just in case.
            amountInput.value = formattedValue;
        }

        const timeline = document.querySelector('.timeline');
        if (timeline) {
            const noBidsMsg = timeline.querySelector('.text-center.py-4');
            if (noBidsMsg) noBidsMsg.remove();

            const dateObj = new Date(bidTime);
            // Format to match C# ToLocalTime().ToString("MMM dd, HH:mm") like Jan 14, 15:30
            const dateStr = dateObj.toLocaleDateString('en-US', { month: 'short', day: '2-digit' }) + ', ' +
                            dateObj.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute:'2-digit' });

            const newBidHtml = `
                <div class="d-flex align-items-center p-3 mb-3 bg-white border border-light rounded-5 shadow-sm hover-lift" style="animation: fadeIn 0.5s;">
                    <div class="avatar-xs bg-primary-subtle bg-light text-primary me-3">
                        <i class="bi bi-person"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-dark">${bidderName}</strong>
                            <span class="fw-bold text-primary">${fAmount}</span>
                        </div>
                        <small class="text-muted x-small">${dateStr}</small>
                    </div>
                </div>
            `;
            
            timeline.insertAdjacentHTML('afterbegin', newBidHtml);

            const bids = timeline.querySelectorAll('.d-flex.align-items-center.p-3');
            if (bids.length > 5) {
                bids[5].remove();
            }
            
            const bidCountBadge = document.querySelector('.badge.bg-light.text-dark');
            if (bidCountBadge) {
                const currentCount = parseInt(bidCountBadge.innerText.split(' ')[0]) || 0;
                bidCountBadge.innerText = (currentCount + 1) + ' Bids';
            }
        }
    });

    connection.start().then(function () {
        connection.invoke("JoinAuctionGroup", auctionId).catch(function (err) {
            return console.error(err.toString());
        });
    }).catch(function (err) {
        return console.error(err.toString());
    });

    // Countdown Timer Logic
    function updateTimer() {
        const timerElement = document.getElementById('countdown-timer');
        if (!timerElement) return;

        const endTimeStr = timerElement.getAttribute('data-endtime');
        const endTime = new Date(endTimeStr).getTime();
        const now = new Date().getTime();
        const distance = endTime - now;

        if (distance < 0) {
            timerElement.innerHTML = "EXPIRED";
            timerElement.classList.remove('text-danger');
            timerElement.classList.add('text-secondary');
            return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        let timerText = "";
        if (days > 0) timerText += days + "d ";
        timerText += hours.toString().padStart(2, '0') + "h " + 
                     minutes.toString().padStart(2, '0') + "m " + 
                     seconds.toString().padStart(2, '0') + "s";

        timerElement.innerHTML = timerText;

        // Visual urgency
        if (distance < 60000) { // Less than 1 minute
            timerElement.classList.add('text-danger');
            if (seconds % 2 === 0) timerElement.style.opacity = "0.7";
            else timerElement.style.opacity = "1";
        }
    }

    setInterval(updateTimer, 1000);
    updateTimer();

    // Quick Bid Logic
    function addBid(amount) {
        const amountInput = document.querySelector('input[name="Amount"]');
        if (!amountInput) return;

        // Parse current value (handling comma as decimal separator)
        let currentVal = parseFloat(amountInput.value.replace(',', '.'));
        if (isNaN(currentVal)) currentVal = 0;

        const newVal = currentVal + amount;
        
        // Format back with comma
        amountInput.value = newVal.toFixed(2).replace('.', ',');
        
        // Trigger visual feedback
        amountInput.classList.add('is-valid');
        setTimeout(() => amountInput.classList.remove('is-valid'), 500);
    }
</script>
