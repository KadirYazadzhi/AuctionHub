@model AuctionHub.Models.ViewModels.AuctionFormModel
@{
    ViewData["Title"] = "List Your Item";
}

<div class="container-fluid py-5 bg-light min-vh-100">
    <div class="container">
        <div class="row g-5">
            <!-- Left Side: The Wizard Form -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg rounded-5 overflow-hidden animate-fade-up">
                    <!-- Progress Bar -->
                    <div class="progress rounded-0" style="height: 6px;">
                        <div id="formProgress" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 33%"></div>
                    </div>

                    <div class="card-body p-4 p-lg-5">
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger border-0 rounded-4 mb-4 shadow-sm animate-fade-up">
                                <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
                            </div>
                        }
                        
                        <form asp-action="Create" method="post" enctype="multipart/form-data" id="auctionForm">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                            <input type="hidden" id="ImageUrl" name="ImageUrl" />
                            <input type="hidden" id="AdditionalImageUrlsJson" name="AdditionalImageUrlsJson" />

                            <!-- Step 1: Basic Information -->
                            <div class="form-step" id="step1">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="step-num bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3">1</div>
                                    <h3 class="fw-bold mb-0">What are you selling?</h3>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Title" class="form-label fw-bold text-dark">Title <span class="text-danger">*</span></label>
                                    <input asp-for="Title" id="inputTitle" class="form-control form-control-lg rounded-4 border-2 border-light bg-light focus-ring" placeholder="Describe your item in a few words..." />
                                    <div class="form-text text-muted">A clear title helps buyers find your listing faster.</div>
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="CategoryId" class="form-label fw-bold text-dark">Category <span class="text-danger">*</span></label>
                                    <select asp-for="CategoryId" id="inputCategory" class="form-select form-select-lg rounded-4 border-2 border-light bg-light focus-ring" asp-items="Model.Categories">
                                        <option value="">Choose a category...</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Description" class="form-label fw-bold text-dark">Description <span class="text-danger">*</span></label>
                                    <textarea asp-for="Description" id="inputDescription" class="form-control rounded-4 border-2 border-light bg-light focus-ring" rows="6" placeholder="Details about condition, history, or special features..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>

                                <div class="d-flex justify-content-end mt-5">
                                    <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm next-step" data-next="location">
                                        Next: Item Location <i class="bi bi-geo-alt ms-2"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- New Step: Location Selection -->
                            <div class="form-step d-none" id="step-location">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="step-num bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3">L</div>
                                    <h3 class="fw-bold mb-0">Where is the item located?</h3>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-4">
                                        <label asp-for="Country" class="form-label fw-bold">Country</label>
                                        <input asp-for="Country" class="form-control rounded-pill bg-light" placeholder="e.g. Bulgaria" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="City" class="form-label fw-bold">City <span class="text-danger">*</span></label>
                                        <input asp-for="City" id="inputCity" class="form-control rounded-pill bg-light" placeholder="e.g. Sofia" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="District" class="form-label fw-bold">District</label>
                                        <input asp-for="District" id="inputDistrict" class="form-control rounded-pill bg-light" placeholder="e.g. Mladost" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <p class="text-muted small mb-2"><i class="bi bi-info-circle me-1"></i> Drag the marker or click on the map to set the approximate location. Only City/District will be visible to buyers.</p>
                                    <div id="map" class="rounded-4 shadow-sm border" style="height: 350px; z-index: 1;"></div>
                                    <input type="hidden" asp-for="Latitude" id="inputLat" />
                                    <input type="hidden" asp-for="Longitude" id="inputLng" />
                                </div>

                                <div class="d-flex justify-content-between mt-5">
                                    <button type="button" class="btn btn-light btn-lg rounded-pill px-4 prev-step" data-prev="1">Back</button>
                                    <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm next-step" data-next="2">
                                        Next: Pricing & Time <i class="bi bi-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Step 2: Pricing and Time -->
                            <div class="form-step d-none" id="step2">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="step-num bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3">2</div>
                                    <h3 class="fw-bold mb-0">Set your price & duration</h3>
                                </div>

                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <label asp-for="StartPrice" class="form-label fw-bold text-dark">Starting Price (€)</label>
                                        <div class="input-group input-group-lg shadow-sm rounded-4 overflow-hidden">
                                            <span class="input-group-text bg-white border-0 ps-4">€</span>
                                            <input type="text" asp-for="StartPrice" id="inputPrice" class="form-control border-0 ps-2 price-input" placeholder="0,00" inputmode="decimal" />
                                        </div>
                                        <span asp-validation-for="StartPrice" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="MinIncrease" class="form-label fw-bold text-dark">Min Increase (€)</label>
                                        <div class="input-group input-group-lg shadow-sm rounded-4 overflow-hidden">
                                            <span class="input-group-text bg-white border-0 ps-4">€</span>
                                            <input type="text" asp-for="MinIncrease" id="inputMinIncrease" class="form-control border-0 ps-2 price-input" placeholder="0,10" inputmode="decimal" />
                                        </div>
                                        <span asp-validation-for="MinIncrease" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <label asp-for="BuyItNowPrice" class="form-label fw-bold text-dark">Buy It Now Price (Optional)</label>
                                        <div class="input-group input-group-lg shadow-sm rounded-4 overflow-hidden">
                                            <span class="input-group-text bg-white border-0 ps-4">€</span>
                                            <input type="text" asp-for="BuyItNowPrice" id="inputBuyItNow" class="form-control border-0 ps-2 price-input" placeholder="Leave empty to disable" inputmode="decimal" />
                                        </div>
                                        <div class="form-text text-muted">Buyers can end the auction instantly.</div>
                                        <span asp-validation-for="BuyItNowPrice" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ReservePrice" class="form-label fw-bold text-dark">Reserve Price (Optional)</label>
                                        <div class="input-group input-group-lg shadow-sm rounded-4 overflow-hidden">
                                            <span class="input-group-text bg-white border-0 ps-4">€</span>
                                            <input type="text" asp-for="ReservePrice" id="inputReservePrice" class="form-control border-0 ps-2 price-input" placeholder="Hidden minimum price" inputmode="decimal" />
                                        </div>
                                        <div class="form-text text-muted">Item won't be sold unless bids reach this.</div>
                                        <span asp-validation-for="ReservePrice" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="EndTime" class="form-label fw-bold text-dark">Auction End Date & Time</label>
                                    <input asp-for="EndTime" id="inputEndTime" class="form-control form-control-lg rounded-4 border-2 border-light bg-light mb-3" type="datetime-local" />
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="setPresetTime(3)">3 Days</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="setPresetTime(7)">1 Week</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="setPresetTime(14)">2 Weeks</button>
                                    </div>
                                    <span asp-validation-for="EndTime" class="text-danger"></span>
                                </div>

                                <!-- Dutch Auction Toggle -->
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                                    <div class="card-header bg-gradient bg-info bg-opacity-10 border-0 p-4">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-info bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 56px; height: 56px;">
                                                    <i class="bi bi-arrow-down-circle-fill text-info fs-4"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-1 fw-bold">Dutch Auction</h6>
                                                    <p class="text-muted small mb-0">Price drops over time until someone bids</p>
                                                </div>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsDutchAuction" id="dutchToggle" style="width: 3rem; height: 1.5rem;">
                                                <label class="form-check-label visually-hidden" for="dutchToggle">Enable Dutch Auction</label>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div id="dutchFields" class="card-body p-4 bg-light bg-opacity-50 d-none">
                                        <div class="alert alert-info border-0 rounded-3 mb-4">
                                            <i class="bi bi-info-circle-fill me-2"></i>
                                            <small>In a Dutch Auction, the price starts at your Starting Price and automatically drops by the specified amount at each interval. The first bidder wins immediately.</small>
                                        </div>
                                        
                                        <div class="row g-4">
                                            <div class="col-md-6">
                                                <label asp-for="DutchDecrementAmount" class="form-label fw-semibold text-dark mb-2">
                                                    <i class="bi bi-currency-euro text-info me-1"></i>
                                                    Price Drop Amount
                                                </label>
                                                <div class="input-group shadow-sm">
                                                    <span class="input-group-text bg-white border-end-0">
                                                        <i class="bi bi-dash-circle text-muted"></i>
                                                    </span>
                                                    <input asp-for="DutchDecrementAmount" class="form-control border-start-0 ps-0" type="number" step="0.01" min="0.01" placeholder="e.g., 5.00" />
                                                    <span class="input-group-text bg-white border-start-0">€</span>
                                                </div>
                                                <small class="text-muted">How much the price drops each interval</small>
                                            </div>
                                            
                                            <div class="col-md-6">
                                                <label asp-for="DutchDecrementIntervalMinutes" class="form-label fw-semibold text-dark mb-2">
                                                    <i class="bi bi-clock-fill text-info me-1"></i>
                                                    Drop Interval
                                                </label>
                                                <div class="input-group shadow-sm">
                                                    <span class="input-group-text bg-white border-end-0">
                                                        <i class="bi bi-stopwatch text-muted"></i>
                                                    </span>
                                                    <input asp-for="DutchDecrementIntervalMinutes" class="form-control border-start-0 ps-0" type="number" min="1" placeholder="e.g., 10" />
                                                    <span class="input-group-text bg-white border-start-0">min</span>
                                                </div>
                                                <small class="text-muted">How often the price drops</small>
                                            </div>
                                        </div>
                                        
                                        <div class="mt-4 p-3 bg-white rounded-3 border border-info border-opacity-25">
                                            <div class="d-flex align-items-start">
                                                <i class="bi bi-lightbulb-fill text-warning fs-5 me-2 mt-1"></i>
                                                <div>
                                                    <strong class="d-block mb-1">Example:</strong>
                                                    <small class="text-muted">Starting Price: €100 | Drop Amount: €5 | Interval: 10 minutes<br>
                                                    Price drops to €95 after 10 min, €90 after 20 min, etc.</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-5">
                                    <button type="button" class="btn btn-light btn-lg rounded-pill px-4 prev-step" data-prev="1">Back</button>
                                    <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm next-step" data-next="3">
                                        Next: Photos & Boost <i class="bi bi-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Step 3: Photos and Promotion -->
                            <div class="form-step d-none" id="step3">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="step-num bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3">3</div>
                                    <h3 class="fw-bold mb-0">Visuals & Visibility</h3>
                                </div>

                                <div class="image-upload-zone rounded-5 bg-light border-2 border-dashed d-flex flex-column align-items-center justify-content-center p-5 mb-4 transition-all" id="dropZone">
                                    <i class="bi bi-cloud-arrow-up display-3 text-primary mb-3 opacity-50"></i>
                                    <h5 class="fw-bold">Drag & Drop photos here</h5>
                                    <p class="text-muted small">Supports JPG, PNG, WebP (Max 5MB per file)</p>
                                    <input type="file" id="fileInput" name="AdditionalImageFiles" multiple class="d-none" accept="image/*" />
                                    <button type="button" class="btn btn-primary rounded-pill px-4" onclick="document.getElementById('fileInput').click()">
                                        <i class="bi bi-folder2-open me-2"></i>Browse Files
                                    </button>
                                </div>

                                <div class="mb-4">
                                    <div class="input-group shadow-sm rounded-pill overflow-hidden border">
                                        <span class="input-group-text bg-white border-0 ps-4 text-primary"><i class="bi bi-link-45deg"></i></span>
                                        <input type="text" id="urlInput" class="form-control border-0 px-2" placeholder="Add image by URL..." />
                                        <button type="button" class="btn btn-primary px-4 fw-bold" id="addUrlBtn">Add</button>
                                    </div>
                                </div>

                                <div class="row row-cols-3 row-cols-md-5 g-2 mb-5" id="thumbnailGrid">
                                    <!-- Thumbs here -->
                                </div>

                                <!-- Premium Promotion -->
                                <div class="promotion-card card border-0 rounded-5 overflow-hidden mb-4 shadow-sm bg-warning bg-opacity-10 p-1">
                                    <div class="card-body p-4 d-flex align-items-start">
                                        <div class="form-check form-switch fs-3 mb-0 mt-1">
                                            <input class="form-check-input" type="checkbox" asp-for="ShouldPromote" role="switch" id="promoToggle">
                                        </div>
                                        <div class="ms-3">
                                            <h5 class="fw-bold mb-1">🚀 Boost My Listing (Recommended)</h5>
                                            <p class="text-muted small mb-0">Feature your item at the top of search results and give it a premium golden highlight. Best for fast sales.</p>
                                            <div class="mt-2 text-primary fw-bold fs-5">Cost: 5.00€</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-5">
                                    <button type="button" class="btn btn-light btn-lg rounded-pill px-4 prev-step" data-prev="2">Back</button>
                                    <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 py-3 fw-bold shadow hover-lift" id="submitBtn">
                                        Launch Auction <i class="bi bi-rocket-takeoff ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Side: Live Preview Card -->
            <div class="col-lg-4 d-none d-lg-block">
                <div class="sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-4 text-muted text-uppercase small letter-spacing-1">Live Preview</h5>
                    
                    <div id="previewCardContainer" class="animate-pulse-slow">
                        <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden" id="previewCard">
                            <div class="position-absolute top-0 start-0 m-3" style="z-index: 5;">
                                <span class="badge bg-dark bg-opacity-75 backdrop-blur rounded-pill px-3 py-2 shadow-sm" id="previewCategory">Category</span>
                            </div>
                            
                            <div id="previewPromoteBadge" class="position-absolute top-0 end-0 m-3 z-1 d-none">
                                <span class="badge bg-warning text-dark shadow-sm rounded-pill px-3 py-2 fw-bold">PROMOTED</span>
                            </div>

                            <div class="ratio ratio-4x3 overflow-hidden bg-light d-flex align-items-center justify-content-center border-bottom">
                                <div id="noImagePlaceholder" class="text-center p-5">
                                    <i class="bi bi-image text-muted display-1 opacity-25"></i>
                                    <p class="text-muted small mt-2">No images added yet</p>
                                </div>
                                <img id="previewImage" src="" class="img-fluid object-fit-cover transition-transform d-none" style="transition: transform 0.5s ease;" />
                            </div>

                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold mb-3 text-truncate" id="previewTitle">Auction Title</h5>
                                
                                <div class="d-flex justify-content-between align-items-end mb-4">
                                    <div>
                                        <p class="text-muted small mb-1">Starting Price</p>
                                        <h3 class="text-primary fw-bold mb-0" id="previewPrice">0.00€</h3>
                                    </div>
                                    <div class="text-end">
                                        <p class="text-muted small mb-1">Time Remaining</p>
                                        <span class="text-danger fw-bold small" id="previewTime">7 days</span>
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button class="btn btn-primary rounded-pill py-2 fw-bold disabled opacity-50">Place Bid</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4 p-4 rounded-4 bg-white shadow-sm border-start border-4 border-primary">
                        <h6 class="fw-bold"><i class="bi bi-lightbulb text-warning me-2"></i>Listing Tip</h6>
                        <p class="small text-muted mb-0">Adding a detailed description and multiple high-quality photos increases buyer trust and final sale price by up to 40%.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .step-num { width: 35px; height: 35px; font-size: 1.1rem; }
    .image-upload-zone { cursor: pointer; transition: all 0.3s; }
    .image-upload-zone:hover { background-color: #f8f9fa !important; border-color: var(--bs-primary) !important; }
    [data-bs-theme="dark"] .image-upload-zone:hover { background-color: rgba(255, 255, 255, 0.05) !important; }
    [data-bs-theme="dark"] .image-upload-zone { background-color: rgba(255, 255, 255, 0.02) !important; }
    .thumb-wrapper { position: relative; aspect-ratio: 1/1; overflow: hidden; border-radius: 12px; cursor: pointer; }
    .thumb-wrapper img { width: 100%; height: 100%; object-fit: cover; }
    .thumb-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s; padding: 5px; }
    .thumb-wrapper:hover .thumb-overlay { opacity: 1; }
    .thumb-remove { position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; background: rgba(220, 53, 69, 0.9); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; border: none; z-index: 10; }
    .promotion-card { border: 2px solid transparent !important; transition: all 0.3s ease; }
    .promotion-card:has(.form-check-input:checked) { border-color: #ffc107 !important; background-color: rgba(255, 193, 7, 0.2) !important; transform: scale(1.02); }
    .backdrop-blur { backdrop-filter: blur(8px); }
    .animate-pulse-slow { animation: pulse-slow 3s infinite; }
    @@keyframes pulse-slow { 0%, 100% { opacity: 1; } 50% { opacity: 0.95; } }
    .focus-ring:focus { box-shadow: 0 0 0 0.25rem rgba(67, 97, 238, 0.15); border-color: var(--bs-primary) !important; outline: 0; }

    @@media (max-width: 767.98px) {
        .btn-lg {
            padding: 0.8rem 1.5rem !important;
            font-size: 1rem !important;
        }
        .form-step h3 {
            font-size: 1.4rem !important;
        }
        .step-num {
            width: 30px;
            height: 30px;
            font-size: 0.9rem;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Fix for jQuery Validation with Bulgarian comma
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.]\d{3})+)(?:[\,]\d+)?$/.test(value);
        };

        document.addEventListener('DOMContentLoaded', function() {
            const steps = document.querySelectorAll('.form-step');
            const progressBar = document.getElementById('formProgress');
            const nextBtns = document.querySelectorAll('.next-step');
            const prevBtns = document.querySelectorAll('.prev-step');
            const hiddenUrlJson = document.getElementById('AdditionalImageUrlsJson');
            let additionalUrls = [];
            
            // Map Variables
            let map;
            let marker;

            // 1. Wizard Navigation
            nextBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const nextStep = btn.getAttribute('data-next');
                    if (nextStep === "location") {
                        goToStep("location");
                        initMap();
                    } else {
                        goToStep(parseInt(nextStep));
                    }
                });
            });

            prevBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const prevStep = btn.getAttribute('data-prev');
                    goToStep(prevStep === "location" ? "location" : parseInt(prevStep));
                });
            });

            function goToStep(num) {
                steps.forEach(s => s.classList.add('d-none'));
                const stepId = isNaN(num) ? 'step-' + num : 'step' + num;
                document.getElementById(stepId).classList.remove('d-none');
                
                let progress = 33;
                if (num === "location") progress = 45;
                else if (num === 2) progress = 66;
                else if (num === 3) progress = 100;

                progressBar.style.width = progress + '%';
                window.scrollTo({ top: 0, behavior: 'smooth' });
                
                if (num === "location" && map) {
                    setTimeout(() => map.invalidateSize(), 100);
                }
            }

            function initMap() {
                if (map) return;
                
                // Sofia default center
                const defaultPos = [42.6977, 23.3219];
                map = L.map('map').setView(defaultPos, 13);
                
                // Use OpenStreetMap standard tiles for better detail (shows neighborhoods/districts)
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                    subdomains: ['a', 'b', 'c'],
                    maxZoom: 19,
                    minZoom: 3
                }).addTo(map);

                marker = L.marker(defaultPos, { draggable: true }).addTo(map);
                
                function updateCoords(lat, lng) {
                    document.getElementById('inputLat').value = lat.toFixed(6);
                    document.getElementById('inputLng').value = lng.toFixed(6);
                    
                    // Basic Reverse Geocoding via Nominatim (Free)
                    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=en&addressdetails=1&namedetails=1`, {
                        headers: {
                            'User-Agent': 'AuctionHub/1.0'
                        }
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.address) {
                                // Helper function to transliterate Bulgarian Cyrillic to Latin
                                function transliterate(text) {
                                    if (!text) return text;
                                    const map = {
                                        'А':'A','Б':'B','В':'V','Г':'G','Д':'D','Е':'E','Ж':'Zh','З':'Z','И':'I','Й':'Y',
                                        'К':'K','Л':'L','М':'M','Н':'N','О':'O','П':'P','Р':'R','С':'S','Т':'T','У':'U',
                                        'Ф':'F','Х':'H','Ц':'Ts','Ч':'Ch','Ш':'Sh','Щ':'Sht','Ъ':'A','Ь':'Y','Ю':'Yu','Я':'Ya',
                                        'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','ж':'zh','з':'z','и':'i','й':'y',
                                        'к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u',
                                        'ф':'f','х':'h','ц':'ts','ч':'ch','ш':'sh','щ':'sht','ъ':'a','ь':'y','ю':'yu','я':'ya'
                                    };
                                    return text.split('').map(char => map[char] || char).join('');
                                }
                                
                                // Prefer English names from address components
                                let city = data.address.city || data.address.town || data.address.village || 
                                            data.address.municipality || data.address.county || "";
                                let district = data.address.suburb || data.address.neighbourhood || 
                                                data.address.quarter || data.address.district || "";
                                
                                // Check if names contain Cyrillic characters and transliterate if needed
                                if (/[А-Яа-я]/.test(city)) {
                                    city = transliterate(city);
                                }
                                if (/[А-Яа-я]/.test(district)) {
                                    district = transliterate(district);
                                }
                                
                                document.getElementById('inputCity').value = city;
                                document.getElementById('inputDistrict').value = district;
                            }
                        })
                        .catch(err => console.error('Geocoding error:', err));
                }

                map.on('click', (e) => {
                    marker.setLatLng(e.latlng);
                    updateCoords(e.latlng.lat, e.latlng.lng);
                });

                marker.on('dragend', (e) => {
                    updateCoords(e.target.getLatLng().lat, e.target.getLatLng().lng);
                });
                
                // Ask for browser location
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(pos => {
                        const userPos = [pos.coords.latitude, pos.coords.longitude];
                        map.setView(userPos, 14);
                        marker.setLatLng(userPos);
                        updateCoords(pos.coords.latitude, pos.coords.longitude);
                    });
                }
            }

            // 2. Real-time Preview Logic
            const inputs = {
                title: document.getElementById('inputTitle'),
                category: document.getElementById('inputCategory'),
                price: document.getElementById('inputPrice'),
                endTime: document.getElementById('inputEndTime'),
                promo: document.getElementById('promoToggle'),
                mainUrl: document.getElementById('ImageUrl')
            };

            const previews = {
                title: document.getElementById('previewTitle'),
                category: document.getElementById('previewCategory'),
                price: document.getElementById('previewPrice'),
                time: document.getElementById('previewTime'),
                badge: document.getElementById('previewPromoteBadge'),
                card: document.getElementById('previewCard'),
                image: document.getElementById('previewImage'),
                placeholder: document.getElementById('noImagePlaceholder')
            };

            function updatePreview() {
                previews.title.innerText = inputs.title.value || "Auction Title";
                previews.category.innerText = inputs.category.options[inputs.category.selectedIndex]?.text || "Category";
                
                // Parse price handling Bulgarian comma
                const rawPrice = inputs.price.value.replace(',', '.');
                previews.price.innerText = (parseFloat(rawPrice) || 0).toFixed(2) + '€';
                
                if (inputs.endTime.value) {
                    const diff = new Date(inputs.endTime.value) - new Date();
                    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                    previews.time.innerText = days > 0 ? days + " days" : "Expiring soon";
                }

                if (inputs.promo.checked) {
                    previews.badge.classList.remove('d-none');
                    previews.card.classList.add('border-warning', 'border-2');
                } else {
                    previews.badge.classList.add('d-none');
                    previews.card.classList.remove('border-warning', 'border-2');
                }

                // Update Image in Preview
                if (inputs.mainUrl.value) {
                    previews.image.src = inputs.mainUrl.value;
                    previews.image.classList.remove('d-none');
                    previews.placeholder.classList.add('d-none');
                } else {
                    previews.image.classList.add('d-none');
                    previews.placeholder.classList.remove('d-none');
                }
            }

            Object.values(inputs).forEach(input => input && input.addEventListener('input', updatePreview));
            
            // Initial call to set default values (like 10.00€)
            updatePreview();

            // 3. Price Input Sanitizer
            document.querySelectorAll('.price-input').forEach(input => {
                input.addEventListener('input', function(e) {
                    let val = this.value.replace(/[^0-9,.]/g, '');
                    const parts = val.split(/[,.]/);
                    if (parts.length > 2) {
                        val = parts[0] + ',' + parts.slice(1).join('');
                    }
                    this.value = val;
                    updatePreview();
                });
            });

            // 4. Gallery Logic
            const fileInput = document.getElementById('fileInput');
            const urlInput = document.getElementById('urlInput');
            const addUrlBtn = document.getElementById('addUrlBtn');
            const thumbnailGrid = document.getElementById('thumbnailGrid');
            const mainImageUrlInput = document.getElementById('ImageUrl');
            const previewImage = document.getElementById('previewImage');
            const noImagePlaceholder = document.getElementById('noImagePlaceholder');

            function updateMainPreview() {
                if (mainImageUrlInput.value) {
                    previewImage.src = mainImageUrlInput.value;
                    previewImage.classList.remove('d-none');
                    noImagePlaceholder.classList.add('d-none');
                } else {
                    previewImage.classList.add('d-none');
                    noImagePlaceholder.classList.remove('d-none');
                }
            }

            fileInput.addEventListener('change', (e) => {
                const files = e.target.files;
                if (files.length > 0) {
                    for (let i = 0; i < files.length; i++) {
                        const reader = new FileReader();
                        reader.onload = (f) => {
                            renderThumbnail(f.target.result, true);
                        };
                        reader.readAsDataURL(files[i]);
                    }
                }
            });

            addUrlBtn.addEventListener('click', () => {
                const url = urlInput.value.trim();
                if (url) {
                    additionalUrls.push(url);
                    renderThumbnail(url, false, additionalUrls.length - 1);
                    urlInput.value = '';
                    hiddenUrlJson.value = JSON.stringify(additionalUrls);
                }
            });

            function renderThumbnail(src, isFile, index = -1) {
                const col = document.createElement('div');
                col.className = 'col animate-fade-up';
                col.innerHTML = `
                    <div class="thumb-wrapper shadow-sm border">
                        <img src="${src}" />
                        <div class="thumb-overlay">
                            <button type="button" class="btn btn-primary btn-sm rounded-pill py-1 btn-cover" onclick="setAsCover('${src}', this)">
                                <i class="bi bi-star-fill"></i> Cover
                            </button>
                        </div>
                        ${!isFile ? `<button type="button" class="thumb-remove" onclick="removeUrl(${index}, this)"><i class="bi bi-x"></i></button>` : `<button type="button" class="thumb-remove" onclick="this.closest('.col').remove(); autoSelectCover();"><i class="bi bi-x"></i></button>`}
                    </div>
                `;
                thumbnailGrid.appendChild(col);
                
                // If it's the first image ever added, set as cover automatically
                if (!mainImageUrlInput.value) {
                    setAsCover(src);
                }
            }

            window.setAsCover = (url, btn) => {
                mainImageUrlInput.value = url;
                
                // Update visuals
                document.querySelectorAll('.thumb-wrapper').forEach(el => el.classList.remove('border-primary', 'border-3'));
                document.querySelectorAll('.cover-badge').forEach(el => el.remove());
                document.querySelectorAll('.btn-cover').forEach(el => el.classList.remove('d-none'));

                const wrapper = btn ? btn.closest('.thumb-wrapper') : document.querySelector(`.thumb-wrapper img[src="${url}"]`)?.closest('.thumb-wrapper');
                if (wrapper) {
                    wrapper.classList.add('border-primary', 'border-3');
                    const coverBtn = wrapper.querySelector('.btn-cover');
                    if (coverBtn) coverBtn.classList.add('d-none');
                    wrapper.insertAdjacentHTML('afterbegin', '<span class="badge bg-primary position-absolute top-0 start-0 m-2 shadow-sm rounded-pill cover-badge" style="z-index: 5;">COVER</span>');
                }
                
                updateMainPreview();
            };
        window.autoSelectCover = () => {
            const firstImg = thumbnailGrid.querySelector('img');
            if (firstImg) {
                setAsCover(firstImg.src);
            } else {
                mainImageUrlInput.value = "";
                updateMainPreview();
            }
        };

    // Cleanup base64 before submit to avoid validation/size issues
    document.getElementById('auctionForm').addEventListener('submit', function() {
        if (mainImageUrlInput.value.startsWith('data:')) {
            mainImageUrlInput.value = ""; // Let backend pick the first file
        }
    });
    
    window.removeUrl = (index, btn) => {
        const removedUrl = additionalUrls[index];
        additionalUrls.splice(index, 1);
        btn.closest('.col').remove();
        hiddenUrlJson.value = JSON.stringify(additionalUrls);
        
        if (mainImageUrlInput.value === removedUrl) {
            autoSelectCover();
        }
    };

    window.setPresetTime = (days) => {
        const date = new Date();
        date.setDate(date.getDate() + days);
        inputs.endTime.value = date.toISOString().slice(0, 16);
        updatePreview();
    };

    const dutchToggle = document.getElementById('dutchToggle');
    const dutchFields = document.getElementById('dutchFields');
    if (dutchToggle && dutchFields) {
        dutchToggle.addEventListener('change', function() {
            if(this.checked) {
                dutchFields.classList.remove('d-none');
                // Disable min increase and buy it now logic if desired
                document.getElementById('inputMinIncrease').closest('.col-md-6').style.opacity = '0.5';
                document.getElementById('inputBuyItNow').closest('.col-md-6').style.opacity = '0.5';
            } else {
                dutchFields.classList.add('d-none');
                document.getElementById('inputMinIncrease').closest('.col-md-6').style.opacity = '1';
                document.getElementById('inputBuyItNow').closest('.col-md-6').style.opacity = '1';
            }
        });
    }
});
    </script>
}
