@model AuctionHub.Models.ViewModels.AuctionFormModel
@{
    ViewData["Title"] = "Edit Listing";
}

<div class="container py-5 bg-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-5 overflow-hidden animate-fade-up">
                <div class="card-header bg-dark bg-gradient text-white p-4 p-lg-5">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h1 class="fw-bold mb-2">Edit Listing</h1>
                            <p class="mb-0 opacity-75">Refine your auction details.</p>
                        </div>
                        <i class="bi bi-pencil-square display-4 opacity-50"></i>
                    </div>
                </div>
                
                <div class="card-body p-4 p-lg-5">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 rounded-4 mb-4 shadow-sm animate-fade-up">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
                        </div>
                    }

                    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="auctionForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                        <input type="hidden" id="AdditionalImageUrlsJson" name="AdditionalImageUrlsJson" />
                        <input type="hidden" id="ImagesToRemoveIdsJson" name="ImagesToRemoveIdsJson" />

                        <div class="row g-4">
                            <!-- Basic Info -->
                            <div class="col-lg-7">
                                <h5 class="fw-bold mb-4 text-primary border-bottom pb-2">1. Core Information</h5>
                                
                                <div class="mb-4">
                                    <label asp-for="Title" class="form-label fw-bold text-dark">Title</label>
                                    <input asp-for="Title" class="form-control form-control-lg rounded-4 border-2 border-light bg-light" />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Description" class="form-label fw-bold text-dark">Description</label>
                                    <textarea asp-for="Description" class="form-control rounded-4 border-2 border-light bg-light" rows="10"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="CategoryId" class="form-label fw-bold text-dark">Category</label>
                                    <select asp-for="CategoryId" class="form-select form-select-lg rounded-4 border-2 border-light bg-light" asp-items="Model.Categories"></select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Pricing & Gallery -->
                            <div class="col-lg-5">
                                <h5 class="fw-bold mb-4 text-primary border-bottom pb-2">2. Visuals & Pricing</h5>
                                
                                <!-- Existing Gallery Management -->
                                <div class="mb-4">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Current Gallery</label>
                                    <div class="row row-cols-3 g-2 mb-3" id="existingGallery">
                                        @foreach (var img in Model.ExistingImages)
                                        {
                                            <div class="col animate-fade-in" id="existing-img-@img.Id">
                                                <div class="thumb-wrapper border rounded-4 shadow-sm position-relative">
                                                    <img src="@img.Url" class="w-100 h-100 object-fit-cover" />
                                                    <button type="button" class="thumb-remove" onclick="markForRemoval(@img.Id)">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <small class="text-muted d-block mb-3">Click the trash icon to remove an image.</small>
                                </div>

                                <!-- Add New Media -->
                                <div class="image-upload-zone rounded-5 bg-light border-2 border-dashed d-flex flex-column align-items-center justify-content-center p-4 mb-3 transition-all" id="dropZone">
                                    <i class="bi bi-plus-circle text-primary fs-3 mb-2 opacity-50"></i>
                                    <p class="small mb-0">Add more photos</p>
                                    <input type="file" id="fileInput" name="AdditionalImageFiles" multiple class="d-none" accept="image/*" />
                                    <button type="button" class="btn btn-link text-primary btn-sm fw-bold text-decoration-none" onclick="document.getElementById('fileInput').click()">Select Files</button>
                                </div>

                                <div class="row row-cols-4 g-2 mb-4" id="newThumbnailGrid"></div>

                                <div class="bg-white p-4 rounded-5 shadow-sm border border-light mb-4">
                                    <div class="mb-3">
                                        <label asp-for="StartPrice" class="form-label fw-bold text-dark">Starting Price (€)</label>
                                        <input type="text" asp-for="StartPrice" class="form-control border-0 bg-light rounded-4 px-3" step="0.01" />
                                        <span asp-validation-for="StartPrice" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="EndTime" class="form-label fw-bold text-dark">Auction End Time</label>
                                        <input asp-for="EndTime" class="form-control border-0 bg-light rounded-4 px-3" type="datetime-local" />
                                        <span asp-validation-for="EndTime" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-5 opacity-10">

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-link text-muted text-decoration-none fw-bold">
                                <i class="bi bi-x-lg me-2"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow hover-lift">
                                Save Changes <i class="bi bi-save-fill ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .image-upload-zone { cursor: pointer; transition: all 0.3s; }
    .image-upload-zone:hover { background-color: #e9ecef !important; border-color: var(--bs-primary) !important; }
    .thumb-wrapper { position: relative; aspect-ratio: 1/1; overflow: hidden; border-radius: 12px; }
    .thumb-wrapper img { width: 100%; height: 100%; object-fit: cover; }
    .thumb-remove { position: absolute; top: 4px; right: 4px; width: 24px; height: 24px; background: rgba(220, 53, 69, 0.9); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; border: none; z-index: 5; transition: transform 0.2s; }
    .thumb-remove:hover { transform: scale(1.2); background: #dc3545; }
    .removed-img { opacity: 0.3; filter: grayscale(1); }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let removedIds = [];
            const removalInput = document.getElementById('ImagesToRemoveIdsJson');
            const fileInput = document.getElementById('fileInput');
            const thumbnailGrid = document.getElementById('newThumbnailGrid');

            window.markForRemoval = (id) => {
                const imgContainer = document.getElementById('existing-img-' + id);
                if (removedIds.includes(id)) {
                    removedIds = removedIds.filter(x => x !== id);
                    imgContainer.classList.remove('removed-img');
                } else {
                    removedIds.push(id);
                    imgContainer.classList.add('removed-img');
                }
                removalInput.value = JSON.stringify(removedIds);
            };

            fileInput.addEventListener('change', (e) => {
                for (let file of e.target.files) {
                    const reader = new FileReader();
                    reader.onload = (f) => {
                        const col = document.createElement('div');
                        col.className = 'col animate-fade-in';
                        col.innerHTML = `
                            <div class="thumb-wrapper border rounded-4 shadow-sm">
                                <img src="${f.target.result}" />
                            </div>
                        `;
                        thumbnailGrid.appendChild(col);
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}
