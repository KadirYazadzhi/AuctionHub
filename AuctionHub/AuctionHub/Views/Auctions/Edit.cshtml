@model AuctionHub.Models.ViewModels.AuctionFormModel
@{
    ViewData["Title"] = "Edit Listing";
}

<div class="container py-5 min-vh-100">
    <div class="d-flex align-items-center justify-content-between mb-5 animate-fade-in">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="MyAuctions" class="text-decoration-none text-muted">My Auctions</a></li>
                    <li class="breadcrumb-item active fw-bold text-primary">Edit</li>
                </ol>
            </nav>
            <h1 class="display-5 fw-bold text-dark mb-0">Edit <span class="text-primary">@Model.Title</span></h1>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-primary border border-primary border-opacity-25 rounded-pill px-3 py-2">
                <i class="bi bi-pencil-square me-1"></i> Update Mode
            </span>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="auctionForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" id="ImageUrl" />
        <input type="hidden" asp-for="ImagesToRemoveIdsJson" id="ImagesToRemoveIdsJson" value="[]" />
        <input type="hidden" asp-for="AdditionalImageUrlsJson" id="AdditionalImageUrlsJson" value="[]" />

        <div class="row g-5">
            <!-- Form Side -->
            <div class="col-lg-8 animate-slide-up">
                <!-- 1. Basic Info -->
                <div class="bg-white p-4 p-lg-5 rounded-5 shadow-sm border border-light mb-5">
                    <h4 class="fw-bold mb-4 d-flex align-items-center">
                        <span class="step-num bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px; font-size: 1rem;">1</span>
                        Basic Information
                    </h4>
                    
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-bold text-dark px-1">Listing Title</label>
                        <input asp-for="Title" id="inputTitle" class="form-control form-control-lg rounded-4 border-2 border-light bg-light focus-ring" placeholder="What are you selling?" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-bold text-dark px-1">Category</label>
                            <select asp-for="CategoryId" id="inputCategory" asp-items="Model.Categories" class="form-select form-select-lg rounded-4 border-2 border-light bg-light focus-ring"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndTime" class="form-label fw-bold text-dark px-1">End Time</label>
                            <input asp-for="EndTime" id="inputEndTime" class="form-control form-control-lg rounded-4 border-2 border-light bg-light focus-ring" type="datetime-local" />
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Description" class="form-label fw-bold text-dark px-1">Detailed Description</label>
                        <textarea asp-for="Description" id="inputDesc" class="form-control rounded-4 border-2 border-light bg-light focus-ring" rows="6" placeholder="Describe your item in detail..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <!-- 2. Visuals & Media -->
                <div class="bg-white p-4 p-lg-5 rounded-5 shadow-sm border border-light mb-5">
                    <h4 class="fw-bold mb-4 d-flex align-items-center">
                        <span class="step-num bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px; font-size: 1rem;">2</span>
                        Visuals & Media
                    </h4>

                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark px-1">Upload New Photos</label>
                            <div class="image-upload-zone rounded-4 bg-light border-2 border-dashed d-flex flex-column align-items-center justify-content-center p-4 transition-all" 
                                 id="dropZone" 
                                 onclick="document.getElementById('instantFileUpload').click()"
                                 style="height: 140px; cursor: pointer; border-color: #4361ee !important;">
                                <div id="uploadStatus">
                                    <i class="bi bi-cloud-arrow-up text-primary fs-2 mb-2"></i>
                                    <p class="small mb-0 text-muted">Click or drag & drop (Instant Save)</p>
                                </div>
                                <div id="uploadLoader" class="d-none text-center">
                                    <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                                    <p class="small mb-0 text-primary fw-bold">Saving to server...</p>
                                </div>
                                <input type="file" id="instantFileUpload" class="d-none" multiple accept="image/*" onchange="handleInstantUpload(this.files)" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark px-1">Add Image via URL</label>
                            <div class="input-group">
                                <input type="text" id="urlInput" class="form-control form-control-lg rounded-start-4 border-2 border-light bg-light" placeholder="https://example.com/image.jpg" />
                                <button type="button" id="addUrlBtn" class="btn btn-primary rounded-end-4 px-4">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark px-1 mb-3">Current Gallery (Saved)</label>
                        <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-3" id="existingImagesGrid">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <div class="col" id="existing-img-@img.Id">
                                    <div class="thumb-wrapper border shadow-sm h-100">
                                        <img src="@img.Url" class="img-fluid rounded-3" />
                                        <div class="thumb-overlay d-flex flex-column gap-1">
                                            <button type="button" class="btn btn-danger btn-sm rounded-pill py-1" onclick="markForRemoval(@img.Id, '@img.Url', this)">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                            <button type="button" class="btn btn-primary btn-sm rounded-pill py-1 btn-cover @(Model.ImageUrl == img.Url ? "d-none" : "")" onclick="setAsCover('@img.Url', this)">
                                                <i class="bi bi-star-fill"></i> Cover
                                            </button>
                                        </div>
                                        @if (Model.ImageUrl == img.Url)
                                        {
                                            <span class="badge bg-primary position-absolute top-0 start-0 m-2 shadow-sm rounded-pill cover-badge">COVER</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div id="newExternalImagesGrid" class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-3 mt-1">
                            <!-- New URL images will appear here temporarily -->
                        </div>
                    </div>
                </div>

                <!-- 3. Pricing -->
                <div class="bg-white p-4 p-lg-5 rounded-5 shadow-sm border border-light mb-5">
                    <h4 class="fw-bold mb-4 d-flex align-items-center">
                        <span class="step-num bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px; font-size: 1rem;">3</span>
                        Pricing & Sales
                    </h4>
                    
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label asp-for="StartPrice" class="form-label fw-bold text-dark px-1">Starting Price (€)</label>
                            <input type="text" asp-for="StartPrice" id="inputPrice" class="form-control form-control-lg rounded-4 border-2 border-light bg-light focus-ring price-input" />
                            <span asp-validation-for="StartPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ReservePrice" class="form-label fw-bold text-dark px-1">Reserve Price (€)</label>
                            <input type="text" asp-for="ReservePrice" class="form-control form-control-lg rounded-4 border-2 border-light bg-light focus-ring price-input" placeholder="Optional" />
                            <span asp-validation-for="ReservePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BuyItNowPrice" class="form-label fw-bold text-dark px-1">Buy It Now (€)</label>
                            <input type="text" asp-for="BuyItNowPrice" class="form-control form-control-lg rounded-4 border-2 border-light bg-light focus-ring price-input" placeholder="Optional" />
                            <span asp-validation-for="BuyItNowPrice" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Preview Side -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 2rem; z-index: 10;">
                    <div class="card border-0 shadow-lg rounded-5 overflow-hidden mb-4">
                        <div class="position-relative" style="aspect-ratio: 4/3;">
                            <img src="@(Model.ImageUrl ?? "/images/no-image.png")" id="previewImage" class="w-100 h-100 object-fit-cover @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")" />
                            <div id="noImagePlaceholder" class="w-100 h-100 bg-light d-flex flex-column align-items-center justify-content-center text-muted @(!string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")">
                                <i class="bi bi-image fs-1 mb-2"></i>
                                <span class="small">No image selected</span>
                            </div>
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge backdrop-blur bg-white bg-opacity-75 text-dark rounded-pill px-3 py-2 shadow-sm border border-white border-opacity-50" id="previewCategory">
                                    Category
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h5 class="fw-bold text-dark mb-3 text-truncate" id="previewTitle">@Model.Title</h5>
                            
                            <div class="d-flex justify-content-between align-items-end mb-4">
                                <div>
                                    <p class="text-muted small mb-1">Starting Price</p>
                                    <h3 class="text-primary fw-bold mb-0" id="previewPrice">@Model.StartPrice.ToString("N2")€</h3>
                                </div>
                                <div class="text-end">
                                    <p class="text-muted small mb-1">Ends On</p>
                                    <span class="text-danger fw-bold small" id="previewTime">@Model.EndTime.ToString("dd MMM")</span>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="button" class="btn btn-primary rounded-pill py-2 fw-bold disabled opacity-50">Saved Gallery is Final</button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 d-flex flex-column gap-3">
                        <button type="submit" form="auctionForm" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg hover-lift w-100">
                            Update Auction <i class="bi bi-save2-fill ms-2"></i>
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg rounded-pill px-5 py-3 fw-bold w-100">
                            <i class="bi bi-x-circle me-2"></i> Discard Changes
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .focus-ring:focus { box-shadow: 0 0 0 0.25rem rgba(67, 97, 238, 0.15); border-color: var(--bs-primary) !important; outline: 0; }
    .image-upload-zone { cursor: pointer; transition: all 0.3s; }
    .image-upload-zone:hover { background-color: rgba(67, 97, 238, 0.05) !important; border-color: var(--bs-primary) !important; }
    .thumb-wrapper { position: relative; aspect-ratio: 1/1; overflow: hidden; border-radius: 16px; transition: all 0.3s; }
    .thumb-wrapper img { width: 100%; height: 100%; object-fit: cover; }
    .thumb-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s; padding: 10px; }
    .thumb-wrapper:hover .thumb-overlay { opacity: 1; }
    .removed-img { opacity: 0.3; filter: grayscale(1); }
    .removed-img .btn-cover { display: none !important; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let removedIds = [];
            let additionalUrls = [];
            
            const inputs = {
                title: document.getElementById('inputTitle'),
                category: document.getElementById('inputCategory'),
                price: document.getElementById('inputPrice'),
                endTime: document.getElementById('inputEndTime'),
                mainUrl: document.getElementById('ImageUrl')
            };

            const previews = {
                title: document.getElementById('previewTitle'),
                category: document.getElementById('previewCategory'),
                price: document.getElementById('previewPrice'),
                time: document.getElementById('previewTime'),
                image: document.getElementById('previewImage'),
                placeholder: document.getElementById('noImagePlaceholder')
            };

            const existingImagesGrid = document.getElementById('existingImagesGrid');
            const newExternalImagesGrid = document.getElementById('newExternalImagesGrid');
            const urlJsonInput = document.getElementById('AdditionalImageUrlsJson');
            const removalJsonInput = document.getElementById('ImagesToRemoveIdsJson');
            const uploadStatus = document.getElementById('uploadStatus');
            const uploadLoader = document.getElementById('uploadLoader');

            function updatePreview() {
                previews.title.innerText = inputs.title.value || "Auction Title";
                previews.category.innerText = inputs.category.options[inputs.category.selectedIndex]?.text || "Category";
                const rawPrice = inputs.price.value.replace(',', '.');
                previews.price.innerText = (parseFloat(rawPrice) || 0).toFixed(2) + '€';
                if (inputs.endTime.value) {
                    const date = new Date(inputs.endTime.value);
                    previews.time.innerText = date.toLocaleDateString(undefined, { day: 'numeric', month: 'short' });
                }
                if (inputs.mainUrl.value) {
                    previews.image.src = inputs.mainUrl.value;
                    previews.image.classList.remove('d-none');
                    previews.placeholder.classList.add('d-none');
                } else {
                    previews.image.classList.add('d-none');
                    previews.placeholder.classList.remove('d-none');
                }
            }

            Object.values(inputs).forEach(input => input && input.addEventListener('input', updatePreview));

            // Price sanitization
            document.querySelectorAll('.price-input').forEach(input => {
                input.addEventListener('input', function() {
                    // Allow digits, comma and dot
                    this.value = this.value.replace(/[^0-9,.]/g, '');
                    updatePreview();
                });
            });

            // --- Instant AJAX Upload ---
            window.handleInstantUpload = async function(files) {
                if (!files || files.length === 0) return;
                
                uploadStatus.classList.add('d-none');
                uploadLoader.classList.remove('d-none');
                
                const auctionPublicId = "@Model.PublicId";
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                for (let file of files) {
                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch(`/Auctions/UploadImage/${auctionPublicId}`, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.ok) {
                            const data = await response.json();
                            addSavedImageToGrid(data.id, data.url);
                        } else {
                            const err = await response.text();
                            alert("Upload failed: " + err);
                        }
                    } catch (e) {
                        console.error(e);
                        alert("An error occurred during upload.");
                    }
                }

                uploadStatus.classList.remove('d-none');
                uploadLoader.classList.add('d-none');
                document.getElementById('instantFileUpload').value = ""; // Clear input
            };

            function addSavedImageToGrid(id, url) {
                const col = document.createElement('div');
                col.className = 'col animate-fade-in';
                col.id = `existing-img-${id}`;
                col.innerHTML = `
                    <div class="thumb-wrapper border shadow-sm h-100">
                        <img src="${url}" class="img-fluid rounded-3" />
                        <div class="thumb-overlay d-flex flex-column gap-1">
                            <button type="button" class="btn btn-danger btn-sm rounded-pill py-1" onclick="markForRemoval(${id}, '${url}', this)">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill py-1 btn-cover" onclick="setAsCover('${url}', this)">
                                <i class="bi bi-star-fill"></i> Cover
                            </button>
                        </div>
                    </div>
                `;
                existingImagesGrid.appendChild(col);
                if (!inputs.mainUrl.value) setAsCover(url, col.querySelector('.btn-cover'));
            }

            // Drag & Drop
            const dropZone = document.getElementById('dropZone');
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, e => { e.preventDefault(); e.stopPropagation(); }, false);
            });
            dropZone.addEventListener('drop', e => { handleInstantUpload(e.dataTransfer.files); }, false);

            // Handle New URLs (External)
            document.getElementById('addUrlBtn').addEventListener('click', () => {
                const url = document.getElementById('urlInput').value.trim();
                if (url) {
                    additionalUrls.push(url);
                    renderUrlThumbnail(url, additionalUrls.length - 1);
                    document.getElementById('urlInput').value = '';
                    urlJsonInput.value = JSON.stringify(additionalUrls);
                }
            });

            function renderUrlThumbnail(url, index) {
                const col = document.createElement('div');
                col.className = 'col animate-fade-in';
                col.innerHTML = `
                    <div class="thumb-wrapper border border-info shadow-sm h-100">
                        <img src="${url}" class="img-fluid rounded-3" />
                        <div class="thumb-overlay d-flex flex-column gap-1">
                            <button type="button" class="btn btn-danger btn-sm rounded-pill py-1" onclick="removeNewUrl(${index}, this)">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill py-1 btn-cover" onclick="setAsCover('${url}', this)">
                                <i class="bi bi-star-fill"></i> Cover
                            </button>
                        </div>
                        <span class="badge bg-info position-absolute bottom-0 start-0 m-2 rounded-pill small">URL</span>
                    </div>
                `;
                newExternalImagesGrid.appendChild(col);
            }

            window.removeNewUrl = (index, btn) => {
                const removedUrl = additionalUrls[index];
                additionalUrls.splice(index, 1);
                btn.closest('.col').remove();
                urlJsonInput.value = JSON.stringify(additionalUrls);
                if (inputs.mainUrl.value === removedUrl) autoSelectCover();
            };

            window.markForRemoval = (id, url, btn) => {
                const container = document.getElementById('existing-img-' + id);
                if (removedIds.includes(id)) {
                    removedIds = removedIds.filter(x => x !== id);
                    container.classList.remove('removed-img');
                } else {
                    removedIds.push(id);
                    container.classList.add('removed-img');
                    if (inputs.mainUrl.value === url) autoSelectCover();
                }
                removalJsonInput.value = JSON.stringify(removedIds);
            };

            window.setAsCover = (url, btn) => {
                inputs.mainUrl.value = url;
                document.querySelectorAll('.thumb-wrapper').forEach(el => el.classList.remove('border-primary', 'border-3'));
                document.querySelectorAll('.cover-badge').forEach(el => el.remove());
                document.querySelectorAll('.btn-cover').forEach(el => el.classList.remove('d-none'));
                if (btn) {
                    const wrapper = btn.closest('.thumb-wrapper');
                    wrapper.classList.add('border-primary', 'border-3');
                    btn.classList.add('d-none');
                    wrapper.insertAdjacentHTML('afterbegin', '<span class="badge bg-primary position-absolute top-0 start-0 m-2 shadow-sm rounded-pill cover-badge">COVER</span>');
                }
                updatePreview();
            };

            window.autoSelectCover = () => {
                const firstValid = document.querySelector('.thumb-wrapper:not(.removed-img) img');
                if (firstValid) {
                    setAsCover(firstValid.src, firstValid.closest('.thumb-wrapper').querySelector('.btn-cover'));
                } else {
                    inputs.mainUrl.value = "";
                    updatePreview();
                }
            };

            document.querySelectorAll('.price-input').forEach(input => {
                if (input.value) input.value = input.value.replace('.', ',');
            });

            updatePreview();
        });
    </script>
}