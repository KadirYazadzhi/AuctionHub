@model AuctionHub.Domain.Models.PaginatedList<AuctionHub.Models.ViewModels.AuctionListViewModel>
@{
    ViewData["Title"] = "Explore Auctions";
    var categories = ViewBag.Categories as IEnumerable<SelectListItem>;
    var currentSort = ViewData["CurrentSort"] as string;
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentCategory = ViewData["CurrentCategory"] as int?;
    var minPrice = ViewData["MinPrice"] as decimal?;
    var maxPrice = ViewData["MaxPrice"] as decimal?;
    var status = ViewData["Status"] as string;
}

<div class="container py-4">
    <div class="row">
        <!-- Sidebar Filters -->
        <div class="col-lg-3 mb-4 animate-fade-up">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px; z-index: 1000;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-sliders me-2"></i>Filters</h5>
                    <form method="get" asp-action="Index">
                        <!-- Search -->
                        <div class="mb-3">
                            <label class="form-label small text-uppercase text-muted fw-bold">Search</label>
                            <input type="text" name="searchTerm" class="form-control" value="@currentSearch" placeholder="Keywords..." />
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label class="form-label small text-uppercase text-muted fw-bold">Category</label>
                            <select name="categoryId" class="form-select" asp-items="categories">
                                <option value="">All Categories</option>
                            </select>
                            @if (currentCategory.HasValue)
                            {
                                <script>
                                    document.querySelector('select[name="categoryId"]').value = "@currentCategory";
                                </script>
                            }
                        </div>

                        <!-- Price Range -->
                        <div class="mb-3">
                            <label class="form-label small text-uppercase text-muted fw-bold">Price Range</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="number" name="minPrice" class="form-control" placeholder="Min" value="@minPrice" />
                                <span>-</span>
                                <input type="number" name="maxPrice" class="form-control" placeholder="Max" value="@maxPrice" />
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="mb-4">
                            <label class="form-label small text-uppercase text-muted fw-bold">Status</label>
                            <select name="status" class="form-select">
                                <option value="active">Active Only</option>
                                <option value="all">All Auctions</option>
                                <option value="closed">Closed Only</option>
                            </select>
                             @if (!string.IsNullOrEmpty(status))
                            {
                                <script>
                                    document.querySelector('select[name="status"]').value = "@status";
                                </script>
                            }
                        </div>

                        <!-- Location & Distance -->
                        <div class="mb-4">
                            <label class="form-label small text-uppercase text-muted fw-bold mb-2">Location & Distance</label>
                            
                            <div id="locationDisabledUI" class="@(ViewData["MaxDistance"] != null ? "d-none" : "")">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill w-100 py-2" id="btnEnableLocation">
                                    <i class="bi bi-geo-alt-fill me-1"></i> Use My Location
                                </button>
                                <p class="text-muted smallest mt-2 mb-0"><i class="bi bi-info-circle me-1"></i> Finds auctions near you.</p>
                            </div>

                            <div id="locationFilterUI" class="@(ViewData["MaxDistance"] != null ? "" : "d-none")">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-bold">Radius: <span id="radiusVal" class="text-primary">@(ViewData["MaxDistance"] ?? 20)</span> km</span>
                                    <button type="button" class="btn btn-link btn-sm text-danger p-0 text-decoration-none" id="btnClearLocation">Clear</button>
                                </div>
                                <input type="range" name="maxDistance" class="form-range" min="1" max="500" step="5" value="@(ViewData["MaxDistance"] ?? 20)" id="distanceRange">
                                
                                <div id="filterMap" class="rounded-3 border mb-2 shadow-sm" style="height: 120px; z-index: 1;"></div>
                                <input type="hidden" name="latitude" id="filterLat" value="@ViewData["Latitude"]" />
                                <input type="hidden" name="longitude" id="filterLng" value="@ViewData["Longitude"]" />
                                <p class="text-muted smallest"><i class="bi bi-cursor-fill me-1"></i> Drag marker to change center</p>
                            </div>
                        </div>
                        
                        <!-- Sort (Hidden here, synced if needed or simple reset) -->
                        <input type="hidden" name="sortOrder" value="@currentSort" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill">Apply Filters</button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Reset</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Results -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 animate-fade-up delay-100" style="position: relative; z-index: 10;">
                <h2 class="fw-bold m-0">Auctions</h2>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle rounded-pill px-4" type="button" data-bs-toggle="dropdown">
                        Sort By: @(currentSort == "price_asc" ? "Price: Low to High" : currentSort == "price_desc" ? "Price: High to Low" : currentSort == "newest" ? "Newest Listed" : "Ending Soonest")
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><a class="dropdown-item" asp-route-sortOrder="" asp-route-searchTerm="@currentSearch" asp-route-categoryId="@currentCategory" asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice" asp-route-status="@status" asp-route-latitude="@ViewData["Latitude"]" asp-route-longitude="@ViewData["Longitude"]" asp-route-maxDistance="@ViewData["MaxDistance"]">Ending Soonest</a></li>
                        <li><a class="dropdown-item" asp-route-sortOrder="newest" asp-route-searchTerm="@currentSearch" asp-route-categoryId="@currentCategory" asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice" asp-route-status="@status" asp-route-latitude="@ViewData["Latitude"]" asp-route-longitude="@ViewData["Longitude"]" asp-route-maxDistance="@ViewData["MaxDistance"]">Newest Listed</a></li>
                        <li><a class="dropdown-item" asp-route-sortOrder="price_asc" asp-route-searchTerm="@currentSearch" asp-route-categoryId="@currentCategory" asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice" asp-route-status="@status" asp-route-latitude="@ViewData["Latitude"]" asp-route-longitude="@ViewData["Longitude"]" asp-route-maxDistance="@ViewData["MaxDistance"]">Price: Low to High</a></li>
                        <li><a class="dropdown-item" asp-route-sortOrder="price_desc" asp-route-searchTerm="@currentSearch" asp-route-categoryId="@currentCategory" asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice" asp-route-status="@status" asp-route-latitude="@ViewData["Latitude"]" asp-route-longitude="@ViewData["Longitude"]" asp-route-maxDistance="@ViewData["MaxDistance"]">Price: High to Low</a></li>
                    </ul>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search display-1 text-muted opacity-25"></i>
                    <h3 class="mt-3 text-muted">No auctions found</h3>
                    <p>Try adjusting your filters or search terms.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 animate-fade-up delay-200">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <partial name="_AuctionCardPartial" model="item" />
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5 d-flex justify-content-center">
                        <ul class="pagination">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link rounded-start-pill px-3" asp-route-pageNumber="@(Model.PageIndex - 1)" 
                                   asp-route-sortOrder="@currentSort" asp-route-searchTerm="@currentSearch" 
                                   asp-route-categoryId="@currentCategory" asp-route-minPrice="@minPrice" 
                                   asp-route-maxPrice="@maxPrice" asp-route-status="@status"
                                   asp-route-latitude="@ViewData["Latitude"]" asp-route-longitude="@ViewData["Longitude"]" 
                                   asp-route-maxDistance="@ViewData["MaxDistance"]">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link px-3">Page @Model.PageIndex of @Model.TotalPages</span>
                            </li>
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link rounded-end-pill px-3" asp-route-pageNumber="@(Model.PageIndex + 1)"
                                   asp-route-sortOrder="@currentSort" asp-route-searchTerm="@currentSearch"
                                   asp-route-categoryId="@currentCategory" asp-route-minPrice="@minPrice"
                                   asp-route-maxPrice="@maxPrice" asp-route-status="@status"
                                   asp-route-latitude="@ViewData["Latitude"]" asp-route-longitude="@ViewData["Longitude"]" 
                                   asp-route-maxDistance="@ViewData["MaxDistance"]">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- Location Logic ---
            const btnEnable = document.getElementById('btnEnableLocation');
            const btnClear = document.getElementById('btnClearLocation');
            const disabledUI = document.getElementById('locationDisabledUI');
            const filterUI = document.getElementById('locationFilterUI');
            const distanceRange = document.getElementById('distanceRange');
            const radiusVal = document.getElementById('radiusVal');
            const filterLat = document.getElementById('filterLat');
            const filterLng = document.getElementById('filterLng');
            
            let map, marker, circle;

            function initFilterMap(lat, lng, radius) {
                if (!map) {
                    map = L.map('filterMap', { zoomControl: false }).setView([lat, lng], 10);
                    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                        attribution: '© CARTO'
                    }).addTo(map);
                    
                    marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                    circle = L.circle([lat, lng], {
                        radius: radius * 1000,
                        color: '#4361ee',
                        fillColor: '#4361ee',
                        fillOpacity: 0.15,
                        weight: 2
                    }).addTo(map);

                    marker.on('drag', function(e) {
                        const newPos = e.target.getLatLng();
                        circle.setLatLng(newPos);
                        filterLat.value = newPos.lat.toFixed(6);
                        filterLng.value = newPos.lng.toFixed(6);
                    });
                } else {
                    map.setView([lat, lng]);
                    marker.setLatLng([lat, lng]);
                    circle.setLatLng([lat, lng]);
                    circle.setRadius(radius * 1000);
                }
            }

            btnEnable.addEventListener('click', function() {
                if (navigator.geolocation) {
                    btnEnable.disabled = true;
                    btnEnable.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Locating...';
                    
                    navigator.geolocation.getCurrentPosition(pos => {
                        const lat = pos.coords.latitude;
                        const lng = pos.coords.longitude;
                        filterLat.value = lat;
                        filterLng.value = lng;
                        
                        disabledUI.classList.add('d-none');
                        filterUI.classList.remove('d-none');
                        
                        initFilterMap(lat, lng, parseInt(distanceRange.value));
                        setTimeout(() => map.invalidateSize(), 200);
                    }, err => {
                        alert("Geolocation failed: " + err.message);
                        btnEnable.disabled = false;
                        btnEnable.innerHTML = '<i class="bi bi-geo-alt-fill me-1"></i> Use My Location';
                    });
                }
            });

            btnClear.addEventListener('click', function() {
                filterLat.value = '';
                filterLng.value = '';
                // Setting distance to null isn't directly possible on the range input, 
                // but we hide the UI so the backend won't get lat/lng.
                filterUI.classList.add('d-none');
                disabledUI.classList.remove('d-none');
                btnEnable.disabled = false;
                btnEnable.innerHTML = '<i class="bi bi-geo-alt-fill me-1"></i> Use My Location';
            });

            distanceRange.addEventListener('input', function() {
                const val = this.value;
                radiusVal.innerText = val;
                if (circle) circle.setRadius(val * 1000);
            });

            // Re-init if coming back with data
            if (filterLat.value && filterLng.value) {
                initFilterMap(parseFloat(filterLat.value), parseFloat(filterLng.value), parseInt(distanceRange.value));
            }

            // --- SignalR Logic ---
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/bidding")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceivePriceUpdate", function (auctionId, newPrice) {
                const priceElement = document.getElementById(`price-${auctionId}`);
                if (priceElement) {
                    const formattedPrice = new Intl.NumberFormat('bg-BG', { style: 'currency', currency: 'EUR' }).format(newPrice);
                    priceElement.innerText = formattedPrice;
                    priceElement.classList.add('text-success');
                    priceElement.style.transition = 'all 0.3s';
                    priceElement.style.transform = 'scale(1.1)';
                    setTimeout(() => {
                        priceElement.classList.remove('text-success');
                        priceElement.style.transform = 'scale(1)';
                    }, 1000);
                }
            });

            connection.start().catch(err => console.error(err.toString()));
        });
    </script>
}
