@model IEnumerable<AuctionHub.Application.DTOs.ChatMessageDto>
@{
    ViewData["Title"] = "Chat: " + ViewBag.OtherUserName;
    var currentUserId = ViewBag.CurrentUserId as string;
    var otherUserId = ViewBag.OtherUserId as string;
    var auctionId = ViewBag.AuctionId;
}

<div class="chat-wrapper">
    <div class="container-fluid h-100 p-0">
        <div class="row g-0 h-100">
            <!-- Sidebar / Auction Info -->
            <div class="col-lg-3 col-xl-2 d-none d-lg-block border-end bg-card chat-sidebar">
                <div class="p-4">
                    <div class="mb-4">
                        <a asp-action="Details" asp-route-id="@auctionId" class="text-decoration-none d-flex align-items-center gap-2 text-primary fw-bold mb-4">
                            <i class="bi bi-arrow-left"></i> Back to Auction
                        </a>
                        <h6 class="text-uppercase text-muted smallest fw-bold letter-spacing-1 mb-3">Item Details</h6>
                        <div class="card border-0 bg-light-custom rounded-4 p-3 mb-4 shadow-sm shadow-hover">
                            <div class="fw-bold text-main text-truncate mb-1">@ViewBag.AuctionTitle</div>
                            <div class="smallest text-muted">Auction #@auctionId</div>
                        </div>
                    </div>

                    <div>
                        <h6 class="text-uppercase text-muted smallest fw-bold letter-spacing-1 mb-3">Participants</h6>
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <div class="small fw-bold text-main text-truncate">@ViewBag.OtherUserName</div>
                                    <div class="smallest text-success">Online</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3 opacity-50">
                                <div class="avatar-sm bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person"></i>
                                </div>
                                <div>
                                    <div class="small fw-bold text-main">You</div>
                                    <div class="smallest">Joined</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Chat Area -->
            <div class="col-lg-9 col-xl-10 d-flex flex-column bg-messages-wrapper">
                <!-- Mobile Header -->
                <div class="d-lg-none bg-card border-bottom p-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <a asp-action="Details" asp-route-id="@auctionId" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-arrow-left"></i>
                        </a>
                        <div class="fw-bold text-main">@ViewBag.OtherUserName</div>
                    </div>
                    <div class="smallest text-muted">#@auctionId</div>
                </div>

                <!-- Messages -->
                <div class="flex-grow-1 overflow-auto p-4 custom-scrollbar" id="private-chat-messages">
                    <div class="text-center mb-5 mt-2 animate-fade-in">
                        <div class="badge bg-light text-muted rounded-pill px-3 py-2 border">
                            <i class="bi bi-shield-check-fill text-success me-1"></i> Secure End-to-End Chat
                        </div>
                        <p class="smallest text-muted mt-2">This conversation is linked to auction <strong>@ViewBag.AuctionTitle</strong></p>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        foreach(var msg in Model)
                        {
                            bool isMe = msg.SenderId == currentUserId;
                            <div class="message-row mb-4 @(isMe ? "me" : "other") animate-fade-in">
                                <div class="message-content">
                                    @if (!isMe)
                                    {
                                        <div class="sender-name">@msg.SenderName</div>
                                    }
                                    <div class="chat-bubble shadow-sm">
                                        @msg.Content
                                    </div>
                                    <div class="message-time">@msg.SentOn.ToLocalTime().ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div id="no-messages" class="h-100 d-flex flex-column align-items-center justify-content-center text-muted animate-fade-in">
                            <div class="bg-card shadow-sm rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-chat-dots text-primary opacity-50 fs-2"></i>
                            </div>
                            <h6 class="fw-bold text-main">No messages yet</h6>
                            <p class="smallest text-center px-4">Start the conversation about shipping or payment.</p>
                        </div>
                    }
                </div>

                <!-- Input Area -->
                <div class="p-4 bg-card border-top shadow-lg-top">
                    <form id="private-chat-form" class="max-width-1000 mx-auto">
                        <div class="input-group input-group-lg bg-light-custom rounded-pill p-1 border border-light-subtle">
                            <input type="text" id="private-chat-input" class="form-control border-0 bg-transparent px-4 py-3 shadow-none text-main" 
                                   placeholder="Message @ViewBag.OtherUserName..." required autocomplete="off" />
                            <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm hover-lift" 
                                    style="width: 54px; height: 54px; margin-left: 5px;">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-wrapper {
        height: calc(100vh - 72px); /* Subtract navbar height */
        margin-top: 72px;
        overflow: hidden;
    }

    .chat-sidebar {
        z-index: 5;
    }

    .bg-messages-wrapper {
        background-color: #f0f2f5;
    }
    [data-bs-theme="dark"] .bg-messages-wrapper {
        background-color: #0f172a;
    }
    [data-bs-theme="dark"] .chat-sidebar {
        background-color: #1e293b !important;
        border-color: rgba(255,255,255,0.05) !important;
    }
    [data-bs-theme="dark"] .bg-card {
        background-color: #1e293b !important;
    }
    [data-bs-theme="dark"] .border-top, [data-bs-theme="dark"] .border-bottom, [data-bs-theme="dark"] .border-end {
        border-color: rgba(255,255,255,0.05) !important;
    }
    [data-bs-theme="dark"] .bg-light-custom {
        background-color: rgba(255,255,255,0.02) !important;
    }

    .message-row {
        display: flex;
        width: 100%;
    }
    .message-row.me { justify-content: flex-end; }
    .message-row.other { justify-content: flex-start; }

    .message-content {
        max-width: 70%;
        display: flex;
        flex-direction: column;
    }
    .message-row.me .message-content { align-items: flex-end; }
    .message-row.other .message-content { align-items: flex-start; }

    .sender-name {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 4px;
        margin-left: 12px;
    }

    .chat-bubble {
        padding: 12px 18px;
        font-size: 0.95rem;
        line-height: 1.5;
        border-radius: 22px;
        word-wrap: break-word;
    }

    .message-row.me .chat-bubble {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-hover) 100%);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message-row.other .chat-bubble {
        background: white;
        color: #1e293b;
        border-bottom-left-radius: 4px;
    }
    [data-bs-theme="dark"] .message-row.other .chat-bubble {
        background: #1e293b;
        color: #f1f5f9;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .message-time {
        font-size: 0.65rem;
        color: #94a3b8;
        margin-top: 4px;
        margin-left: 12px;
        margin-right: 12px;
    }

    .max-width-1000 { max-width: 1000px; }
    .shadow-lg-top { box-shadow: 0 -10px 25px -5px rgba(0,0,0,0.05); }
    
    .animate-pulse { animation: pulse-green 2s infinite; }
    @@keyframes pulse-green {
        0% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.4); }
        70% { box-shadow: 0 0 0 6px rgba(25, 135, 84, 0); }
        100% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
    }

    /* Custom Scrollbar for Chat */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 10px; }
    [data-bs-theme="dark"] .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); }

    /* Fix navbar overlap */
    header .navbar { z-index: 1030 !important; }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chatMessages = document.getElementById('private-chat-messages');
            const chatForm = document.getElementById('private-chat-form');
            const chatInput = document.getElementById('private-chat-input');
            const noMessagesBox = document.getElementById('no-messages');

            const auctionId = @auctionId;
            const currentUserId = '@currentUserId';
            const otherUserId = '@otherUserId';

            const scrollToBottom = () => {
                chatMessages.scrollTop = chatMessages.scrollHeight;
            };
            scrollToBottom();

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/chat")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceivePrivateMessage", function (msg) {
                if(noMessagesBox) noMessagesBox.remove();

                const isMe = msg.senderId === currentUserId;
                const d = new Date(msg.sentOn);
                const timeStr = d.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute:'2-digit' });

                const rowClass = isMe ? 'me' : 'other';
                
                const html = `
                    <div class="message-row mb-4 ${rowClass} animate-fade-in">
                        <div class="message-content">
                            ${!isMe ? `<div class="sender-name">${msg.senderName}</div>` : ''}
                            <div class="chat-bubble shadow-sm">
                                ${msg.content}
                            </div>
                            <div class="message-time">${timeStr}</div>
                        </div>
                    </div>
                `;
                
                chatMessages.insertAdjacentHTML('beforeend', html);
                scrollToBottom();
            });

            connection.start().then(function () {
                connection.invoke("JoinPrivateChat", auctionId).catch(console.error);
            }).catch(console.error);

            chatForm.addEventListener('submit', function (e) {
                e.preventDefault();
                const text = chatInput.value.trim();
                if (text) {
                    connection.invoke("SendMessageToPrivate", auctionId, otherUserId, text).catch(console.error);
                    chatInput.value = '';
                }
            });
        });
    </script>
}
