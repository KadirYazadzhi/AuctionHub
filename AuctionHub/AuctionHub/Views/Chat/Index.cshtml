@model IEnumerable<AuctionHub.Application.DTOs.ChatMessageDto>
@using AuctionHub.Application.DTOs
@{
    var sessions = ViewBag.Sessions as List<ChatSessionDto> ?? new List<ChatSessionDto>();
    var activeChatType = ViewBag.ActiveChatType as string;
    
    // For private chat
    var auctionId = ViewBag.AuctionId as int?;
    var auctionTitle = ViewBag.AuctionTitle as string;
    var otherUserId = ViewBag.OtherUserId as string;
    var otherUserName = ViewBag.OtherUserName as string;
    var currentUserId = ViewBag.CurrentUserId as string;

    ViewData["Title"] = activeChatType == "Global" ? "Global Chat" : $"Chat with {otherUserName}";
    
    currentUserId ??= User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="chat-page-container">
    <div class="chat-main-row g-0">
        <!-- Sidebar -->
        <aside class="chat-sidebar border-end d-none d-lg-flex flex-column bg-card">
            <div class="sidebar-header p-4 border-bottom">
                <h5 class="fw-bold mb-0 text-main d-flex align-items-center">
                    <i class="bi bi-chat-square-text-fill text-primary me-2"></i>Inbox
                </h5>
            </div>
            <div class="sidebar-content flex-grow-1 overflow-auto custom-scrollbar" id="conversation-list">
                <!-- Global Chat -->
                <a asp-controller="Chat" asp-action="Index" asp-route-global="true" class="conversation-link" data-global="true">
                    <div class="conversation-item p-3 m-2 rounded-4 transition-all @(activeChatType == "Global" ? "active" : "")">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar bg-primary text-white shadow-sm">
                                <i class="bi bi-globe-americas"></i>
                            </div>
                            <div class="info overflow-hidden flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <span class="name fw-bold text-main">Global Community</span>
                                </div>
                                <div class="last-msg text-muted smallest text-truncate">Join the discussion</div>
                            </div>
                        </div>
                    </div>
                </a>

                <div id="private-conversations-container">
                    @if (sessions.Any(s => !s.IsGlobal))
                    {
                        <div class="section-label px-4 mt-3 mb-2 text-uppercase text-muted fw-bold smallest letter-spacing-2">Private Chats</div>
                        @foreach (var session in sessions.Where(s => !s.IsGlobal))
                        {
                            bool isActive = activeChatType == "Private" && auctionId == session.AuctionId && otherUserId == session.OtherUserId;
                            <a asp-controller="Chat" asp-action="Index" asp-route-auctionId="@session.AuctionId" asp-route-targetUserId="@session.OtherUserId" 
                               class="conversation-link" 
                               data-auction-id="@session.AuctionId" 
                               data-other-user-id="@session.OtherUserId">
                                <div class="conversation-item p-3 m-2 rounded-4 transition-all @(isActive ? "active shadow-sm" : "")">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar bg-light-custom text-primary border shadow-sm">
                                            @if (!string.IsNullOrEmpty(session.OtherUserAvatar))
                                            {
                                                <img src="@session.OtherUserAvatar" alt="Avatar" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-fill"></i>
                                            }
                                        </div>
                                        <div class="info overflow-hidden flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="name fw-bold text-main text-truncate">@session.OtherUserName</span>
                                                <span class="time last-msg-time">@(session.LastMessageTime > DateTime.MinValue ? session.LastMessageTime.ToLocalTime().ToString("MMM dd") : "")</span>
                                            </div>
                                            <div class="last-msg text-muted smallest text-truncate">@session.LastMessage</div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>
        </aside>

        <!-- Chat Area -->
        <section class="chat-area d-flex flex-column bg-messages-wrapper">
            @if (activeChatType != null)
            {
                <!-- Header -->
                <header class="chat-header bg-card border-bottom d-flex align-items-center justify-content-between px-4">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-light rounded-circle d-lg-none shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                            <i class="bi bi-list"></i>
                        </button>
                        
                        @if (activeChatType == "Global")
                        {
                            <div class="avatar-sm bg-primary text-white">
                                <i class="bi bi-globe-americas"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-main mb-0">Global Discussion</h6>
                                <span class="smallest text-success"><i class="bi bi-circle-fill me-1"></i>Live</span>
                            </div>
                        }
                        else
                        {
                            <div class="avatar-sm bg-light-custom text-primary border">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div class="d-flex flex-column justify-content-center">
                                <h6 class="fw-bold text-main mb-0" style="line-height: 1.2;">@otherUserName</h6>
                                <a asp-controller="Auctions" asp-action="DetailsById" asp-route-id="@auctionId" class="smallest text-primary text-decoration-none hover-underline fw-bold">
                                    <i class="bi bi-hammer me-1"></i> @auctionTitle
                                </a>
                            </div>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        @if (activeChatType == "Private")
                        {
                            <a asp-controller="Auctions" asp-action="DetailsById" asp-route-id="@auctionId" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold d-none d-sm-inline-block">
                                View Listing
                            </a>
                        }
                    </div>
                </header>

                <!-- Messages -->
                <div class="messages-container flex-grow-1 overflow-auto p-4 custom-scrollbar" id="chat-messages">
                    @if (Model != null && Model.Any())
                    {
                        foreach(var msg in Model)
                        {
                            bool isMe = msg.SenderId == currentUserId;
                            <div class="message-row @(isMe ? "me" : "other") animate-fade-in">
                                <div class="message-group">
                                    @if (!isMe)
                                    {
                                        <span class="sender-label">@msg.SenderName</span>
                                    }
                                    <div class="bubble shadow-sm">@msg.Content</div>
                                    <span class="time-label">@msg.SentOn.ToLocalTime().ToString("HH:mm")</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div id="no-messages" class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                            <div class="empty-icon-circle mb-3"><i class="bi bi-chat-dots opacity-25"></i></div>
                            <h6 class="fw-bold text-main">No messages here yet</h6>
                            <p class="smallest">Start the conversation below.</p>
                        </div>
                    }
                </div>

                <!-- Footer / Input -->
                <footer class="chat-footer">
                    <form id="chat-form" class="mx-auto" style="max-width: 850px;">
                        <div class="input-pill-wrapper shadow-lg">
                            <input type="text" id="chat-input" class="form-control" placeholder="Type your message..." required autocomplete="off" />
                            <button type="submit" class="btn btn-primary send-btn">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </form>
                </footer>
            }
            else
            {
                <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted p-5">
                    <div class="empty-state-icon mb-4"><i class="bi bi-chat-left-dots text-primary opacity-25 display-1"></i></div>
                    <h3 class="fw-bold text-main">Your Inbox</h3>
                    <p class="max-width-400 text-center">Select a conversation from the left to start messaging with sellers or buyers.</p>
                </div>
            }
        </section>
    </div>
</div>

<!-- Mobile Sidebar -->
<div class="offcanvas offcanvas-start bg-card border-0" tabindex="-1" id="mobileSidebar">
    <div class="offcanvas-header border-bottom p-4">
        <h5 class="offcanvas-title fw-bold text-main mb-0"><i class="bi bi-chat-dots-fill text-primary me-2"></i>Inbox</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-2 custom-scrollbar" id="mobile-conversation-list"></div>
</div>

<style>
    /* Structure & Layout */
    .chat-page-container {
        height: calc(100vh - 85px); 
        background-color: var(--bg-card);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .chat-main-row {
        display: flex;
        flex: 1;
        overflow: hidden;
    }
    .chat-sidebar {
        width: 350px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
    }
    .chat-area {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        height: 100%;
        background-color: #f8f9fa;
    }
    [data-bs-theme="dark"] .chat-area {
        background-color: #0f172a;
    }
    .chat-header {
        height: 75px;
        flex-shrink: 0;
        z-index: 10;
        background-color: var(--bg-card);
        display: flex;
        align-items: center;
        padding: 0 1.5rem;
    }

    /* Messenger Elements */
    .avatar, .avatar-sm {
        width: 48px; height: 48px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; overflow: hidden; flex-shrink: 0;
    }
    .avatar img, .avatar-sm img { width: 100%; height: 100%; object-fit: cover; }
    .avatar-sm { width: 44px; height: 44px; font-size: 1rem; }

    .bg-messages-wrapper {
        background-image: radial-gradient(var(--primary-color) 0.5px, transparent 0.5px);
        background-size: 30px 30px;
    }
    [data-bs-theme="dark"] .bg-messages-wrapper {
        background-image: radial-gradient(rgba(255,255,255,0.03) 0.5px, transparent 0.5px);
    }

    /* Conversations List */
    .conversation-item {
        cursor: pointer;
        border: 1px solid transparent;
        margin: 4px 12px !important;
        padding: 12px 16px !important;
    }
    .conversation-item:hover { background-color: rgba(var(--bs-primary-rgb), 0.05); }
    .conversation-item.active {
        background-color: rgba(var(--bs-primary-rgb), 0.1);
        border-color: rgba(var(--bs-primary-rgb), 0.2);
    }
    .conversation-item .name { font-size: 1rem; }
    .conversation-item .time { font-size: 0.7rem; color: #94a3b8; }

    /* Message Bubbles */
    .message-row { display: flex; width: 100%; margin-bottom: 1rem; }
    .message-row.me { justify-content: flex-end; }
    .message-row.other { justify-content: flex-start; }
    
    .message-group { max-width: 75%; display: flex; flex-direction: column; }
    .message-row.me .message-group { align-items: flex-end; }
    
    .bubble {
        padding: 10px 16px;
        border-radius: 22px;
        font-size: 1rem;
        line-height: 1.5;
    }
    .message-row.me .bubble {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-hover) 100%);
        color: white;
        border-bottom-right-radius: 4px;
        box-shadow: 0 4px 12px rgba(var(--bs-primary-rgb), 0.15);
    }
    .message-row.other .bubble {
        background: white;
        color: #1e293b;
        border-bottom-left-radius: 4px;
        border: 1px solid rgba(0,0,0,0.05);
    }
    [data-bs-theme="dark"] .message-row.other .bubble { background: #1e293b; color: #f1f5f9; border: 1px solid rgba(255,255,255,0.05); }

    .sender-label { font-size: 0.75rem; font-weight: 800; color: var(--primary-color); margin-bottom: 4px; margin-left: 14px; text-transform: uppercase; }
    .time-label { font-size: 0.65rem; color: #94a3b8; margin-top: 4px; padding: 0 14px; font-weight: 500; }

    /* Footer / Input Pill */
    .chat-footer { 
        padding: 20px 40px 30px 40px;
        background: transparent !important;
    }
    .input-pill-wrapper {
        background-color: var(--bg-card);
        border-radius: 100px;
        padding: 8px;
        display: flex;
        align-items: center;
        border: 1px solid var(--bs-border-color);
        box-shadow: 0 15px 35px rgba(0,0,0,0.08) !important;
        transition: all 0.3s ease;
    }
    .input-pill-wrapper:focus-within {
        transform: translateY(-2px);
        box-shadow: 0 20px 45px rgba(0,0,0,0.12) !important;
        border-color: var(--primary-color) !important;
    }
    .input-pill-wrapper .form-control,
    .input-pill-wrapper .form-control:focus,
    .input-pill-wrapper .form-control:active {
        background: transparent !important;
        background-color: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 12px 30px !important;
        color: var(--text-main) !important;
        font-size: 1.05rem !important;
        outline: none !important;
    }
    .send-btn {
        width: 52px; height: 52px; border-radius: 50% !important;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        margin-right: 2px;
        transition: all 0.3s ease;
    }
    .send-btn:hover {
        transform: scale(1.05) rotate(-5deg);
    }

    /* Utilities */
    .smallest { font-size: 0.75rem; }
    .letter-spacing-2 { letter-spacing: 2px; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.08); border-radius: 10px; }
    [data-bs-theme="dark"] .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.05); }

    header .navbar { z-index: 1030 !important; }
    
    [data-bs-theme="dark"] .bg-card { background-color: #1e293b !important; }
    [data-bs-theme="dark"] .border-bottom, [data-bs-theme="dark"] .border-end { border-color: rgba(255,255,255,0.05) !important; }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chatMessages = document.getElementById('chat-messages');
            const chatForm = document.getElementById('chat-form');
            const chatInput = document.getElementById('chat-input');
            const noMessagesBox = document.getElementById('no-messages');
            const conversationList = document.getElementById('conversation-list');
            const privateContainer = document.getElementById('private-conversations-container');

            const activeChatType = '@activeChatType';
            const currentUserId = '@currentUserId';
            const auctionId = @(auctionId ?? 0);
            const otherUserId = '@otherUserId';

            const scrollToBottom = () => { if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight; };
            scrollToBottom();

            // Mobile sync
            const mobileSidebarBody = document.getElementById('mobile-conversation-list');
            if(mobileSidebarBody && conversationList) mobileSidebarBody.innerHTML = conversationList.innerHTML;

            const connection = new signalR.HubConnectionBuilder().withUrl("/hubs/chat").withAutomaticReconnect().build();

            connection.on("ReceivePrivateMessage", function (msg) {
                updateSidebar(msg);
                if (activeChatType === "Private" && msg.auctionId === auctionId) {
                    if(noMessagesBox) noMessagesBox.remove();
                    appendMessage(msg);
                }
            });

            connection.on("ReceiveGlobalMessage", function (msg) {
                updateSidebar(msg);
                if (activeChatType === "Global") {
                    if(noMessagesBox) noMessagesBox.remove();
                    appendMessage(msg);
                }
            });

            function updateSidebar(msg) {
                if (msg.isGlobal) {
                    const el = document.querySelector('.conversation-link[data-global="true"]');
                    if (el) { el.querySelector('.last-msg').innerText = msg.content; conversationList.prepend(el); }
                    return;
                }
                const otherId = msg.senderId === currentUserId ? msg.receiverId : msg.senderId;
                const el = document.querySelector(`.conversation-link[data-auction-id="${msg.auctionId}"][data-other-user-id="${otherId}"]`);
                if (el) {
                    el.querySelector('.last-msg').innerText = msg.content;
                    el.querySelector('.last-msg-time').innerText = "Just now";
                    privateContainer.prepend(el);
                } else {
                    window.location.reload(); // Simplest way to fetch new session metadata
                }
            }

            function appendMessage(msg) {
                const isMe = msg.senderId === currentUserId;
                const timeStr = new Date(msg.sentOn).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
                const html = `
                    <div class="message-row ${isMe ? 'me' : 'other'} animate-fade-in">
                        <div class="message-group">
                            ${!isMe ? `<span class="sender-label">${msg.senderName}</span>` : ''}
                            <div class="bubble shadow-sm">${msg.content}</div>
                            <span class="time-label">${timeStr}</span>
                        </div>
                    </div>`;
                chatMessages.insertAdjacentHTML('beforeend', html);
                scrollToBottom();
            }

            connection.start().then(() => {
                if (activeChatType === "Global") connection.invoke("JoinGlobalChat");
                else if (activeChatType === "Private") connection.invoke("JoinPrivateChat", auctionId);
            });

            if (chatForm) {
                chatForm.addEventListener('submit', e => {
                    e.preventDefault();
                    const text = chatInput.value.trim();
                    if (text) {
                        if (activeChatType === "Global") connection.invoke("SendMessageToGlobal", text);
                        else connection.invoke("SendMessageToPrivate", auctionId, otherUserId, text);
                        chatInput.value = '';
                    }
                });
            }
        });
    </script>
}