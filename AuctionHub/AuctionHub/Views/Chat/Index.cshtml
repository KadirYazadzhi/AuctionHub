@model IEnumerable<AuctionHub.Application.DTOs.ChatMessageDto>
@using AuctionHub.Application.DTOs
@{
    var sessions = ViewBag.Sessions as List<ChatSessionDto> ?? new List<ChatSessionDto>();
    var activeChatType = ViewBag.ActiveChatType as string;
    
    // For private chat
    var auctionId = ViewBag.AuctionId as int?;
    var auctionTitle = ViewBag.AuctionTitle as string;
    var otherUserId = ViewBag.OtherUserId as string;
    var otherUserName = ViewBag.OtherUserName as string;
    var currentUserId = ViewBag.CurrentUserId as string;

    ViewData["Title"] = activeChatType == "Global" ? "Global Chat" : $"Chat with {otherUserName}";
    
    // Use the current user's ID from Claims if not explicitly passed
    currentUserId ??= User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="chat-wrapper">
    <div class="container-fluid h-100 p-0">
        <div class="row g-0 h-100">
            <!-- Sidebar / Conversations List -->
            <div class="col-lg-4 col-xl-3 d-none d-lg-flex flex-column border-end bg-card chat-sidebar">
                <div class="p-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-main"><i class="bi bi-chat-dots-fill text-primary me-2"></i>Messages</h5>
                </div>
                <div class="flex-grow-1 overflow-auto custom-scrollbar p-2">
                    <!-- Global Chat Session -->
                    <a asp-controller="Chat" asp-action="Index" asp-route-global="true" class="text-decoration-none">
                        <div class="p-3 rounded-4 mb-2 transition-all hover-light-custom @(activeChatType == "Global" ? "bg-primary-subtle border-primary" : "border-transparent") border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-md bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                                    <i class="bi bi-globe-americas fs-4"></i>
                                </div>
                                <div class="overflow-hidden flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-main mb-0 text-truncate">Global Chat</h6>
                                    </div>
                                    <div class="smallest text-muted text-truncate">Join the community discussion</div>
                                </div>
                            </div>
                        </div>
                    </a>

                    @if (sessions.Any(s => !s.IsGlobal))
                    {
                        <h6 class="text-uppercase text-muted smallest fw-bold letter-spacing-1 mt-4 mb-3 px-2">Private Conversations</h6>
                        @foreach (var session in sessions.Where(s => !s.IsGlobal))
                        {
                            bool isActive = activeChatType == "Private" && auctionId == session.AuctionId && otherUserId == session.OtherUserId;
                            <a asp-controller="Chat" asp-action="Index" asp-route-auctionId="@session.AuctionId" asp-route-targetUserId="@session.OtherUserId" class="text-decoration-none">
                                <div class="p-3 rounded-4 mb-2 transition-all hover-light-custom @(isActive ? "bg-primary-subtle border-primary" : "border-transparent") border">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-md bg-light-custom text-primary rounded-circle d-flex align-items-center justify-content-center border shadow-sm" style="width: 48px; height: 48px; overflow: hidden;">
                                            @if (!string.IsNullOrEmpty(session.OtherUserAvatar))
                                            {
                                                <img src="@session.OtherUserAvatar" class="w-100 h-100 object-fit-cover" alt="Avatar" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-fill fs-4"></i>
                                            }
                                        </div>
                                        <div class="overflow-hidden flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <h6 class="fw-bold text-main mb-0 text-truncate">@session.OtherUserName</h6>
                                                <small class="text-muted" style="font-size: 0.65rem;">@(session.LastMessageTime > DateTime.MinValue ? session.LastMessageTime.ToLocalTime().ToString("MMM dd") : "")</small>
                                            </div>
                                            <div class="smallest text-muted text-truncate">
                                                <i class="bi bi-hammer text-primary me-1"></i> @session.AuctionTitle
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>

            <!-- Main Chat Area -->
            <div class="col-lg-8 col-xl-9 d-flex flex-column bg-messages-wrapper">
                @if (activeChatType != null)
                {
                    <!-- Chat Header -->
                    <div class="bg-card border-bottom p-3 px-4 d-flex align-items-center justify-content-between shadow-sm z-1">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-lg-none">
                                <button class="btn btn-light rounded-circle p-0 d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                                    <i class="bi bi-list"></i>
                                </button>
                            </div>
                            @if (activeChatType == "Global")
                            {
                                <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-globe-americas"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-main mb-0">Global Chat</h5>
                                    <span class="smallest text-success"><i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i>Online</span>
                                </div>
                            }
                            else
                            {
                                <div class="avatar-sm bg-light-custom text-primary rounded-circle d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-main mb-0">@otherUserName</h5>
                                    <a asp-controller="Auctions" asp-action="Details" asp-route-id="@auctionId" class="smallest text-primary text-decoration-none hover-underline">
                                        <i class="bi bi-link-45deg"></i> @auctionTitle
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Messages -->
                    <div class="flex-grow-1 overflow-auto p-4 custom-scrollbar position-relative" id="chat-messages">
                        @if (activeChatType == "Private")
                        {
                            <div class="text-center mb-5 mt-2 animate-fade-in">
                                <div class="badge bg-light text-muted rounded-pill px-3 py-2 border">
                                    <i class="bi bi-shield-check-fill text-success me-1"></i> Secure End-to-End Chat
                                </div>
                            </div>
                        }

                        @if (Model != null && Model.Any())
                        {
                            foreach(var msg in Model)
                            {
                                bool isMe = msg.SenderId == currentUserId;
                                <div class="message-row mb-4 @(isMe ? "me" : "other") animate-fade-in">
                                    <div class="message-content">
                                        @if (!isMe)
                                        {
                                            <div class="sender-name">@msg.SenderName</div>
                                        }
                                        <div class="chat-bubble shadow-sm">
                                            @msg.Content
                                        </div>
                                        <div class="message-time">@msg.SentOn.ToLocalTime().ToString("HH:mm")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div id="no-messages" class="h-100 d-flex flex-column align-items-center justify-content-center text-muted animate-fade-in">
                                <div class="bg-card shadow-sm rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                    <i class="bi bi-chat-dots text-primary opacity-50 fs-2"></i>
                                </div>
                                <h6 class="fw-bold text-main">No messages yet</h6>
                                <p class="smallest text-center px-4">Start the conversation!</p>
                            </div>
                        }
                    </div>

                    <!-- Input Area -->
                    <div class="p-3 bg-card border-top shadow-lg-top">
                        <form id="chat-form" class="max-width-1000 mx-auto">
                            <div class="input-group input-group-lg bg-light-custom rounded-pill p-1 border border-light-subtle">
                                <input type="text" id="chat-input" class="form-control border-0 bg-transparent px-4 py-2 shadow-none text-main fs-6" 
                                       placeholder="Type a message..." required autocomplete="off" />
                                <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm hover-lift" 
                                        style="width: 44px; height: 44px; margin-left: 5px;">
                                    <i class="bi bi-send-fill"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                        <i class="bi bi-chat-square-text text-primary opacity-25 display-1 mb-3"></i>
                        <h4 class="fw-bold">Select a conversation</h4>
                        <p>Choose a chat from the sidebar to start messaging.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Mobile Sidebar Offcanvas -->
<div class="offcanvas offcanvas-start bg-card border-0" tabindex="-1" id="mobileSidebar" style="width: 300px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold text-main"><i class="bi bi-chat-dots-fill text-primary me-2"></i>Messages</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-2 custom-scrollbar">
        <!-- Exact copy of sidebar content, normally you'd use a Partial View -->
        <a asp-controller="Chat" asp-action="Index" asp-route-global="true" class="text-decoration-none">
            <div class="p-3 rounded-4 mb-2 transition-all @(activeChatType == "Global" ? "bg-primary-subtle border-primary" : "border-transparent") border">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-md bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                        <i class="bi bi-globe-americas fs-4"></i>
                    </div>
                    <div class="overflow-hidden flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 class="fw-bold text-main mb-0 text-truncate">Global Chat</h6>
                        </div>
                    </div>
                </div>
            </div>
        </a>

        @if (sessions.Any(s => !s.IsGlobal))
        {
            <h6 class="text-uppercase text-muted smallest fw-bold letter-spacing-1 mt-4 mb-3 px-2">Private Conversations</h6>
            @foreach (var session in sessions.Where(s => !s.IsGlobal))
            {
                bool isActive = activeChatType == "Private" && auctionId == session.AuctionId && otherUserId == session.OtherUserId;
                <a asp-controller="Chat" asp-action="Index" asp-route-auctionId="@session.AuctionId" asp-route-targetUserId="@session.OtherUserId" class="text-decoration-none">
                    <div class="p-3 rounded-4 mb-2 transition-all @(isActive ? "bg-primary-subtle border-primary" : "border-transparent") border">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-md bg-light-custom text-primary rounded-circle d-flex align-items-center justify-content-center border shadow-sm" style="width: 48px; height: 48px;">
                                <i class="bi bi-person-fill fs-4"></i>
                            </div>
                            <div class="overflow-hidden flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="fw-bold text-main mb-0 text-truncate">@session.OtherUserName</h6>
                                </div>
                                <div class="smallest text-muted text-truncate">
                                    @session.AuctionTitle
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            }
        }
    </div>
</div>

<style>
    .chat-wrapper {
        height: calc(100vh - 72px); /* Subtract navbar height */
        margin-top: 72px;
        overflow: hidden;
    }

    .chat-sidebar {
        z-index: 5;
    }

    .bg-messages-wrapper {
        background-color: #f0f2f5;
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%234361ee' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    [data-bs-theme="dark"] .bg-messages-wrapper {
        background-color: #0f172a;
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .message-row {
        display: flex;
        width: 100%;
    }
    .message-row.me { justify-content: flex-end; }
    .message-row.other { justify-content: flex-start; }

    .message-content {
        max-width: 75%;
        display: flex;
        flex-direction: column;
    }
    .message-row.me .message-content { align-items: flex-end; }
    .message-row.other .message-content { align-items: flex-start; }

    .sender-name {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 4px;
        margin-left: 12px;
    }

    .chat-bubble {
        padding: 10px 16px;
        font-size: 0.95rem;
        line-height: 1.5;
        border-radius: 20px;
        word-wrap: break-word;
    }

    .message-row.me .chat-bubble {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-hover) 100%);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message-row.other .chat-bubble {
        background: white;
        color: #1e293b;
        border-bottom-left-radius: 4px;
    }
    [data-bs-theme="dark"] .message-row.other .chat-bubble {
        background: #1e293b;
        color: #f1f5f9;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .message-time {
        font-size: 0.65rem;
        color: #94a3b8;
        margin-top: 4px;
        margin-left: 12px;
        margin-right: 12px;
    }

    .hover-light-custom:hover { background-color: rgba(var(--bs-primary-rgb), 0.05) !important; }
    .bg-primary-subtle { background-color: rgba(var(--bs-primary-rgb), 0.1) !important; }
    
    .max-width-1000 { max-width: 1000px; }
    .shadow-lg-top { box-shadow: 0 -5px 15px rgba(0,0,0,0.03); }
    [data-bs-theme="dark"] .shadow-lg-top { box-shadow: 0 -5px 15px rgba(0,0,0,0.2); }
    
    .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 10px; }
    [data-bs-theme="dark"] .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); }

    /* Fix navbar overlap */
    header .navbar { z-index: 1030 !important; }
    
    [data-bs-theme="dark"] .bg-card { background-color: #1e293b !important; border-color: rgba(255,255,255,0.05) !important;}
    [data-bs-theme="dark"] .border-bottom, [data-bs-theme="dark"] .border-end { border-color: rgba(255,255,255,0.05) !important; }
    [data-bs-theme="dark"] .bg-light-custom { background-color: rgba(255,255,255,0.02) !important; }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chatMessages = document.getElementById('chat-messages');
            const chatForm = document.getElementById('chat-form');
            const chatInput = document.getElementById('chat-input');
            const noMessagesBox = document.getElementById('no-messages');

            const activeChatType = '@activeChatType';
            if (!activeChatType) return;

            const currentUserId = '@currentUserId';
            
            // For Private Chat
            const auctionId = @(auctionId ?? 0);
            const otherUserId = '@otherUserId';

            const scrollToBottom = () => {
                if (chatMessages) {
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }
            };
            scrollToBottom();

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/chat")
                .withAutomaticReconnect()
                .build();

            // Handle Private Messages
            connection.on("ReceivePrivateMessage", function (msg) {
                if (activeChatType !== "Private" || msg.auctionId !== auctionId) return; // Ignore if not in this chat
                
                if(noMessagesBox) noMessagesBox.remove();
                appendMessage(msg);
            });

            // Handle Global Messages
            connection.on("ReceiveGlobalMessage", function (msg) {
                if (activeChatType !== "Global") return; // Ignore if not in global chat
                
                if(noMessagesBox) noMessagesBox.remove();
                appendMessage(msg);
            });

            function appendMessage(msg) {
                const isMe = msg.senderId === currentUserId;
                const d = new Date(msg.sentOn);
                const timeStr = d.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute:'2-digit' });
                const rowClass = isMe ? 'me' : 'other';
                
                const html = `
                    <div class="message-row mb-4 ${rowClass} animate-fade-in">
                        <div class="message-content">
                            ${!isMe ? `<div class="sender-name">${msg.senderName}</div>` : ''}
                            <div class="chat-bubble shadow-sm">
                                ${msg.content}
                            </div>
                            <div class="message-time">${timeStr}</div>
                        </div>
                    </div>
                `;
                
                chatMessages.insertAdjacentHTML('beforeend', html);
                scrollToBottom();
            }

            connection.start().then(function () {
                if (activeChatType === "Global") {
                    connection.invoke("JoinGlobalChat").catch(console.error);
                } else if (activeChatType === "Private") {
                    connection.invoke("JoinPrivateChat", auctionId).catch(console.error);
                }
            }).catch(console.error);

            if (chatForm) {
                chatForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const text = chatInput.value.trim();
                    if (text) {
                        if (activeChatType === "Global") {
                            connection.invoke("SendMessageToGlobal", text).catch(console.error);
                        } else {
                            connection.invoke("SendMessageToPrivate", auctionId, otherUserId, text).catch(console.error);
                        }
                        chatInput.value = '';
                    }
                });
            }
        });
    </script>
}