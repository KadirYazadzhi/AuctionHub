<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - AuctionHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
<header>
    <nav class="navbar navbar-expand-lg fixed-top bg-white border-bottom shadow-sm">
        <div class="container">
            <a class="navbar-brand text-primary fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-hammer me-2"></i>AuctionHub
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <i class="bi bi-list fs-1 text-dark"></i>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-3 mb-lg-0 text-center">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-area="" asp-controller="Auctions" asp-action="Index">Explore</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-area="" asp-controller="Chat" asp-action="Index">Messages</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-area="" asp-controller="Home" asp-action="About">About</a>
                    </li>
                </ul>
                
                <div class="navbar-actions d-flex flex-column flex-lg-row align-items-center gap-3">
                    
                    <div class="d-flex align-items-center justify-content-center gap-4 gap-lg-3">
                        <button class="btn btn-link nav-link p-0" id="themeToggler" type="button">
                            <i class="bi bi-sun-fill fs-5" id="themeIcon"></i>
                        </button>
                        
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a class="btn btn-link nav-link position-relative p-0" asp-area="" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                <i class="bi bi-bell-fill fs-5"></i>
                                <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.6rem;">0</span>
                            </a>
                        }
                    </div>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a class="btn btn-primary rounded-pill px-4 w-100 w-lg-auto order-first order-lg-0" asp-area="" asp-controller="Auctions" asp-action="Create">
                            <i class="bi bi-plus-lg me-1"></i> Sell Item
                        </a>
                        
                        <div class="w-100 text-center w-lg-auto text-lg-start">
                            <partial name="_LoginPartial" />
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column flex-lg-row gap-2 w-100 w-lg-auto mt-2 mt-lg-0">
                            <a class="btn btn-outline-primary rounded-pill px-4" asp-area="Identity" asp-page="/Account/Login">Log In</a>
                            <a class="btn btn-primary rounded-pill px-4" asp-area="Identity" asp-page="/Account/Register">Get Started</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="flex-grow-1">
    @RenderBody()
</main>

<footer>
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-4">
                <a class="footer-brand text-primary text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-hammer me-2"></i>AuctionHub
                </a>
                <p class="text-muted-custom mb-4">
                    The premium destination for unique treasures and rare finds. Join thousands of collectors and sellers today.
                </p>
                <div class="d-flex gap-3">
                    <a href="#" class="btn btn-outline-secondary social-icon"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="btn btn-outline-secondary social-icon"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="btn btn-outline-secondary social-icon"><i class="bi bi-instagram"></i></a>
                </div>
            </div>
            
            <div class="col-6 col-lg-2">
                <h6 class="footer-heading">Platform</h6>
                <a asp-area="" asp-controller="Auctions" asp-action="Index" class="footer-link">Browse Auctions</a>
                <a asp-area="" asp-controller="Auctions" asp-action="Index" class="footer-link">Trending</a>
                <a asp-area="" asp-controller="Auctions" asp-action="Create" class="footer-link">Sell an Item</a>
            </div>
            
            <div class="col-6 col-lg-2">
                <h6 class="footer-heading">Support</h6>
                <a asp-area="" asp-controller="Home" asp-action="HelpCenter" class="footer-link">Help Center</a>
                <a asp-area="" asp-controller="Home" asp-action="TrustAndSafety" class="footer-link">Trust & Safety</a>
                <a asp-area="" asp-controller="Home" asp-action="SellingTips" class="footer-link">Selling Tips</a>
            </div>
            
            <div class="col-lg-4">
                <h6 class="footer-heading">Stay Updated</h6>
                <p class="text-muted-custom small mb-3">Subscribe to our newsletter for the latest drops.</p>
                <form class="d-flex gap-2" asp-area="" asp-controller="Home" asp-action="Subscribe" method="post">
                    <input type="email" name="email" class="form-control" placeholder="Email address" required>
                    <button class="btn btn-primary px-3" type="submit">Go</button>
                </form>
            </div>
        </div>
        
        <div class="border-top mt-5 pt-4 d-flex flex-column flex-md-row justify-content-between align-items-center">
            <p class="text-muted-custom small mb-0">
                &copy; 2026 AuctionHub. Built by:
                <a class="text-primary" href="https://kadiryazadzhi.me" target="_blank" style="text-decoration: none; color: inherit;">
                    Kadir Yazadzhi
                </a>
            </p>
            <div class="d-flex gap-4 mt-3 mt-md-0">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted-custom small text-decoration-none">Privacy Policy</a>
                <a asp-area="" asp-controller="Home" asp-action="TermsOfService" class="text-muted-custom small text-decoration-none">Terms of Service</a>
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    const toggler = document.getElementById('themeToggler');
    const icon = document.getElementById('themeIcon');
    
    function updateIcon(theme) {
        icon.className = theme === 'dark' ? 'bi bi-moon-stars-fill' : 'bi bi-sun-fill';
    }

    toggler.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-bs-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        
        document.documentElement.setAttribute('data-bs-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        updateIcon(newTheme);
    });

    updateIcon(document.documentElement.getAttribute('data-bs-theme'));

    // Notification Polling
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <text>
        async function checkNotifications() {
            try {
                const response = await fetch('/Notifications/GetUnreadCount');
                if (response.ok) {
                    const count = await response.json();
                    const badge = document.getElementById('notificationBadge');
                    if (count > 0) {
                        badge.innerText = count > 99 ? '99+' : count;
                        badge.classList.remove('d-none');
                    } else {
                        badge.classList.add('d-none');
                    }
                }
            } catch (e) { console.error(e); }
        }
        
        // Check immediately and then every 60 seconds
        checkNotifications();
        setInterval(checkNotifications, 60000);
        </text>
    }

    // Auto-hide alert messages after 5 seconds
    document.addEventListener('DOMContentLoaded', function () {
        setTimeout(function () {
            const alerts = document.querySelectorAll('.alert:not(.alert-permanent)');
            alerts.forEach(function (alert) {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    });

    // Real-time Global Notifications (SignalR)
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <text>
        const globalConnection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/bidding")
            .withAutomaticReconnect()
            .build();

        globalConnection.on("ReceiveOutbidNotification", function (auctionId, auctionTitle, newPrice) {
            showToast("Outbid Alert!", `Someone bid <strong>${newPrice}€</strong> on "${auctionTitle}". You're no longer the highest bidder!`, `/Auctions/Details/${auctionId}`, "bi-exclamation-triangle-fill", "bg-danger");
            checkNotifications(); // Refresh badge
        });

        globalConnection.on("ReceiveNewBid", function (auctionId, bidder, amount) {
            // Optional: Show toast for seller when someone bids
            // Only if current user is the owner (this check would happen server-side usually)
        });

        globalConnection.start().catch(err => console.error(err.toString()));

        function showToast(title, message, link, icon = "bi-bell-fill", bgColor = "bg-primary") {
            const container = document.getElementById('toast-container');
            const toastId = 'toast-' + Date.now();
            const html = `
                <div id="${toastId}" class="toast border-0 shadow-lg rounded-4 overflow-hidden" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="toast-header ${bgColor} text-white border-0 py-3 px-4">
                        <i class="bi ${icon} me-2"></i>
                        <strong class="me-auto">${title}</strong>
                        <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body p-4">
                        <p class="mb-3 text-main">${message}</p>
                        <div class="d-grid">
                            <a href="${link}" class="btn btn-primary rounded-pill py-2 fw-bold shadow-sm">View Auction</a>
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);
            const element = document.getElementById(toastId);
            const toast = new bootstrap.Toast(element, { delay: 10000 });
            toast.show();
            
            element.addEventListener('hidden.bs.toast', () => element.remove());
        }
        </text>
    }
</script>

<!-- Global Toast Container -->
<div id="toast-container" class="toast-container position-fixed bottom-0 start-0 p-4" style="z-index: 2000;"></div>

<!-- Global Action Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-primary" id="confirmModalLabel">Confirm Action</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 pt-3">
                <p id="confirmModalBody" class="mb-0 text-muted fs-6" style="line-height: 1.6;">Are you sure you want to proceed with this action?</p>
            </div>
            <div class="modal-footer border-0 p-4 pt-0 gap-2">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmModalBtn" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Global Confirmation Logic
    document.addEventListener('DOMContentLoaded', function() {
        let currentFormToSubmit = null;
        const confirmModal = new bootstrap.Modal(document.getElementById('confirmModal'));
        const modalBody = document.getElementById('confirmModalBody');
        const confirmBtn = document.getElementById('confirmModalBtn');

        window.showConfirm = function(message, form) {
            currentFormToSubmit = form;
            modalBody.innerHTML = message;
            confirmModal.show();
            return false;
        };

        confirmBtn.addEventListener('click', function() {
            if (currentFormToSubmit) {
                currentFormToSubmit.submit();
            }
            confirmModal.hide();
        });
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
