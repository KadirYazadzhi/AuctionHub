@using System.Security.Claims
@model AuctionHub.Models.ViewModels.AuctionListViewModel

@{
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    bool isOwner = Model.SellerId == currentUserId;
}

<div class="col">
    <div class="card h-100 border-0 shadow-sm rounded-4 position-relative @(Model.IsPromoted ? "border-promoted" : "")">
        @if (Model.IsPromoted)
        {
            <div class="position-absolute top-0 end-0 m-3 z-1">
                <span class="badge bg-warning text-dark shadow-sm rounded-pill px-3 py-2 animate-pulse-gold">
                    <i class="bi bi-megaphone-fill me-1"></i> PROMOTED
                </span>
            </div>
        }
        <div class="position-absolute top-0 start-0 m-3 z-1 d-flex flex-column gap-2">
            <a asp-controller="Auctions" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="badge bg-white text-dark shadow-sm rounded-pill px-3 py-2 text-decoration-none">
                <i class="bi bi-tag-fill text-primary me-1"></i> @Model.Category
            </a>
            
            @if (User.Identity?.IsAuthenticated == true && !isOwner && Model.IsWinning.HasValue)
            {
                if (Model.IsWinning.Value)
                {
                    <span class="badge bg-success shadow-sm rounded-pill px-3 py-2">
                        <i class="bi bi-trophy-fill me-1"></i> Winning
                    </span>
                }
                else
                {
                    <span class="badge bg-danger shadow-sm rounded-pill px-3 py-2">
                        <i class="bi bi-arrow-down-circle-fill me-1"></i> Outbid
                    </span>
                }
            }
            
            @if (Model.IsSuspended)
            {
                <span class="badge bg-danger shadow-sm rounded-pill px-3 py-2">
                    <i class="bi bi-slash-circle me-1"></i> Suspended
                </span>
            }
        </div>
        
        <div class="overflow-hidden rounded-top-4" style="height: 220px; cursor: pointer;" onclick="window.location.href='@Url.Action("Details", "Auctions", new { id = Model.Id })'">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/400x300?text=No+Image" : Model.ImageUrl)" 
                 class="card-img-top h-100 w-100 object-fit-cover transition-transform" 
                 alt="@Model.Title">
        </div>
        
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-2">
                <small class="text-muted me-2">Seller:</small>
                <a asp-controller="Auctions" asp-action="UserAuctions" asp-route-username="@Model.SellerName" class="text-decoration-none small fw-bold text-dark hover-primary">
                    @Model.SellerName
                </a>
                @if (Model.IsTopSeller)
                {
                    <i class="bi bi-patch-check-fill text-warning ms-1 shadow-sm" title="Top Rated Seller"></i>
                }
            </div>
            <h5 class="card-title fw-bold mb-3 text-truncate">@Model.Title</h5>
            
            <div class="d-flex justify-content-between align-items-end mb-3">
                <div>
                    <small class="text-muted d-block mb-1">Current Bid</small>
                    <span class="h3 fw-bolder text-primary mb-0 price-value">@Model.CurrentPrice.ToString("C")</span>
                </div>
                <div class="text-end">
                    <small class="text-muted d-block mb-1">Ends in</small>
                    <span class="badge @(Model.EndTime < DateTime.Now.AddHours(24) ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") rounded-pill px-3">
                        <i class="bi bi-clock-fill me-1"></i> @Model.TimeRemaining
                    </span>
                </div>
            </div>
            
            <div class="d-grid mt-4 gap-2">
                <a asp-controller="Auctions" asp-action="Details" asp-route-id="@Model.Id" 
                   class="btn @(isOwner ? "btn-outline-primary" : "btn-primary") rounded-pill py-2 fw-bold">
                   @if (isOwner)
                   {
                       <text><i class="bi bi-eye-fill me-2"></i> View My Listing</text>
                   }
                   else
                   {
                       <text>Place Bid <i class="bi bi-arrow-right ms-2"></i></text>
                   }
                </a>
                
                @if (User.Identity?.IsAuthenticated == true && isOwner && !Model.IsPromoted && Model.IsActive)
                {
                    <form asp-controller="Auctions" asp-action="Promote" method="post" class="d-grid" onsubmit="return showConfirm('Promote this auction for <strong>5.00€</strong>? It will appear at the top of all searches.', this);">
                        <input type="hidden" name="auctionId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill py-2 fw-bold">
                            <i class="bi bi-megaphone me-1"></i> Boost Listing
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .transition-transform {
        transition: transform 0.5s ease;
    }
    .card:hover .transition-transform {
        transform: scale(1.1);
    }
    
    /* Ensure outline button hovers to the correct primary color */
    .btn-outline-primary:hover {
        background-color: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        color: white !important;
    }
</style>
