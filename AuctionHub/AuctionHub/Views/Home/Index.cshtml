@model IEnumerable<AuctionHub.Application.DTOs.ChatMessageDto>
@using Microsoft.AspNetCore.Identity
@using AuctionHub.Domain.Models
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Welcome";
    var currentUser = await UserManager.GetUserAsync(User);
}

<!-- Hero Section -->
<section class="hero-section text-center position-relative overflow-hidden pt-5 pb-5 mt-0 mb-5" style="padding-top: 130px !important;">
    <div class="container position-relative z-2">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <span class="badge bg-primary-subtle text-primary mb-4 px-4 py-2 rounded-pill animate-fade-up">
                    <i class="bi bi-stars me-1"></i> New: Vintage Collection Live
                </span>
                <h1 class="hero-title mb-5 animate-fade-up delay-100">
                    Discover Extraordinary <br> <span class="text-primary">Items & Stories</span>
                </h1>
                <p class="hero-subtitle mx-auto mb-5 animate-fade-up delay-200">
                    The premier marketplace for collectors and enthusiasts. 
                    Bid on exclusive items, rare antiques, and modern treasures in real-time.
                </p>
                <div class="d-flex justify-content-center gap-3 animate-fade-up delay-300">
                    <a asp-controller="Auctions" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-lg hover-lift">
                        Start Exploring
                    </a>
                    <a asp-controller="Auctions" asp-action="Create" class="btn btn-outline-primary btn-lg rounded-pill px-5 py-3 hover-lift">
                        Sell Item
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Floating Elements (Decorative) -->
        <div class="d-none d-lg-block position-absolute top-50 start-0 translate-middle-y ms-5 opacity-50 animate-fade-up delay-300" style="z-index: -1;">
            <div class="card p-4 shadow-soft transform-rotate-n6" style="width: 220px; transform: rotate(-6deg);">
                <div class="bg-light rounded mb-3" style="height: 140px;"></div>
                <small class="fw-bold">Vintage Camera</small>
                <div class="text-primary fw-bold small">€450.00</div>
            </div>
        </div>
        
        <div class="d-none d-lg-block position-absolute top-50 end-0 translate-middle-y me-5 opacity-50 animate-fade-up delay-300" style="z-index: -1;">
             <div class="card p-4 shadow-soft" style="width: 220px; transform: rotate(6deg);">
                <div class="bg-light rounded mb-3" style="height: 140px;"></div>
                <small class="fw-bold">Rare Coin 1890</small>
                <div class="text-primary fw-bold small">€1,200.00</div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-6">
    <div class="container py-4">
        <div class="row text-center g-4 align-items-center">
            <!-- Inactive Stat Card 1 -->
            <div class="col-md-4 animate-fade-up delay-100">
                <div class="stat-card card h-100 border-0 shadow-sm rounded-5 bg-white py-5 transition-all">
                    <div class="card-body">
                        <h2 class="fw-bold display-5 text-primary mb-2 transition-all">10k+</h2>
                        <p class="text-muted mb-0 fw-medium transition-all">Active Auctions</p>
                    </div>
                </div>
            </div>
            <!-- Center Active Card -->
            <div class="col-md-4 animate-fade-up delay-200">
                <div class="stat-card card h-100 border-0 shadow-sm rounded-5 bg-white py-5 transition-all">
                    <div class="card-body">
                        <h2 class="fw-bold display-5 text-primary mb-2 transition-all">€2M+</h2>
                        <p class="text-muted mb-0 fw-medium transition-all">Daily Volume</p>
                    </div>
                </div>
            </div>
            <!-- Side Card Right -->
            <div class="col-md-4 animate-fade-up delay-300">
                <div class="stat-card card h-100 border-0 shadow-sm rounded-5 bg-white py-5 transition-all">
                    <div class="card-body">
                        <h2 class="fw-bold display-5 text-primary mb-2 transition-all">50k+</h2>
                        <p class="text-muted mb-0 fw-medium transition-all">Verified Users</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Us Preview Section -->
<section class="py-6 my-5">
    <div class="container">
        <!-- Section Header -->
        <div class="text-center mb-5 animate-fade-up">
            <span class="badge bg-primary-subtle text-primary mb-3 px-4 py-2 rounded-pill fw-bold">Our Journey</span>
            <h2 class="fw-bold mb-3 display-5">A Legacy of <span class="text-primary">Excellence</span></h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">Learn more about the mission and history behind AuctionHub.</p>
        </div>

        <div class="row align-items-center g-5">
            <!-- Left: Description Text -->
            <div class="col-lg-6 animate-fade-up delay-100">
                <h3 class="fw-bold mb-4">Empowering Collectors Worldwide</h3>
                <p class="text-muted mb-4" style="line-height: 1.8;">
                    AuctionHub was born from a passion for preserving history and connecting enthusiasts with rare finds. 
                    What started as a small community of collectors has grown into a leading digital marketplace where
                    stories are traded as much as items. We believe that every object has a unique journey, and our mission is to ensure 
                    those journeys continue in the right hands. By leveraging cutting-edge technology and secure financial systems, we provide
                    a safe harbor for the most extraordinary treasures.
                </p>
                <p class="text-muted mb-5" style="line-height: 1.8;">
                    Today, thousands of users trust our platform for its transparency, real-time engagement, and unwavering commitment to security. Whether you are a seasoned bidder or a first-time seller, we are here to support every step of your auction experience.
                </p>
                <a asp-action="About" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-sm hover-lift">
                    Read Full Story <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>

            <!-- Right: Illustration -->
            <div class="col-lg-6">
                <div class="p-5 text-center">
                    <img src="~/images/about-us.svg" class="img-fluid animate-fade-up" style="max-height: 500px;" alt="About Us" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Preview -->
<section class="py-6 my-5">
    <div class="container">
        <div class="text-center mb-5 animate-fade-up">
            <span class="badge bg-primary-subtle text-primary mb-3 px-4 py-2 rounded-pill fw-bold">Explore</span>
            <h2 class="fw-bold mb-3 display-5">Browse by <span class="text-primary">Category</span></h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">Find exactly what you're looking for by browsing our curated collections.</p>
        </div>
        
        <div class="row g-4">
            <!-- Electronics -->
            <div class="col-6 col-md-3 animate-fade-up delay-100">
                <a asp-controller="Auctions" asp-action="Index" asp-route-categoryId="1" class="category-card card h-100 text-decoration-none border-0 shadow-sm rounded-5 bg-white text-center py-5 transition-all">
                    <div class="card-body">
                        <div class="icon-box bg-primary-subtle text-primary rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center transition-all" style="width: 70px; height: 70px;">
                            <i class="bi bi-laptop fs-2"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1 transition-all">Electronics</h5>
                        <small class="text-muted transition-all">340+ items</small>
                    </div>
                </a>
            </div>
            
            <!-- Art -->
            <div class="col-6 col-md-3 animate-fade-up delay-200">
                <a asp-controller="Auctions" asp-action="Index" asp-route-categoryId="2" class="category-card card h-100 text-decoration-none border-0 shadow-sm rounded-5 bg-white text-center py-5 transition-all">
                    <div class="card-body">
                        <div class="icon-box bg-success-subtle text-success rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center transition-all" style="width: 70px; height: 70px;">
                            <i class="bi bi-palette fs-2"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1 transition-all">Art & Design</h5>
                        <small class="text-muted transition-all">120+ items</small>
                    </div>
                </a>
            </div>
            
            <!-- Antiques -->
            <div class="col-6 col-md-3 animate-fade-up delay-300">
                <a asp-controller="Auctions" asp-action="Index" asp-route-categoryId="3" class="category-card card h-100 text-decoration-none border-0 shadow-sm rounded-5 bg-white text-center py-5 transition-all">
                    <div class="card-body">
                        <div class="icon-box bg-warning-subtle text-warning rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center transition-all" style="width: 70px; height: 70px;">
                            <i class="bi bi-hourglass-split fs-2"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1 transition-all">Antiques</h5>
                        <small class="text-muted transition-all">85+ items</small>
                    </div>
                </a>
            </div>
            
            <!-- Vehicles -->
            <div class="col-6 col-md-3 animate-fade-up delay-300">
                <a asp-controller="Auctions" asp-action="Index" asp-route-categoryId="4" class="category-card card h-100 text-decoration-none border-0 shadow-sm rounded-5 bg-white text-center py-5 transition-all">
                    <div class="card-body">
                        <div class="icon-box bg-danger-subtle text-danger rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center transition-all" style="width: 70px; height: 70px;">
                            <i class="bi bi-car-front fs-2"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1 transition-all">Vehicles</h5>
                        <small class="text-muted transition-all">50+ items</small>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="py-5 my-5">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="p-5 text-center">
                    <img src="~/images/how-it-work.svg" class="img-fluid animate-fade-up" style="max-height: 400px;" alt="How it works" />
                </div>
            </div>
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4">How it works</h2>
                
                <div class="d-flex mb-4">
                    <div class="step-circle bg-primary text-white">1</div>
                    <div class="ms-3">
                        <h5 class="fw-bold">Create an Account</h5>
                        <p class="text-muted">Sign up in seconds and verify your identity to ensure a safe marketplace.</p>
                    </div>
                </div>
                
                <div class="d-flex mb-4">
                    <div class="step-circle bg-primary text-white">2</div>
                    <div class="ms-3">
                        <h5 class="fw-bold">Place Your Bid</h5>
                        <p class="text-muted">Find items you love and place a bid. We'll notify you if you're outbid.</p>
                    </div>
                </div>
                
                <div class="d-flex">
                    <div class="step-circle bg-primary text-white">3</div>
                    <div class="ms-3">
                        <h5 class="fw-bold">Win & Pay Securely</h5>
                        <p class="text-muted">If you win, pay securely through our escrow system and track your delivery.</p>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="py-6 my-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left Column: FAQ -->
            <div class="col-lg-6 animate-fade-up">
                <div class="pe-lg-5">
                    <h2 class="fw-bold mb-4 display-5">Questions? <span class="text-primary">We have answers.</span></h2>
                    <p class="text-muted mb-5">Everything you need to know about the platform and our secure bidding process.</p>
                    
                    <div class="accordion" id="homeFaq">
                        <!-- Q1 -->
                        <div class="accordion-item border-0 bg-white shadow-sm rounded-4 mb-3 overflow-hidden">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-4 px-4 fw-bold bg-white shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#q1">
                                    Is it safe to bid on AuctionHub?
                                </button>
                            </h2>
                            <div id="q1" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                                <div class="accordion-body p-4 pt-0 text-muted border-0">
                                    Yes, absolutely. We use a secure escrow system where your funds are held safely until the transaction is verified. Every user is verified to ensure a trustworthy community.
                                </div>
                            </div>
                        </div>

                        <!-- Q2 -->
                        <div class="accordion-item border-0 bg-white shadow-sm rounded-4 mb-3 overflow-hidden">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-4 px-4 fw-bold bg-white shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#q2">
                                    How do I get my money back if I'm outbid?
                                </button>
                            </h2>
                            <div id="q2" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                                <div class="accordion-body p-4 pt-0 text-muted border-0">
                                    The system handles this automatically. The moment another user places a higher bid, the full amount of your previous bid is instantly credited back to your AuctionHub wallet.
                                </div>
                            </div>
                        </div>

                        <!-- Q3 -->
                        <div class="accordion-item border-0 bg-white shadow-sm rounded-4 mb-3 overflow-hidden">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-4 px-4 fw-bold bg-white shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#q3">
                                    Can I cancel a bid after placing it?
                                </button>
                            </h2>
                            <div id="q3" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                                <div class="accordion-body p-4 pt-0 text-muted border-0">
                                    In order to maintain the integrity of the auctions, bids are legally binding and cannot be canceled once placed. We encourage users to bid responsibly.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Image -->
            <div class="col-lg-6">
                <div class="p-5 text-center">
                    <img src="~/images/home-section-faq.svg" class="img-fluid animate-fade-up" style="max-height: 450px;" alt="FAQ" />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .transition-all { transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }
    .letter-spacing-1 { letter-spacing: 1px; }
    
    /* Stat Cards Logic */
    .stat-card {
        background-color: transparent;
        border-radius: 2rem;
        cursor: pointer;
    }
    .stat-card.active {
        transform: translateY(-15px);
        box-shadow: 0 1rem 3rem rgba(67, 97, 238, 0.25) !important;
    }
    .stat-card:not(.active):hover {
        background-color: var(--bs-primary) !important;
        border-color: var(--bs-primary) !important;
        transform: translateY(-15px);
        box-shadow: 0 1rem 3rem rgba(67, 97, 238, 0.2) !important;
    }
    .stat-card:not(.active):hover h2, 
    .stat-card:not(.active):hover p {
        color: white !important;
    }

    /* Category Cards Logic */
    .category-card:hover {
        background-color: var(--bs-primary) !important;
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(67, 97, 238, 0.15) !important;
    }
    .category-card:hover h5, 
    .category-card:hover small {
        color: white !important;
    }
    .category-card:hover .icon-box {
        background-color: white !important;
        color: var(--bs-primary) !important;
        transform: scale(1.1);
    }

    /* FAQ Refined Styles */
    .accordion-button::after {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%234361ee'%3e%3cpath fill-rule='evenodd' d='M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2z'/%3e%3c/svg%3e") !important;
        background-size: 1.5rem;
        width: 1.5rem;
        height: 1.5rem;
        transition: transform 0.3s ease;
    }
    .accordion-button:not(.collapsed)::after {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%234361ee'%3e%3cpath fill-rule='evenodd' d='M2 8a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11A.5.5 0 0 1 2 8z'/%3e%3c/svg%3e") !important;
        transform: rotate(180deg);
    }
    .accordion-button:not(.collapsed) {
        color: var(--bs-primary);
    }
</style>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Global Chat Container -->
    <div id="global-chat-container" class="position-fixed" style="bottom: 25px; right: 25px; z-index: 1060; display: flex; flex-direction: column; align-items: flex-end;">
        
        <!-- Chat Window -->
        <div id="global-chat-window" class="rounded-4 bg-white d-flex flex-column mb-3 border-0 overflow-hidden" 
             style="width: 380px; height: 520px; opacity: 0; pointer-events: none; transform: translateY(30px) scale(0.9); transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); transform-origin: bottom right; box-shadow: 0 10px 50px rgba(0,0,0,0.1);">
             
            <!-- Header -->
            <div class="bg-primary bg-gradient text-white p-3 d-flex justify-content-between align-items-center shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative">
                        <div class="chat-icon-wrapper bg-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; transition: all 0.3s ease;">
                            <i class="bi bi-chat-dots-fill text-primary fs-5 chat-header-icon" style="transition: all 0.3s ease;"></i>
                        </div>
                        <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-2 border-white rounded-circle animate-pulse"></span>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">Global Community</h6>
                        <small class="opacity-75" style="font-size: 0.75rem;"><i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem;"></i> Live Chat</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="global-chat-expand" class="btn btn-link text-white p-0 opacity-75 hover-opacity-100 transition-all" title="Toggle Focus Mode">
                        <i class="bi bi-arrows-angle-expand fs-6" id="expand-icon"></i>
                    </button>
                    <button type="button" class="btn btn-link text-white p-0 opacity-75 hover-opacity-100 transition-all" onclick="document.getElementById('global-chat-toggle').click()">
                        <i class="bi bi-dash-lg fs-4"></i>
                    </button>
                </div>
            </div>

            <!-- Messages Area -->
            <div id="global-chat-messages" class="flex-grow-1 p-3 overflow-auto custom-scrollbar bg-white">
                @if (Model != null)
                {
                    foreach (var msg in Model)
                    {
                        bool isMe = currentUser != null && msg.SenderId == currentUser.Id;
                        <div class="mb-3 d-flex flex-column @(isMe ? "align-items-end" : "align-items-start") animate-fade-in">
                            <div class="d-flex align-items-center gap-2 mb-1 px-1">
                                @if (!isMe)
                                {
                                    <small class="fw-bold text-primary" style="font-size: 0.75rem;">@msg.SenderName</small>
                                }
                                <small class="text-body-secondary" style="font-size: 0.65rem;">@msg.SentOn.ToLocalTime().ToString("HH:mm")</small>
                            </div>
                            <div class="chat-bubble p-3 @(isMe ? "chat-bubble-me" : "chat-bubble-other") shadow-sm" style="max-width: 85%; word-wrap: break-word; font-size: 0.9rem;">
                                @msg.Content
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Input Area -->
            <div id="chat-input-area" class="p-3 border-top" style="background-color: #f8f9fa;">
                <form id="global-chat-form" class="d-flex gap-2">
                    <div class="flex-grow-1 position-relative">
                        <input type="text" id="global-chat-input" class="form-control rounded-pill border-0 bg-white px-4 py-2 shadow-sm" 
                               placeholder="Say something nice..." required autocomplete="off" style="font-size: 0.95rem;" />
                    </div>
                    <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm hover-scale transition-all" 
                            style="width: 42px; height: 42px; min-width: 42px;">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>
            </div>
        </div>
        
        <!-- FAB -->
        <button id="global-chat-toggle" class="btn btn-primary btn-lg rounded-circle shadow-lg d-flex align-items-center justify-content-center position-relative hover-lift transition-all" 
                style="width: 65px; height: 65px; z-index: 1061;">
            <i class="bi bi-chat-dots-fill text-white fs-2" id="chat-icon-open"></i>
            <i class="bi bi-x-lg text-white fs-2 d-none" id="chat-icon-close"></i>
            <span id="chat-badge" class="position-absolute top-0 start-100 translate-middle p-2 bg-danger border border-2 border-white rounded-circle d-none"></span>
        </button>
    </div>

    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(var(--bs-primary-rgb), 0.2); border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(var(--bs-primary-rgb), 0.4); }

        .chat-bubble {
            border-radius: 18px;
            line-height: 1.4;
            transition: transform 0.2s ease;
        }
        .chat-bubble:hover { transform: scale(1.02); }
        
        .chat-bubble-me {
            background: linear-gradient(135deg, var(--bs-primary) 0%, #3a56d4 100%);
            color: white;
            border-bottom-right-radius: 4px;
        }
        
        .chat-bubble-other {
            background: #f0f2f5;
            color: #1c1e21;
            border-bottom-left-radius: 4px;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .animate-pulse { animation: pulse-green 2s infinite; }
        @@keyframes pulse-green {
            0% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7); }
            70% { box-shadow: 0 0 0 6px rgba(25, 135, 84, 0); }
            100% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
        }

        .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .hover-scale:hover { transform: scale(1.1); }
        .hover-lift:hover { transform: translateY(-5px); }
        .hover-opacity-100:hover { opacity: 1 !important; }

        /* Focus Mode (Expanded) */
        #global-chat-window.focused {
            width: 80vw !important;
            height: 80vh !important;
            max-width: 1000px;
            bottom: 50% !important;
            right: 50% !important;
            transform: translate(50%, 50%) !important;
            z-index: 1070;
        }

        /* Responsive Focus Mode */
        @@media (max-width: 768px) {
            #global-chat-window.focused {
                width: 95vw !important;
                height: 90vh !important;
            }
        }
        
        /* Dark Mode Overrides */
        [data-bs-theme="dark"] #global-chat-window {
            background-color: #1a1d20 !important;
            box-shadow: 0 15px 50px rgba(0,0,0,0.4) !important;
        }
        [data-bs-theme="dark"] #global-chat-messages {
            background-color: #1a1d20 !important;
        }
        [data-bs-theme="dark"] #chat-input-area {
            background-color: #212529 !important;
            border-color: #2d3238 !important;
        }
        [data-bs-theme="dark"] .chat-header-icon {
            color: #fff !important;
        }
        [data-bs-theme="dark"] .chat-icon-wrapper {
            background-color: rgba(255,255,255,0.15) !important;
        }
        [data-bs-theme="dark"] .chat-bubble-other {
            background: #2b3035;
            color: #e4e6eb;
            border-color: #373b3e;
        }
        [data-bs-theme="dark"] #global-chat-input {
            background-color: #2b3035 !important;
            color: #fff !important;
        }
    </style>

    <!-- SignalR Script for Global Chat -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chatToggle = document.getElementById('global-chat-toggle');
            const chatExpand = document.getElementById('global-chat-expand');
            const expandIcon = document.getElementById('expand-icon');
            const chatWindow = document.getElementById('global-chat-window');
            const chatMessages = document.getElementById('global-chat-messages');
            const chatForm = document.getElementById('global-chat-form');
            const chatInput = document.getElementById('global-chat-input');
            const iconOpen = document.getElementById('chat-icon-open');
            const iconClose = document.getElementById('chat-icon-close');
            const chatBadge = document.getElementById('chat-badge');
            
            let isOpen = false;
            let isFocused = false;
            chatMessages.scrollTop = chatMessages.scrollHeight;

            chatToggle.addEventListener('click', () => {
                isOpen = !isOpen;
                if (isOpen) {
                    chatWindow.style.opacity = '1';
                    chatWindow.style.pointerEvents = 'auto';
                    if(!isFocused) {
                        chatWindow.style.transform = 'translateY(0) scale(1)';
                    } else {
                        chatWindow.style.transform = 'translate(50%, 50%) scale(1)';
                    }
                    iconOpen.classList.add('d-none');
                    iconClose.classList.remove('d-none');
                    chatBadge.classList.add('d-none');
                    setTimeout(() => chatInput.focus(), 400);
                } else {
                    chatWindow.style.opacity = '0';
                    chatWindow.style.pointerEvents = 'none';
                    if(!isFocused) {
                        chatWindow.style.transform = 'translateY(30px) scale(0.9)';
                    } else {
                        chatWindow.style.transform = 'translate(50%, 50%) scale(0.9)';
                        isFocused = false;
                        chatWindow.classList.remove('focused');
                        expandIcon.className = 'bi bi-arrows-angle-expand fs-6';
                    }
                    iconOpen.classList.remove('d-none');
                    iconClose.classList.add('d-none');
                }
            });

            chatExpand.addEventListener('click', (e) => {
                e.stopPropagation();
                isFocused = !isFocused;
                if(isFocused) {
                    chatWindow.classList.add('focused');
                    expandIcon.className = 'bi bi-arrows-angle-contract fs-6';
                    // Center the window in expanded state
                    chatWindow.style.transform = 'translate(50%, 50%) scale(1)';
                } else {
                    chatWindow.classList.remove('focused');
                    expandIcon.className = 'bi bi-arrows-angle-expand fs-6';
                    chatWindow.style.transform = 'translateY(0) scale(1)';
                }
                setTimeout(scrollToBottom, 300);
            });

            const scrollToBottom = () => {
                chatMessages.scrollTop = chatMessages.scrollHeight;
            };

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/chat")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveGlobalMessage", function (msg) {
                const isMe = msg.senderId === '@currentUser?.Id';
                const timeStr = new Date(msg.sentOn).toLocaleTimeString([], { hour: '2-digit', minute:'2-digit' });

                const msgHtml = `
                    <div class="mb-3 d-flex flex-column ${isMe ? 'align-items-end' : 'align-items-start'} animate-fade-in">
                        <div class="d-flex align-items-center gap-2 mb-1 px-1">
                            ${!isMe ? `<small class="fw-bold text-primary" style="font-size: 0.75rem;">${msg.senderName}</small>` : ''}
                            <small class="text-body-secondary" style="font-size: 0.65rem;">${timeStr}</small>
                        </div>
                        <div class="chat-bubble p-3 ${isMe ? 'chat-bubble-me' : 'chat-bubble-other'} shadow-sm" style="max-width: 85%; word-wrap: break-word; font-size: 0.9rem;">
                            ${msg.content}
                        </div>
                    </div>
                `;
                
                chatMessages.insertAdjacentHTML('beforeend', msgHtml);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                if(!isOpen) {
                    chatToggle.classList.add('animate-bounce');
                    setTimeout(() => chatToggle.classList.remove('animate-bounce'), 1000);
                    chatBadge.classList.remove('d-none');
                }
            });

            connection.start()
                .then(() => connection.invoke("JoinGlobalChat"))
                .catch(err => console.error("SignalR Connection Error: ", err));

            chatForm.addEventListener('submit', function (e) {
                e.preventDefault();
                const text = chatInput.value.trim();
                if (text) {
                    connection.invoke("SendMessageToGlobal", text).catch(err => console.error(err));
                    chatInput.value = '';
                }
            });
        });
    </script>
}
}