@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center text-center">
        <div class="col-lg-10 col-xl-8">
            <div class="error-container p-5 rounded-5 shadow-lg bg-white border border-light-subtle animate-fade-up">
                <div class="position-relative mb-5 pt-4">
                    <div class="display-1 fw-black text-primary opacity-10 position-absolute top-50 start-50 translate-middle w-100" style="font-size: clamp(8rem, 20vw, 15rem); z-index: 0;">404</div>
                    <div class="floating-icon position-relative z-1">
                        <i class="bi bi-hammer text-primary" style="font-size: 6rem;"></i>
                    </div>
                </div>
                
                <h1 class="fw-bold mb-3 text-dark mt-4">Going, going... gone!</h1>
                <p class="text-muted fs-5 mb-5 mx-auto" style="max-width: 600px;">The auction page you are looking for has been sold, moved, or never entered the bidding floor.</p>
                
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-sm hover-lift">
                        <i class="bi bi-house-door-fill me-2"></i> Back to Home
                    </a>
                    <a asp-controller="Auctions" asp-action="Index" class="btn btn-outline-primary rounded-pill px-5 py-3 fw-bold hover-lift">
                        Explore Auctions <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black { font-weight: 900; }
    .max-width-500 { max-width: 500px; }
    .min-vh-75 { min-height: 75vh; }
    
    .floating-icon {
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0) rotate(-10deg); }
        50% { transform: translateY(-20px) rotate(10deg); }
    }

    [data-bs-theme="dark"] .bg-card {
        background-color: #1e293b !important;
        border-color: rgba(255,255,255,0.05) !important;
    }
</style>
