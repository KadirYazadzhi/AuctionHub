@model AuctionHub.Domain.Models.PaginatedList<AuctionHub.Application.DTOs.TransactionDto>
@{
    ViewData["Title"] = "Global Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-up">
    <div>
        <h2 class="fw-bold mb-1">Transaction Log</h2>
        <p class="text-muted">Real-time financial activity (Page @Model.PageIndex of @Model.TotalPages).</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-5 overflow-hidden animate-fade-up delay-100">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 border-0 py-3">User</th>
                        <th class="border-0 py-3">Type</th>
                        <th class="border-0 py-3">Description</th>
                        <th class="border-0 py-3">Date</th>
                        <th class="border-0 py-3 text-end pe-4">Amount</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-xs bg-primary-subtle text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <span class="fw-bold">@t.User</span>
                                </div>
                            </td>
                            <td>
                                @switch (t.TransactionType)
                                {
                                    case "Deposit": <span class="badge bg-success-subtle text-success border rounded-pill px-3">Deposit</span> break;
                                    case "Refund": <span class="badge bg-info-subtle text-info border rounded-pill px-3">Refund</span> break;
                                    case "OfferRefund": <span class="badge bg-info-subtle text-info border rounded-pill px-3">Offer Refund</span> break;
                                    case "AdminBonus": <span class="badge bg-primary-subtle text-primary border rounded-pill px-3"><i class="bi bi-shield-fill-check me-1"></i> Admin Bonus</span> break;
                                    case "AdminRefund": <span class="badge bg-primary-subtle text-primary border rounded-pill px-3"><i class="bi bi-shield-fill-check me-1"></i> Admin Refund</span> break;
                                    case "AdminPenalty": <span class="badge bg-danger text-white border rounded-pill px-3"><i class="bi bi-shield-fill-exclamation me-1"></i> Admin Penalty</span> break;
                                    case "Bid": <span class="badge bg-warning-subtle text-warning border rounded-pill px-3">Bid</span> break;
                                    case "Purchase": <span class="badge bg-dark text-white border rounded-pill px-3">Purchase</span> break;
                                    case "OfferHold": <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3">Offer Hold</span> break;
                                    case "Withdrawal": <span class="badge bg-danger-subtle text-danger border rounded-pill px-3">Withdrawal</span> break;
                                    default: <span class="badge bg-light text-dark border rounded-pill px-3">@t.TransactionType</span> break;
                                }
                            </td>
                            <td class="text-muted small">@t.Description</td>
                            <td class="text-muted small">@t.TransactionDate.ToLocalTime().ToString("g")</td>
                            @{
                                bool isPositive = t.TransactionType == "Deposit" || t.TransactionType == "Refund" || t.TransactionType == "OfferRefund" || t.TransactionType == "AdminBonus" || t.TransactionType == "AdminRefund" || t.TransactionType == "Sale";
                            }
                            <td class="text-end pe-4 fw-bold @(isPositive ? "text-success" : "text-danger")">
                                @(isPositive ? "+" : "-")@t.Amount.ToString("C")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-4">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link rounded-pill border-0 shadow-sm me-2" 
                           asp-action="Index" 
                           asp-route-page="@(Model.PageIndex - 1)">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>
                    
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == 1 || i == Model.TotalPages || (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2))
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link rounded-circle border-0 shadow-sm mx-1 @(i == Model.PageIndex ? "" : "bg-light text-dark")" 
                                   asp-action="Index" 
                                   asp-route-page="@i"
                                   style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">@i</a>
                            </li>
                        }
                        else if (i == Model.PageIndex - 3 || i == Model.PageIndex + 3)
                        {
                            <li class="page-item disabled"><span class="page-link border-0 bg-transparent text-muted">...</span></li>
                        }
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link rounded-pill border-0 shadow-sm ms-2" 
                           asp-action="Index" 
                           asp-route-page="@(Model.PageIndex + 1)">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
