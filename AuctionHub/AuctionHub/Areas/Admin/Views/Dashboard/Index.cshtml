@using AuctionHub.Application.Interfaces
@using AuctionHub.Domain.Models
@{
    ViewData["Title"] = "System Dashboard";
    var stats = ViewBag.Stats as AdminDashboardStatsDto;
    var recentLogs = ViewBag.RecentLogs as List<AuditLog>;
    var suspiciousActivities = ViewBag.SuspiciousActivities as List<SuspiciousActivityDto>;
}

<div class="d-flex justify-content-between align-items-center mb-5 animate-fade-up">
    <div>
        <h2 class="fw-bold mb-1 text-dark">Dashboard</h2>
        <p class="text-muted mb-0">Overview of platform performance and activity.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 border border-success border-opacity-25 d-flex align-items-center">
            <span class="spinner-grow spinner-grow-sm me-2" role="status"></span>
            System Live
        </span>
    </div>
</div>

<!-- Simple Professional Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-primary border-5">
            <div class="card-body p-4">
                <small class="text-muted text-uppercase fw-bold smallest letter-spacing-1 d-block mb-2">Total Revenue</small>
                <h3 class="fw-bold mb-0 text-dark">@stats?.TotalRevenue.ToString("C0")</h3>
                <small class="text-success fw-medium">From promotions</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-warning border-5">
            <div class="card-body p-4">
                <small class="text-muted text-uppercase fw-bold smallest letter-spacing-1 d-block mb-2">Escrow Held</small>
                <h3 class="fw-bold mb-0 text-dark">@stats?.ActiveEscrowAmount.ToString("C0")</h3>
                <small class="text-muted">Safe-guarded funds</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-success border-5">
            <div class="card-body p-4">
                <small class="text-muted text-uppercase fw-bold smallest letter-spacing-1 d-block mb-2">Active Users</small>
                <h3 class="fw-bold mb-0 text-dark">@stats?.ActiveUsersCount</h3>
                <small class="text-muted">Member community</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-info border-5">
            <div class="card-body p-4">
                <small class="text-muted text-uppercase fw-bold smallest letter-spacing-1 d-block mb-2">Auctions</small>
                <h3 class="fw-bold mb-0 text-dark">@stats?.TotalAuctionsCount</h3>
                <small class="text-muted">Lifetime listings</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Main Charts / Stats -->
    <div class="col-lg-8">
        <!-- Fraud Detection (Moved here for prominence) -->
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
            <div class="card-header bg-white border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0 text-danger"><i class="bi bi-shield-exclamation me-2"></i>Fraud Monitoring</h5>
            </div>
            <div class="card-body p-4">
                @if (suspiciousActivities != null && suspiciousActivities.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var activity in suspiciousActivities)
                        {
                            <div class="list-group-item px-0 border-0 d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <div class="fw-bold text-dark small">@activity.Type</div>
                                    <div class="smallest text-muted">@activity.Description</div>
                                </div>
                                <span class="badge @(activity.Severity == "High" ? "bg-danger" : "bg-warning") rounded-pill">@activity.Severity</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-2 d-flex align-items-center text-success small">
                        <i class="bi bi-check-circle-fill me-2"></i> No security anomalies detected.
                    </div>
                }
            </div>
        </div>

        <!-- Audit Log Table -->
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-white border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">System Activity</h5>
                <a asp-controller="Settings" asp-action="AuditLogs" class="btn btn-sm btn-light rounded-pill px-3">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 border-0 smallest text-muted text-uppercase">Admin</th>
                                <th class="border-0 smallest text-muted text-uppercase">Action</th>
                                <th class="border-0 smallest text-muted text-uppercase text-end pe-4">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in recentLogs ?? new())
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-bold small text-dark">@log.Admin.DisplayName</span>
                                    </td>
                                    <td>
                                        <div class="small text-dark">@log.Action</div>
                                        <div class="smallest text-muted text-truncate" style="max-width: 250px;">@log.Details</div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <small class="text-muted">@log.Timestamp.ToString("HH:mm")</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Quick Actions -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h5 class="fw-bold mb-4">Global Announcement</h5>
            <form asp-action="SendAnnouncement" method="post">
                <div class="mb-3">
                    <textarea name="message" class="form-control bg-light border-0 rounded-4 p-3 small" rows="3" placeholder="Push alert to all users..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm">
                    Send Notification
                </button>
            </form>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold mb-4">Top Categories</h5>
            @foreach (var cat in stats?.TopCategories ?? new())
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small fw-bold text-dark">@cat.Name</span>
                    <span class="badge bg-light text-dark rounded-pill">@cat.BidCount bids</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .smallest { font-size: 0.7rem; }
    .letter-spacing-1 { letter-spacing: 1px; }
    /* Dark Mode Overrides for Admin Content */
    [data-bs-theme="dark"] .bg-white { background-color: var(--bg-card) !important; }
    [data-bs-theme="dark"] .text-dark { color: var(--text-main) !important; }
    [data-bs-theme="dark"] .bg-light { background-color: rgba(255,255,255,0.05) !important; }
</style>
