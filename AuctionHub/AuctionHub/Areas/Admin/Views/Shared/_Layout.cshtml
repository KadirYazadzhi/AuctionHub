@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                <div class="card-body p-0">
                    <div class="p-4 border-bottom text-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-shield-lock-fill fs-4"></i>
                        </div>
                        <h6 class="fw-bold mb-0 text-dark">Console</h6>
                    </div>
                    
                    <div class="list-group list-group-flush border-0 py-2">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" 
                           class="list-group-item list-group-item-action border-0 px-4 py-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active-admin-link" : "admin-nav-link")">
                            <i class="bi bi-grid-1x2-fill me-3"></i> Dashboard
                        </a>
                        <a asp-area="Admin" asp-controller="Auctions" asp-action="Index" 
                           class="list-group-item list-group-item-action border-0 px-4 py-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Auctions" ? "active-admin-link" : "admin-nav-link")">
                            <i class="bi bi-hammer me-3"></i> Auctions
                        </a>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index" 
                           class="list-group-item list-group-item-action border-0 px-4 py-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active-admin-link" : "admin-nav-link")">
                            <i class="bi bi-people-fill me-3"></i> Users
                        </a>
                        <a asp-area="Admin" asp-controller="Transactions" asp-action="Index" 
                           class="list-group-item list-group-item-action border-0 px-4 py-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active-admin-link" : "admin-nav-link")">
                            <i class="bi bi-cash-stack me-3"></i> Transactions
                        </a>
                        <a asp-area="Admin" asp-controller="Reports" asp-action="Index" 
                           class="list-group-item list-group-item-action border-0 px-4 py-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active-admin-link" : "admin-nav-link")">
                            <i class="bi bi-flag-fill me-3"></i> Reports
                        </a>
                        <a asp-area="Admin" asp-controller="Messages" asp-action="Index" 
                           class="list-group-item list-group-item-action border-0 px-4 py-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Messages" ? "active-admin-link" : "admin-nav-link")">
                            <i class="bi bi-inbox-fill me-3"></i> Inbox
                        </a>
                        <a asp-area="Admin" asp-controller="Settings" asp-action="Index" 
                           class="list-group-item list-group-item-action border-0 px-4 py-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active-admin-link" : "admin-nav-link")">
                            <i class="bi bi-gear-fill me-3"></i> Settings
                        </a>
                    </div>
                    
                    <div class="p-4 border-top">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-light w-100 rounded-pill border fw-bold small">
                            <i class="bi bi-arrow-left me-2"></i> Exit Admin
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Admin Content -->
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 min-vh-100 bg-white">
                <div class="card-body p-4 p-lg-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-pill shadow-sm border-0 px-4 py-3 mb-4 animate-fade-up" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-pill shadow-sm border-0 px-4 py-3 mb-4 animate-fade-up" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .active-admin-link {
        background-color: rgba(var(--bs-primary-rgb), 0.15) !important;
        color: var(--bs-primary) !important;
        font-weight: 700 !important;
        border-left: 4px solid var(--bs-primary) !important;
    }
</style>

@section Scripts {
    @RenderSection("Scripts", required: false)
}

@section Modals {
    @RenderSection("Modals", required: false)
}
