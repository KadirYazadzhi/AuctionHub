@model IEnumerable<AuctionHub.Domain.Models.SystemSetting>
@{
    ViewData["Title"] = "System Settings";
    bool isMaintenance = ViewBag.IsMaintenanceMode ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-5 animate-fade-up">
    <div>
        <h2 class="fw-bold mb-1">System Configuration</h2>
        <p class="text-muted mb-0">Manage global platform parameters and rules.</p>
    </div>
    <a asp-action="AuditLogs" class="btn btn-outline-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-journal-text me-1"></i> Audit Logs
    </a>
</div>

<div class="row g-4">
    <!-- Settings Table -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-5 bg-card overflow-hidden animate-fade-up delay-100">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="border: none !important;">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th class="ps-4 border-0 py-3 text-muted small text-uppercase fw-bold">Parameter</th>
                                <th class="border-0 py-3 text-muted small text-uppercase fw-bold">Value</th>
                                <th class="border-0 py-3 text-end pe-4 text-muted small text-uppercase fw-bold">Action</th>
                            </tr>
                        </thead>
                        <tbody class="border-0">
                            @foreach (var setting in Model.Where(s => s.Key != "MaintenanceMode"))
                            {
                                <tr style="border: none !important;">
                                    <td class="ps-4 py-4 border-0">
                                        <span class="fw-bold text-main">@setting.Key</span>
                                        <div class="text-muted smallest">@setting.Description</div>
                                    </td>
                                    <td class="border-0">
                                        <span class="badge rounded-pill px-3 py-2 bg-primary-subtle text-primary fw-bold">
                                            @setting.Value
                                        </span>
                                    </td>
                                    <td class="text-end pe-4 border-0">
                                        <button class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm" 
                                                onclick="openEditModal('@setting.Key', '@setting.Value', '@setting.Description')">
                                            Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- System Utilities -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-5 bg-card p-4 animate-fade-up delay-200">
            <h5 class="fw-bold mb-4 d-flex align-items-center">
                <i class="bi bi-cpu text-primary me-2"></i> System Tools
            </h5>
            
            <!-- Maintenance Mode -->
            <div class="mb-4 p-3 rounded-4 @(isMaintenance ? "bg-danger-subtle" : "bg-light-subtle") border transition-all">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold small @(isMaintenance ? "text-danger" : "text-dark")">Maintenance Mode</span>
                    <div class="form-check form-switch m-0">
                        <form asp-action="ToggleMaintenance" method="post" id="maintenanceForm">
                            <input class="form-check-input" type="checkbox" role="switch" @(isMaintenance ? "checked" : "") onchange="document.getElementById('maintenanceForm').submit()">
                        </form>
                    </div>
                </div>
                <p class="smallest text-muted mb-0">When enabled, only administrators can access the platform.</p>
            </div>

            <!-- Cache Management -->
            <div class="mb-4">
                <form asp-action="ClearCache" method="post">
                    <button type="submit" class="btn btn-light border w-100 rounded-pill py-2 fw-bold small shadow-sm hover-primary transition-all">
                        <i class="bi bi-trash3 me-2 text-danger"></i> Clear System Cache
                    </button>
                </form>
                <p class="smallest text-muted mt-2 text-center">Forces refresh of categories and stats.</p>
            </div>

            <!-- Data Export -->
            <div class="mb-2">
                <a asp-action="DownloadReport" class="btn btn-light border w-100 rounded-pill py-2 fw-bold small shadow-sm hover-primary transition-all">
                    <i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i> Export Transactions (CSV)
                </a>
                <p class="smallest text-muted mt-2 text-center">Downloads a full financial activity log.</p>
            </div>
        </div>
    </div>
</div>

<!-- Simple Edit Modal -->
<div class="modal fade" id="editSettingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-5">
            <div class="modal-header border-0 pt-4 px-4">
                <h5 class="modal-title fw-bold">Update Setting</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Update" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-muted fw-bold">PARAMETER</label>
                        <input type="text" name="key" id="modalKey" class="form-control rounded-4 border-0 bg-light fw-bold" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted fw-bold">NEW VALUE</label>
                        <input type="text" name="value" id="modalValue" class="form-control rounded-4 px-3 py-2 border shadow-none" required />
                        <div id="modalHelp" class="form-text smallest text-primary mt-2"></div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .table > :not(caption) > * > * {
        border-bottom-width: 0 !important;
        box-shadow: none !important;
    }
    
    .bg-light-subtle { background-color: rgba(var(--bs-light-rgb), 0.5) !important; }
    .bg-danger-subtle { background-color: rgba(var(--bs-danger-rgb), 0.1) !important; }
    [data-bs-theme="dark"] .bg-card { background-color: #1e293b !important; }
    
    .hover-primary:hover {
        background-color: var(--bs-primary) !important;
        color: white !important;
        border-color: var(--bs-primary) !important;
    }
    .hover-primary:hover i { color: white !important; }
    
    .transition-all { transition: all 0.3s ease; }
</style>

@section Scripts {
    <script>
        function openEditModal(key, value, description) {
            document.getElementById('modalKey').value = key;
            document.getElementById('modalValue').value = value;
            document.getElementById('modalHelp').innerText = description;
            
            const modal = new bootstrap.Modal(document.getElementById('editSettingModal'));
            modal.show();
        }
    </script>
}
