@model AuctionHub.Domain.Models.PaginatedList<AuctionHub.Domain.Models.UserReport>
@{
    ViewData["Title"] = "User Reports";
}

<div class="d-flex justify-content-between align-items-center mb-5 animate-fade-up">
    <div>
        <h2 class="fw-bold mb-1">User Reports</h2>
        <p class="text-muted mb-0">Manage user complaints and flag suspicious activity.</p>
    </div>
    <div class="btn-group rounded-pill overflow-hidden shadow-sm">
        <a asp-action="Index" asp-route-includeResolved="false" class="btn @(!(bool)ViewBag.IncludeResolved ? "btn-primary" : "btn-light") px-4">Pending</a>
        <a asp-action="Index" asp-route-includeResolved="true" class="btn @((bool)ViewBag.IncludeResolved ? "btn-primary" : "btn-light") px-4">All Reports</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm rounded-5 bg-white overflow-hidden animate-fade-up delay-100">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 border-0 small text-muted">REPORTER</th>
                                <th class="border-0 small text-muted">REASON</th>
                                <th class="border-0 small text-muted">SUBJECT</th>
                                <th class="border-0 small text-muted">STATUS</th>
                                <th class="border-0 small text-muted text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">No reports found matching your criteria.</td>
                                </tr>
                            }
                            @foreach (var report in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-bold small">@report.Reporter.DisplayName</span>
                                        <div class="smallest text-muted">@report.CreatedOn.ToShortDateString()</div>
                                    </td>
                                    <td>
                                        <span class="badge @(report.Reason == "Fraud" ? "bg-danger" : "bg-warning") bg-opacity-10 text-@(report.Reason == "Fraud" ? "danger" : "warning") rounded-pill px-2">@report.Reason</span>
                                    </td>
                                    <td>
                                        @if (report.ReportedAuction != null)
                                        {
                                            <div class="small fw-bold">Auction: @report.ReportedAuction.Title</div>
                                        }
                                        else if (report.ReportedUser != null)
                                        {
                                            <div class="small fw-bold">User: @report.ReportedUser.DisplayName</div>
                                        }
                                        <div class="smallest text-muted text-truncate" style="max-width: 250px;">@report.Details</div>
                                    </td>
                                    <td>
                                        @if (report.IsResolved)
                                        {
                                            <span class="badge bg-success shadow-sm rounded-pill px-3"><i class="bi bi-check-circle me-1"></i> Resolved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary shadow-sm rounded-pill px-3">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#resolveModal-@report.Id">View Details</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Modals {
    @foreach (var report in Model)
    {
        <!-- Resolve Modal -->
        <div class="modal fade" id="resolveModal-@report.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4">
                    <div class="modal-header border-0 p-4 pb-0">
                        <h5 class="modal-title fw-bold">Report Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-4">
                            <small class="text-muted text-uppercase fw-bold smallest d-block mb-1">Reason</small>
                            <p class="fw-bold text-dark">@report.Reason</p>
                        </div>
                        <div class="mb-4">
                            <small class="text-muted text-uppercase fw-bold smallest d-block mb-1">Full Details</small>
                            <div class="p-3 bg-light rounded-4 small">@report.Details</div>
                        </div>
                        
                        @if (report.IsResolved)
                        {
                            <div class="alert alert-success border-0 rounded-4">
                                <h6 class="fw-bold mb-1">Resolution Notes:</h6>
                                <p class="mb-0 small">@report.AdminNotes</p>
                            </div>
                        }
                        else
                        {
                            <form asp-action="Resolve" method="post">
                                <input type="hidden" name="reportId" value="@report.Id" />
                                <div class="mb-3">
                                    <label class="form-label small text-muted fw-bold">ADMIN NOTES</label>
                                    <textarea name="adminNotes" class="form-control rounded-4 border-light bg-light p-3" rows="3" placeholder="Action taken..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-sm">Mark as Resolved</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

<style>
    .smallest { font-size: 0.75rem; }
    
    /* Dark Mode Improvements */
    [data-bs-theme="dark"] .table thead.bg-light {
        background-color: rgba(255, 255, 255, 0.02) !important;
    }
    [data-bs-theme="dark"] .modal-body .bg-light {
        background-color: #0f172a !important;
        color: #f1f5f9 !important;
    }
    [data-bs-theme="dark"] .form-control.bg-light {
        background-color: #0f172a !important;
        color: #f1f5f9 !important;
        border-color: #334155 !important;
    }
</style>
