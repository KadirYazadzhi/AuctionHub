@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden animate-fade-up">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h2 class="fw-bold mb-0">Welcome Back</h2>
                    <p class="mb-0 opacity-75">Sign in to start bidding</p>
                </div>
                <div class="card-body p-4 p-lg-5">
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.UserNameOrEmail" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="Username or Email" />
                            <label asp-for="Input.UserNameOrEmail">Username or Email</label>
                            <span asp-validation-for="Input.UserNameOrEmail" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label text-muted small" asp-for="Input.RememberMe">Remember me</label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-primary small text-decoration-none fw-bold">Forgot password?</a>
                        </div>

                        <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm mb-4">
                            Sign In <i class="bi bi-box-arrow-in-right ms-2"></i>
                        </button>

                        <div class="text-center position-relative mb-4">
                            <hr class="text-muted opacity-25">
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">OR</span>
                        </div>

                        <section>
                            @{
                                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                                {
                                    <div>
                                        <p class="text-muted small">No external authentication services configured.</p>
                                    </div>
                                }
                                else
                                {
                                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                                        <div class="d-grid gap-2">
                                            @foreach (var provider in Model.ExternalLogins!)
                                            {
                                                <button type="submit" class="btn btn-outline-dark rounded-pill py-2 fw-bold d-flex align-items-center justify-content-center" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                                    @if (provider.Name == "Google")
                                                    {
                                                        <i class="bi bi-google me-2 text-danger"></i>
                                                    }
                                                    else if (provider.Name == "GitHub")
                                                    {
                                                        <i class="bi bi-github me-2"></i>
                                                    }
                                                    Continue with @provider.DisplayName
                                                </button>
                                            }
                                        </div>
                                    </form>
                                }
                            }
                        </section>
                    </form>
                </div>
                <div class="card-footer bg-light border-0 py-4 text-center">
                    <p class="mb-0 text-muted">Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold text-decoration-none">Sign Up</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
