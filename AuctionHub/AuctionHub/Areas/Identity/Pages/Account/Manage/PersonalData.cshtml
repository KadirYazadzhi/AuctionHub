@page
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="fw-bold mb-1 text-main">Personal Data</h3>
<p class="text-muted mb-4 small">Manage your account data and privacy settings.</p>

<div class="row">
    <div class="col-md-10">
        <div class="card border-0 bg-light-custom rounded-4 p-4 mb-4">
            <p class="text-muted mb-4 small">Your account contains personal data that you have provided to us. You can download this information or choose to permanently delete your account.</p>
            
            <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4 p-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                    <div class="small">
                        <strong class="d-block">Danger Zone</strong>
                        Deleting this data will permanently remove your account and all associated auction history. This cannot be undone.
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-3">
                <form id="download-data" asp-page="DownloadPersonalData" method="post" class="flex-grow-1">
                    <button class="btn btn-outline-primary rounded-pill px-4 py-3 fw-bold w-100 transition-all hover-lift" type="submit">
                        <i class="bi bi-download me-2"></i>Download Data
                    </button>
                </form>
                <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger rounded-pill px-4 py-3 fw-bold flex-grow-1 shadow-sm transition-all hover-lift">
                    <i class="bi bi-trash3-fill me-2"></i>Delete Account
                </a>
            </div>
        </div>
    </div>
</div>
