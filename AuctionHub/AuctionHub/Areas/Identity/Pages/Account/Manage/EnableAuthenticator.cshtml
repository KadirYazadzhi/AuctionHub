@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure Authenticator";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="animate-fade-up">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-shield-lock-fill text-primary fs-3"></i>
        </div>
        <h3 class="fw-bold mb-1">Two-Factor Authentication</h3>
        <p class="text-muted">Enhance your account security with an authenticator app.</p>
    </div>

    <!-- Main Content Row -->
    <div class="row g-4 g-lg-5 align-items-center">
        <!-- Steps and Key Column -->
        <div class="col-xl-7 order-2 order-xl-1">
            <div class="pe-xl-3">
                <div class="mb-4">
                    <h6 class="fw-bold text-uppercase smallest text-primary mb-3">Step 1: Download & Install</h6>
                    <p class="text-muted small">
                        Install an authenticator app like 
                        <a href="https://support.google.com/accounts/answer/1066447" target="_blank" class="fw-bold text-decoration-none">Google Authenticator</a> or 
                        <a href="https://www.microsoft.com/en-us/security/mobile-authenticator-app" target="_blank" class="fw-bold text-decoration-none">Microsoft Authenticator</a>.
                    </p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-uppercase smallest text-primary mb-3">Step 2: Connect with Key</h6>
                    <p class="text-muted small mb-3">Scan the QR code to the right or manually enter the secret key below.</p>
                    
                    <div class="bg-light p-3 rounded-4 border mb-0">
                        <small class="text-muted smallest d-block mb-1">YOUR SECRET KEY</small>
                        <code class="text-primary fw-bold fs-5 d-block text-break">@Model.SharedKey</code>
                    </div>
                </div>

                <div class="mb-0">
                    <h6 class="fw-bold text-uppercase smallest text-primary mb-3">Step 3: Verification</h6>
                    <p class="text-muted small mb-4">Enter the 6-digit code from your app to finalize the setup.</p>
                    
                    <form id="send-code" method="post">
                        <div class="row g-3">
                            <div class="col-sm-8">
                                <div class="form-floating">
                                    <input asp-for="Input.Code" class="form-control rounded-4 shadow-none border" autocomplete="off" placeholder="000000" />
                                    <label asp-for="Input.Code">6-Digit Verification Code</label>
                                    <span asp-validation-for="Input.Code" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <button type="submit" class="btn btn-primary w-100 h-100 rounded-4 fw-bold shadow-sm">
                                    Activate
                                </button>
                            </div>
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mt-2"></div>
                    </form>
                </div>
            </div>
        </div>

        <!-- QR Code Column -->
        <div class="col-xl-5 order-1 order-xl-2 text-center">
            <div id="qrCodeContainer" class="p-3 bg-white rounded-5 shadow-sm border mb-3">
                <div id="qrCode"></div>
            </div>
            <p class="smallest text-muted px-3">Scan this code with your authenticator app to link instantly.</p>
        </div>
    </div>

    <!-- Footer Action -->
    <div class="text-center mt-5 pt-4 border-top">
        <a asp-page="./TwoFactorAuthentication" class="btn btn-link text-muted text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i> Back to 2FA Settings
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script type="text/javascript">
        window.addEventListener('load', function() {
            new QRCode(document.getElementById("qrCode"), {
                text: "@Html.Raw(Model.AuthenticatorUri)",
                width: 200,
                height: 200,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        });
    </script>
}

<style>
    .smallest { font-size: 0.7rem; letter-spacing: 0.05em; }
    
    [data-bs-theme="dark"] .bg-light { background-color: #0f172a !important; border-color: #334155 !important; }
    
    #qrCodeContainer {
        display: inline-block;
        background-color: white !important; /* Always white for scannability */
        padding: 15px !important;
    }
    
    #qrCode img {
        margin: 0 auto;
    }
    
    .form-control:focus {
        border-color: var(--bs-primary);
        box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.1);
    }
</style>
