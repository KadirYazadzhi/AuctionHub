@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="fw-bold mb-1 text-main">Update Security</h3>
<p class="text-muted mb-4 small">Keep your account protected by using a strong password.</p>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-8">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3 small" role="alert"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Input.OldPassword" class="form-label small text-muted text-uppercase fw-bold letter-spacing-1"></label>
                <input asp-for="Input.OldPassword" class="form-control rounded-4 border-light-subtle bg-light-custom p-3" autocomplete="current-password" aria-required="true" placeholder="Current password" />
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.NewPassword" class="form-label small text-muted text-uppercase fw-bold letter-spacing-1"></label>
                <input asp-for="Input.NewPassword" class="form-control rounded-4 border-light-subtle bg-light-custom p-3" autocomplete="new-password" aria-required="true" placeholder="New password" />
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label small text-muted text-uppercase fw-bold letter-spacing-1"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control rounded-4 border-light-subtle bg-light-custom p-3" autocomplete="new-password" aria-required="true" placeholder="Repeat new password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm hover-lift w-100">
                <i class="bi bi-shield-lock-fill me-2"></i>Save New Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
