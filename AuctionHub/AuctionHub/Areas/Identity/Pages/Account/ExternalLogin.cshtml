@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden animate-fade-up">
                <div class="card-header bg-primary text-white text-center py-4 border-0">
                    <div class="icon-box-lg rounded-circle bg-white bg-opacity-25 text-white mb-3 mx-auto d-flex align-items-center justify-content-center">
                        <i class="bi bi-person-check-fill fs-2"></i>
                    </div>
                    <h2 class="fw-bold mb-0">Associate your @Model.ProviderDisplayName account</h2>
                    <p class="mb-0 opacity-75">Almost there! Just a few more details</p>
                </div>
                
                <div class="card-body p-4 p-lg-5">
                    <div class="alert alert-info border-0 rounded-4 mb-4 small">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        You've successfully authenticated with <strong>@Model.ProviderDisplayName</strong>.
                        Please enter a username and your name for this site below and click the Register button to finish logging in.
                    </div>

                    <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-3 bg-light" readonly placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email Address</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Username" class="form-control rounded-3" autocomplete="username" placeholder="Username" />
                            <label asp-for="Input.Username">Username</label>
                            <span asp-validation-for="Input.Username" class="text-danger small"></span>
                            <div class="form-text smallest text-muted mt-1">
                                <i class="bi bi-info-circle me-1"></i> 3-15 chars: letters, numbers, '-', '_' only.
                            </div>
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Input.FirstName" class="form-control rounded-3" placeholder="First Name" />
                                    <label asp-for="Input.FirstName">First Name</label>
                                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Input.LastName" class="form-control rounded-3" placeholder="Last Name" />
                                    <label asp-for="Input.LastName">Last Name</label>
                                    <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm hover-lift">
                            Complete Registration <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </form>
                </div>
                
                <div class="card-footer bg-light border-0 py-4 text-center">
                    <p class="mb-0 text-muted small">
                        By registering, you agree to our 
                        <a href="#" class="text-primary text-decoration-none">Terms of Service</a> and 
                        <a href="#" class="text-primary text-decoration-none">Privacy Policy</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
